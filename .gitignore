/target

# Private agent keys never leave the machine. The rest of .bracken/ is the
# Ground itself and is committed: contribution files are immutable and named
# by their hash, so git merges them without conflicts.
.bracken/identities/
.bracken/objects/**/.tmp-*

# bracken's verified snapshot, a local cache of its own verification (docs/cli.md); cache/ also
# ignores itself, for every other repository.
.bracken/cache/

# The pinned team binary (a build artifact)
.bracken-bin/

# Where this machine's team server keeps its files (scripts/team-server setup)
.bracken-team

# The impeccable design skill's local config and hook cache
.impeccable/
