#!/usr/bin/env bash
# code-scope: which changes can't alter what builds or tests, for scripts/test-table, bk-evidence
# and merge (owner decision 642a47c04a10, task a40bde8af77d).
#
#   code-scope docs-only <base> <head>
#   code-scope key <commit>
#   code-scope chain <main> <head>...
#   code-scope full <base> <head>
#   code-scope frozen <base> <head>
#   code-scope packages <base> <head>
#   code-scope light-passes <sha> <package>... <the author's pass methods, on standard input>
#
# Docs are the *.md files outside crates/: crates/ holds .md files the code compiles in (the
# experiment's prompts), so those count as code. .bracken/ is the Ground.
#
# A Rust file changed only in comments counts as a doc does to full and packages (task 0837da3df7a4):
# it needs no full table, and names a doc's row. It isn't docs to docs-only, since clippy reads comments
# (finding c40ed7b8d3f8: one starting an inner if keeps collapsible_if quiet), so its head gets a light
# run, both clippies included. Its tokens must be the same from the merge base to <head>, and from
# <base> to <base> merged with <head>, the tree a counted run tests (finding 24e15486a4a4); doc comments
# count as code, since they reach rustdoc and doctests; a side that doesn't lex is code, and so is a
# file included as text, and any file where the merge conflicts. bracken-scope decides, one file at a
# time ('bracken-scope comment-only <base> <head> <file>', crates/scope). $CODE_SCOPE_TOKENS names its
# binary; otherwise it's built from this checkout's crates/scope, and where there's none, or the build
# fails, every Rust file is code, and packages fails (exit 2), since only bracken-scope can say which
# packages a change affects.
#
# docs-only exits 0 when what <head> changed since its merge base with <base> is at least one path,
# and every path is docs. Renames count as a deletion and an addition, so renaming or deleting a
# file that isn't docs is a code change. It exits 1, naming the first such path, otherwise, and 2 on
# an error (no such commit, say): only 0 means docs-only.
#
# key prints a hash of <commit>'s tree without .bracken/ and docs. Two trees with the same key
# differ only in the Ground and docs, so they build and test alike; the Ground guards, which read
# both, must still run.
#
# chain prints the prefixes of a batch (decision db6f7705c0a4): P_0 = <main>, then P_i = P_(i-1)
# merged with the i-th head, as git merge-tree computes it, which is the tree GitHub's squash merge
# of that head onto P_(i-1) produces. One line each, '<i> <commit> <key>', for i = 0..n. The merge
# commits are made with git commit-tree, nothing else refers to them, and no ref or worktree changes.
# A head that doesn't merge cleanly onto its prefix stops it: exit 1, naming that head.
#
# full exits 0 when what <head> changed since its merge base with <base> touches a path a light counted
# run can't cover (decision 464d3ccca45e, answer 10cf8a5053a3), printing one 'code-scope: full: <path>
# (<why>)' line for each, or, when <base> and <head> have several merge bases (a criss-cross history,
# finding bb7107f27076), one 'code-scope: full: every package (...)' line, as packages then gives every package; and exits 1, saying so, when it touches none; 2 on an error. Renames count as
# a deletion and an addition, as for docs-only. scripts/verify-seq --light refuses such a head, and
# scripts/merge refuses a light pass for it: this list is the one both read. Another project replaces
# the list with its own.
#
# frozen names what <head> changed since its merge base with <base> that Weave's format freeze guards
# (docs/design/weave-freeze.md 2.4, G6; decision bae92c497714), for scripts/merge. The set is keyed on
# directories, as full's list is, never on a list of modules, so a module split or a new file lands in it
# by itself. One line for each, each with its reason, and exit 0 if it printed any. If none, it prints
# 'code-scope: nothing since <merge base> is frozen or holds the freeze's refusals' and exits 3, an answer
# of its own, so a failure (exit 1 from set -e included) never reads as nothing to check; 2 on an error. A
# changed path holding a newline or another control character is an error, named escaped on standard
# error with nothing on standard output, since one couldn't be printed a line each (findings
# db2dc1c6120e, e3f9ae2b1820). So is a changed path that differs only in ASCII case from another path in the
# merged tree (<base> merged with <head>, as GitHub's squash merge makes it), naming both: a
# case-insensitive checkout writes one over the other; a head that doesn't merge cleanly; and several
# merge bases, a criss-cross history a diff from one can miss (findings 89119f47ba5c, bb7107f27076). Every
# path is matched with its ASCII letters lowercased, here and in full. A path holding any byte outside
# printable ASCII is refused too, named escaped: APFS folds some non-ASCII letters onto ASCII ones (finding
# 5b38ef3c9557), and main tracks no such path. frozen and full both read what <head> changed since the merge
# base and every path that differs between <base> and the merged tree, since the merge carries a head's edit
# onto a path main renamed (finding e1a2fe970409); full answers every package for a path outside
# printable ASCII or a head that doesn't merge cleanly. A changed path that is a symlink or a gitlink in
# the merged tree or <head> is refused too, and makes full answer every package: main tracks neither. The
# case check compares each path's leading directories as well (finding 304dd65b233c). Renames count as a deletion and an addition, and a change only in comments
# counts too: nothing here asks bracken-scope.
#   'code-scope: frozen: <path> (<why>)': crates/tree/src/, crates/tree/Cargo.toml, the format guard,
#     paths.rs, lines.rs, weave_fixture.rs and tests/fixtures/ in crates/tree, the committed pin
#     .config/weave-root (docs/design/weave-marker.md, option A), and, as
#     'code-scope: frozen: Cargo.lock (<crate> <old> -> <new>)', a change to the Cargo.lock entry of a
#     crate the frozen formats rest on: unicode-normalization, icu_casemap, ciborium, blake3, imara-diff.
#     merge asks for a current owner-review claim by manager naming the pr claim and the head.
#   'code-scope: owner: <path> (<why>)': a path that holds a golden vector or a pinned fixture value
#     (format_guard.rs, weave_fixture.rs, tests/fixtures/), whose change needs the owner's own go
#     (question 3): merge asks for an approval the owner ran, of the pr claim.
#   'code-scope: security: <path> (<why>)': a path in a directory that holds the refusals of the
#     freeze's section 1.8, crates/tree/src/, crates/bracken/src/weave.rs and crates/bracken/src/weave/:
#     merge asks for an independent review's pass at the head.
#
# packages prints, one a line and sorted, the workspace packages what <head> changed since its merge base
# with <base> affects: the scope a light run must test, whatever the builder ran (findings 0095e19fcdb7,
# 4825c59b07e9). Every package, if full names a path; otherwise what 'bracken-scope packages' says of the
# changed paths, a Rust file changed only in comments counting as README.md (task de42fa5c776d, owner
# decision 73f2ba4c08e5): guppy's determinator over both commits' package graphs, so a crate's change
# selects the packages that really depend on it, and the rules in .config/determinator.toml for paths
# outside the crates. AGENTS.md's Tests table documents the result. It prints nothing for a change only
# to rustfmt.toml. bracken-scope is this checkout's, its rules compiled in, so merge judges by main's. Its
# errors are printed only if it fails, which is exit 2.
#
# light-passes reads pass methods (one a line: the pr claim's author's passes on the claim) and exits 0
# when they hold, on exactly <sha>, the five a light run needs first (decision 464d3ccca45e): cargo fmt
# --check, both clippies, cargo nextest run -P fast -p ..., and scripts/test-table --remote -p ..., the
# last two each naming every <package>. Among the fast pass's -p arguments, -j <n>, --no-fail-fast and
# --test-threads <n> may come anywhere, as builders run it on a loaded machine (task b1156a629af9); nothing
# else may. Otherwise it prints, on one line, what's missing, and exits 1.
# verify-seq --light and merge both check with it. They're a precondition only: the light run itself
# tests the merged tree (finding 94e07ed7dd6b).
set -euo pipefail

usage() {
  echo "usage: code-scope docs-only <base> <head> | code-scope key <commit> | code-scope chain <main> <head>... | code-scope full <base> <head> | code-scope frozen <base> <head> | code-scope packages <base> <head> | code-scope light-passes <sha> <package>..." >&2
  exit 2
}

docs() {
  case "$1" in
    crates/*) return 1 ;;
    *.md) return 0 ;;
    *) return 1 ;;
  esac
}

# lower <path>: <path> with ASCII letters lowercased. The modes below match on it, since a case-insensitive
# checkout (macOS's default) writes Crates/Tree/src/lib.rs over crates/tree/src/lib.rs (finding 89119f47ba5c).
lower() { printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z'; }
# bases <base> <head>: their merge bases, one a line; exit 2 if there's none.
bases() { git merge-base --all "$1" "$2" || exit 2; }

# merged_tree <tip> <head>: the tree GitHub's squash merge of <head> onto <tip> gives, as git merge-tree
# computes it; fails on a conflict.
merged_tree() {
  local out
  out=$(git merge-tree --write-tree --no-messages "$1" "$2" 2>/dev/null) || return 1
  echo "${out%%$'\n'*}"
}
# changed_paths <tip> <head> <base> <merged> <file>: into <file>, NUL-separated and once each, what <head>
# changed since <base>, and every path that differs between <tip> and <merged>: the merge detects renames on
# main's side, so a head's edit can land on a path main moved, which the first diff never names (finding
# e1a2fe970409).
changed_paths() {
  { git diff --no-renames --name-only -z "$3" "$2" && git diff --no-renames --name-only -z "$1" "$4"; } |
    LC_ALL=C sort -uz >"$5"
}
# unprintable <path>: whether <path> holds a byte outside printable ASCII (0x20-0x7e): a control character,
# or a letter a filesystem may fold onto another (APFS folds the long s onto s and the Kelvin sign onto k,
# finding 5b38ef3c9557). main tracks no such path, so these are refused rather than folded.
# The '.' keeps a newline left over: command substitution strips trailing newlines.
unprintable() {
  local rest
  rest=$(printf '%s' "$1" | LC_ALL=C tr -d ' -~'; echo .)
  [ "$rest" != . ]
}
# escaped <path>: <path> quoted for the shell, every byte outside printable ASCII escaped.
escaped() { LC_ALL=C bash -c 'printf %q "$1"' _ "$1"; }

# special_changed <changed file> <tree>...: each path in <changed file> (NUL-separated, printable ASCII by
# then) that is a symlink (mode 120000) or a gitlink (160000) in any <tree>, one '<path> (<what>)' a line.
# main tracks neither, and a symlink named as a case variant of a directory replaces that directory on a
# case-insensitive checkout (finding 304dd65b233c), so both are refused rather than judged.
special_changed() {
  local changed=$1 t
  shift
  for t in "$@"; do git ls-tree -r -z "$t" || return 1; done | tr '\0' '\n' |
    LC_ALL=C awk -F'\t' -v list="$changed" 'BEGIN { while ((getline l < list) > 0) ch[l] = 1 }
      { split($1, m, " ") }
      (m[1] == "120000" || m[1] == "160000") && ($2 in ch) && !(($2, m[1]) in said) {
        said[$2, m[1]] = 1; print $2 " (" (m[1] == "120000" ? "a symlink" : "a gitlink") ")" }'
}

# Why a change to $1 needs the full table, printed; or nothing, returning 1. The protocol class (AGENTS.md:
# encoding, ids, the signing context and validity rules) is crates/manyroot and docs/protocol.md. The
# Weave validity code the weave-v1 fixture pins is all of crates/tree's source and manifest, whatever
# module a fixture test reads through, and the fixtures and their test (findings 4320dbb473bb,
# be317d39449b): a list of modules would miss lib.rs, which decides what each module compiles from, and
# rot as modules are added. .cargo/, rust-toolchain* and any build.rs change every build.
full_mode() {
  case "$(lower "$1")" in
    crates/manyroot/*) echo "crates/manyroot, the protocol crate" ;;
    cargo.toml | cargo.lock) echo "the workspace's $1" ;;
    docs/protocol.md) echo "the protocol class" ;;
    crates/tree/src/* | crates/tree/cargo.toml | crates/tree/tests/weave_fixture.rs | crates/tree/tests/fixtures/*)
      echo "crates/tree's source, or the Weave validity code the weave-v1 fixture pins" ;;
    # The freeze's other guards, and Weave's CLI, which holds refusals the freeze names (weave-freeze.md
    # 2.4, G6).
    crates/tree/tests/format_guard.rs | crates/tree/tests/paths.rs | crates/tree/tests/lines.rs)
      echo "a guard of Weave's frozen formats" ;;
    crates/bracken/src/weave.rs | crates/bracken/src/weave/*) echo "Weave's CLI, which holds refusals the format freeze names" ;;
    .cargo/* | rust-toolchain*) echo "the build's configuration" ;;
    # A build script runs at every build and changes its package without a manifest change (finding
    # 398c794c1707): any build.rs, at any depth.
    build.rs | */build.rs) echo "a build script" ;;
    *) return 1 ;;
  esac
}

# What the format freeze guards (see frozen in the header). frozen_mode <path> prints why <path> is in the
# frozen set, or returns 1; owner_mode why a change to it needs the owner's own go; security_mode why it
# needs an independent review. Each keyed on directories.
frozen_mode() {
  case "$(lower "$1")" in
    crates/tree/src/*) echo "crates/tree's source, which holds Weave's frozen formats and their rules" ;;
    crates/tree/cargo.toml) echo "crates/tree's manifest: what its formats build from" ;;
    crates/tree/tests/format_guard.rs) echo "the format guard: golden vectors and pins" ;;
    crates/tree/tests/paths.rs) echo "the path, folding and collision rules' guard" ;;
    crates/tree/tests/lines.rs) echo "the ancestor rule's guard" ;;
    crates/tree/tests/weave_fixture.rs) echo "the weave-v1 fixture's test and its pinned values" ;;
    crates/tree/tests/fixtures/*) echo "a Weave fixture" ;;
    .config/weave-root) echo "the Weave Ground's committed pin: its id, and the root whose marker counts" ;;
    *) return 1 ;;
  esac
}
owner_mode() {
  case "$(lower "$1")" in
    crates/tree/tests/format_guard.rs) echo "golden vectors and pinned values: the owner's own go" ;;
    crates/tree/tests/weave_fixture.rs) echo "the weave-v1 fixture's pinned values: the owner's own go" ;;
    crates/tree/tests/fixtures/*) echo "a Weave fixture: the owner's own go" ;;
    *) return 1 ;;
  esac
}
security_mode() {
  case "$(lower "$1")" in
    crates/tree/src/*) echo "crates/tree's source, where the freeze's refusals at write and use live" ;;
    crates/bracken/src/weave.rs | crates/bracken/src/weave/*) echo "Weave's CLI, where the freeze's refusals at use live" ;;
    *) return 1 ;;
  esac
}
# The crates whose Cargo.lock entries the frozen formats rest on: Unicode's tables and folding, the
# encoding, the content hash, and the line merge.
FROZEN_CRATES='unicode-normalization icu_casemap ciborium blake3 imara-diff'
# lock_entry <commit> <crate>: <crate>'s [[package]] entries in <commit>'s Cargo.lock, blank if none.
lock_entry() {
  { git show "$1:Cargo.lock" 2>/dev/null || true; } | awk -v n="$2" 'BEGIN { RS = "" } $0 ~ "\nname = \"" n "\"\n" { print; print "" }'
}
# lock_versions <entries>: their versions, space-separated, or 'none'.
lock_versions() {
  local v
  v=$(sed -n 's/^version = "\(.*\)"$/\1/p' <<<"$1" | tr '\n' ' ' | sed 's/ $//')
  echo "${v:-none}"
}

# Sets helper to bracken-scope's binary, once: $CODE_SCOPE_TOKENS, or this checkout's crates/scope built;
# empty if there's neither.
helper='unset'
find_helper() {
  if [ "$helper" = unset ]; then
    helper=
    if [ -n "${CODE_SCOPE_TOKENS:-}" ]; then
      helper=$CODE_SCOPE_TOKENS
    else
      local root target
      root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
      target=${CARGO_TARGET_DIR:-$root/target}
      case "$target" in /*) ;; *) target=$PWD/$target ;; esac
      if [ -f "$root/crates/scope/Cargo.toml" ] &&
        cargo build --locked -q -p bracken-scope --manifest-path "$root/Cargo.toml" >/dev/null 2>&1; then
        helper=$target/debug/bracken-scope
      fi
    fi
  fi
}

# Whether <path> changed only in comments, from <merge base> to <head> and from <tip> to <tip> merged
# with <head>: comment_only <tip> <merge base> <head> <path>.
merged='unset'
comment_only() {
  case "$4" in *.rs) ;; *) return 1 ;; esac
  find_helper
  [ -n "$helper" ] || return 1
  if [ "$merged" = unset ]; then
    merged=$(git merge-tree --write-tree "$1" "$3" 2>/dev/null | head -n 1) || merged=
  fi
  [ -n "$merged" ] &&
    "$helper" comment-only "$2" "$3" "$4" >/dev/null 2>&1 &&
    "$helper" comment-only "$1" "$merged" "$4" >/dev/null 2>&1
}

# bracken-scope packages <args>, its standard error kept for a failure; exit 2 if it fails or there's no
# bracken-scope (see comment_only, which finds it).
scope_packages() {
  local err rc=0
  find_helper
  [ -n "$helper" ] || { echo "code-scope: packages needs bracken-scope (crates/scope), and none built" >&2; exit 2; }
  err=$(mktemp)
  "$helper" packages "$@" 2>"$err" || rc=$?
  [ "$rc" -eq 0 ] || { echo "code-scope: bracken-scope packages failed (exit $rc):" >&2; cat "$err" >&2; }
  rm -f "$err"
  [ "$rc" -eq 0 ] || exit 2
}

case "${1:-}" in
  packages)
    [ $# -eq 3 ] || usage
    all_bases=$(bases "$2" "$3") || exit 2
    # Several merge bases: a criss-cross history, which a diff from one can miss, so every package, as full
    # says (finding bb7107f27076).
    if [ "$(wc -l <<<"$all_bases")" -gt 1 ]; then scope_packages --all "$3"; exit 0; fi
    base=$all_bases
    changed=$(mktemp)
    trap 'rm -f "$changed"' EXIT
    git diff --no-renames --name-only -z "$base" "$3" >"$changed" || exit 2
    # The changed paths, NUL-separated, and whether full names one.
    code=$(mktemp)
    trap 'rm -f "$changed" "$code"' EXIT
    all=false
    while IFS= read -r -d '' path; do
      # A doc's path, for a Rust file changed only in comments: its tests import every tracked file.
      if comment_only "$2" "$base" "$3" "$path"; then
        printf '%s\0' README.md >>"$code"
        continue
      fi
      printf '%s\0' "$path" >>"$code"
      ! full_mode "$path" >/dev/null || all=true
    done <"$changed"
    [ -s "$code" ] || exit 0
    if $all; then
      scope_packages --all "$3"
    else
      scope_packages "$base" "$3" <"$code"
    fi
    ;;
  light-passes)
    [ $# -ge 3 ] || usage
    sha=$2
    shift 2
    methods=$(cat)
    pkg='[A-Za-z0-9][A-Za-z0-9_-]*'
    missing=()
    grep -qxF "cargo fmt --check @ $sha" <<<"$methods" || missing+=("cargo fmt --check")
    grep -qxE "cargo clippy( --locked)?( --workspace)? --all-targets -- -D warnings @ $sha" <<<"$methods" ||
      missing+=("cargo clippy --all-targets -- -D warnings")
    grep -qxE "cargo clippy( --locked)?( --workspace)? --all-targets --target x86_64-unknown-linux-gnu -- -D warnings @ $sha" <<<"$methods" ||
      missing+=("cargo clippy --all-targets --target x86_64-unknown-linux-gnu -- -D warnings")
    # covers <prefix>: whether some method '<prefix> -p <package>... @ <sha>', with the arguments in
    # $also allowed among the -p ones, names every package.
    covers() {
      local line p ok
      while IFS= read -r line; do
        ok=true
        for p in "$@"; do [[ " ${line% @ *} " == *" -p $p "* ]] || ok=false; done
        ! $ok || return 0
      done < <(grep -xE "$prefix( -p $pkg$also)+ @ $sha" <<<"$methods" || true)
      return 1
    }
    scope=$(printf ' -p %s' "$@")
    prefix='cargo nextest run -P fast'
    # Each a choice beside ' -p <package>', so any of them may come anywhere among the -p ones.
    also='| -j [1-9][0-9]*| --no-fail-fast| --test-threads [1-9][0-9]*'
    covers "$@" || missing+=("cargo nextest run -P fast$scope")
    prefix='scripts/test-table --remote' also=''
    covers "$@" || missing+=("scripts/test-table --remote$scope")
    if [ ${#missing[@]} -gt 0 ]; then
      echo "no pass on $sha of: $(printf '%s; ' "${missing[@]}" | sed 's/; $//')"
      exit 1
    fi
    ;;
  full)
    [ $# -eq 3 ] || usage
    all_bases=$(bases "$2" "$3") || exit 2
    if [ "$(wc -l <<<"$all_bases")" -gt 1 ]; then
      echo "code-scope: full: every package ($(tr "\n" " " <<<"$all_bases" | sed "s/ \$//") are all merge bases of $2 and $3: a criss-cross history, which a diff from one of them can miss)"
      exit 0
    fi
    base=$all_bases
    merged=$(merged_tree "$2" "$3") || {
      echo "code-scope: full: every package ($3 doesn't merge cleanly onto $2, so what the merge changes can't be read)"
      exit 0
    }
    changed=$(mktemp)
    trap 'rm -f "$changed"' EXIT
    changed_paths "$2" "$3" "$base" "$merged" "$changed" || exit 2
    while IFS= read -r -d '' path; do
      if unprintable "$path"; then
        echo "code-scope: full: every package (a changed path holds a byte outside printable ASCII: $(escaped "$path"))"
        exit 0
      fi
    done <"$changed"
    lines=$(mktemp)
    trap 'rm -f "$changed" "$lines"' EXIT
    tr '\0' '\n' <"$changed" >"$lines"
    special=$(special_changed "$lines" "$merged" "$3") || exit 2
    if [ -n "$special" ]; then
      echo "code-scope: full: every package (a changed path is a symlink or a gitlink: $(tr '\n' ';' <<<"$special" | sed 's/;$//; s/;/; /g'))"
      exit 0
    fi
    found=false
    while IFS= read -r -d '' path; do
      if why=$(full_mode "$path") && ! comment_only "$2" "$base" "$3" "$path"; then
        found=true
        echo "code-scope: full: $path ($why)"
      fi
    done <"$changed"
    $found || { echo "code-scope: no path since $base needs the full table"; exit 1; }
    ;;
  frozen)
    [ $# -eq 3 ] || usage
    all_bases=$(bases "$2" "$3") || exit 2
    if [ "$(wc -l <<<"$all_bases")" -gt 1 ]; then
      echo "code-scope: frozen: $(tr "\n" " " <<<"$all_bases" | sed "s/ \$//") are all merge bases of $2 and $3: a criss-cross history, which a diff from one of them can miss, so this can't say what's frozen" >&2
      exit 2
    fi
    base=$all_bases
    head=$(git rev-parse --verify -q "$3^{commit}") || exit 2
    merged=$(merged_tree "$2" "$head") ||
      { echo "code-scope: frozen: $head doesn't merge cleanly onto $2, so the merged tree can't be checked" >&2; exit 2; }
    changed=$(mktemp)
    tree_paths=$(mktemp)
    trap 'rm -f "$changed" "$tree_paths"' EXIT
    changed_paths "$2" "$head" "$base" "$merged" "$changed" || exit 2
    # Every path first, so a refusal prints nothing on standard output.
    while IFS= read -r -d '' path; do
      if unprintable "$path"; then
        echo "code-scope: frozen: a changed path holds a newline, another control character or a byte outside printable ASCII, so it's refused: $(escaped "$path")" >&2
        exit 2
      fi
    done <"$changed"
    lines=$(mktemp)
    trap 'rm -f "$changed" "$tree_paths" "$lines"' EXIT
    tr '\0' '\n' <"$changed" >"$lines"
    special=$(special_changed "$lines" "$merged" "$head") || exit 2
    if [ -n "$special" ]; then
      echo "code-scope: frozen: a changed path is a symlink or a gitlink, which main tracks none of, so it's refused: $(tr '\n' ';' <<<"$special" | sed 's/;$//; s/;/; /g')" >&2
      exit 2
    fi
    # A changed path that differs only in ASCII case from another path in the merged tree: a case-insensitive
    # checkout (macOS's default) writes one over the other (finding 89119f47ba5c), so refuse, naming both.
    git ls-tree -r -z --name-only "$merged" | tr '\0' '\n' >"$tree_paths" || exit 2
    # Each path and each of its leading directories (finding 304dd65b233c: a case variant of a directory
    # replaces it): any two spellings with one lowercase form, one of them from a changed path, collide.
    collisions=$(LC_ALL=C awk '
      function add(p, touched,   n, i, part, pre, k) {
        n = split(p, part, "/")
        pre = ""
        for (i = 1; i <= n; i++) {
          pre = (i == 1) ? part[1] : pre "/" part[i]
          k = tolower(pre)
          if (touched) hit[k] = 1
          if ((k, pre) in seen) continue
          seen[k, pre] = 1
          all[k] = (k in all) ? all[k] " and " pre : pre
          count[k]++
        }
      }
      NR == FNR { add($0, 1); next }
      { add($0, 0) }
      END { for (k in hit) if (count[k] > 1) print all[k] }' "$lines" "$tree_paths") || exit 2
    if [ -n "$collisions" ]; then
      echo "code-scope: frozen: paths or directories differing only in case, which a case-insensitive checkout writes over each other: $(tr '\n' ';' <<<"$collisions" | sed 's/;$//; s/;/; /g')" >&2
      exit 2
    fi
    found=false
    while IFS= read -r -d '' path; do
      if why=$(frozen_mode "$path"); then found=true; echo "code-scope: frozen: $path ($why)"; fi
      if why=$(owner_mode "$path"); then found=true; echo "code-scope: owner: $path ($why)"; fi
      if why=$(security_mode "$path"); then found=true; echo "code-scope: security: $path ($why)"; fi
      if [ "$path" = Cargo.lock ]; then
        for crate in $FROZEN_CRATES; do
          before=$(lock_entry "$base" "$crate")
          after=$(lock_entry "$head" "$crate")
          if [ "$before" = "$after" ]; then
            before=$(lock_entry "$2" "$crate")
            after=$(lock_entry "$merged" "$crate")
          fi
          [ "$before" != "$after" ] || continue
          found=true
          was=$(lock_versions "$before") now=$(lock_versions "$after")
          if [ "$was" = "$now" ]; then
            echo "code-scope: frozen: Cargo.lock ($crate $was: its entry changed, and Weave's frozen formats rest on it)"
          else
            echo "code-scope: frozen: Cargo.lock ($crate $was -> $now, and Weave's frozen formats rest on it)"
          fi
        done
      fi
    done <"$changed"
    $found || { echo "code-scope: nothing since $base is frozen or holds the freeze's refusals"; exit 3; }
    ;;
  docs-only)
    [ $# -eq 3 ] || usage
    base=$(git merge-base "$2" "$3") || exit 2
    changed=$(mktemp)
    trap 'rm -f "$changed"' EXIT
    git diff --no-renames --name-only -z "$base" "$3" >"$changed" || exit 2
    any=false
    while IFS= read -r -d '' path; do
      any=true
      docs "$path" || { echo "code-scope: not docs: $path"; exit 1; }
    done <"$changed"
    $any || { echo "code-scope: no change since $base"; exit 1; }
    echo "code-scope: docs only since $base"
    ;;
  key)
    [ $# -eq 2 ] || usage
    tree=$(git rev-parse --verify -q "$2^{tree}") || { echo "code-scope: no commit $2" >&2; exit 2; }
    listing=$(mktemp)
    trap 'rm -f "$listing"' EXIT
    git ls-tree -r -z --full-tree "$tree" >"$listing" || exit 2
    # Each entry is '<mode> <type> <object>\t<path>'; only the path decides what's left out.
    while IFS= read -r -d '' entry; do
      path=${entry#*$'\t'}
      case "$path" in .bracken/*) continue ;; esac
      docs "$path" && continue
      printf '%s\0' "$entry"
    done <"$listing" | git hash-object --stdin
    ;;
  chain)
    [ $# -ge 3 ] || usage
    self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
    prefix=$(git rev-parse --verify -q "$2^{commit}") || { echo "code-scope: no commit $2" >&2; exit 2; }
    shift 2
    echo "0 $prefix $("$self" key "$prefix")"
    i=0
    for head in "$@"; do
      i=$((i + 1))
      head=$(git rev-parse --verify -q "$head^{commit}") || { echo "code-scope: no commit $head" >&2; exit 2; }
      tree=$(git merge-tree --write-tree "$prefix" "$head" 2>/dev/null | head -n 1) && [ -n "$tree" ] ||
        { echo "code-scope: head $i, $head, doesn't merge cleanly onto the batch before it" >&2; exit 1; }
      prefix=$(git -c user.name=code-scope -c user.email=code-scope@invalid commit-tree "$tree" -p "$prefix" -p "$head" \
        -m "batch prefix $i") || exit 2
      echo "$i $prefix $("$self" key "$prefix")"
    done
    ;;
  *) usage ;;
esac
