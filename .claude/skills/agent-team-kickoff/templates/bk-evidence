#!/usr/bin/env bash
# bk-evidence: run a check and record its real result as evidence on a pr claim.
#
#   bk-evidence <claim> [--as <identity>] [--lines N] [--any-head] [--on <main> [--reuse]] -- <command> [args...]
#
# Runs the command in the current checkout, streaming its output, and records
# evidence on <claim> through scripts/bk: `pass` if it exits 0, otherwise `fail`,
# with --method "<command, shell-quoted> @ <HEAD sha>" and --details holding the
# exit code and the last N lines (default 40, at most 8000 bytes) of its combined
# output, with control characters and invalid UTF-8 removed. Then exits with the
# command's exit code.
#
# With --on <main> (a commit, such as origin/main), it tests the tree the merge will produce
# instead: it merges that commit into HEAD in a scratch worktree, runs the command there (in the
# same subdirectory), removes the worktree, and records --method "<command> @ <HEAD sha> on <main
# sha> tree <key>", where the key is scripts/code-scope's for the merged tree (its hash without
# .bracken/ and docs). The pr claim stays on HEAD. scripts/merge accepts main ahead of the head in
# any path when the manager's pass of scripts/test-table names this head and a main that main's tip
# has moved past only in .bracken/ and docs. It refuses, recording nothing, if the merge conflicts:
# then merge main into the branch.
#
# With --reuse (only with --on, and only for exactly scripts/test-table): if this identity already
# has a pass of the whole table, not docs-only and not itself reused, on a pr claim of the same PR,
# whose merged tree had the same key, the table isn't run again. Only the Ground guards run
# (scripts/ground-guards <main> HEAD, in the merged tree), and the method ends "tree <key> reuses
# <that evidence's id>" (owner decision 642a47c04a10). So a re-verification after main moved only in
# docs or the Ground costs the guards alone. Needs jq.
#
# When the command is scripts/test-table and it printed 'test-table: docs-only: skipped clippy and
# cargo test', the method ends " docs-only", so the gate can tell that run from the whole table.
#
# It refuses, recording nothing, when:
#   - it isn't run inside a git checkout;
#   - the checkout has uncommitted changes or untracked files outside .bracken/,
#     before or after the command (the sha would be a lie), or the command moved HEAD;
#   - <claim> isn't a hex id (12 to 64 characters) of a claim whose statement starts
#     "PR #<n> <branch> @ <HEAD's full sha>:", as a pr claim does. For evidence on a
#     claim that isn't a pr claim (a finding, a task), pass --any-head; it refuses
#     claims tagged pr, whose head must always match;
#   - the identity (--as or BRACKEN_AGENT) is missing or can't sign here;
#   - the pinned bracken is too old to read details from a file (--details-file);
#   - the command isn't an executable file (exit 127). A shell builtin, keyword or
#     function is refused too: pass the program's path (`type -P true` gives
#     /usr/bin/true), or wrap it in `bash -c '...'`.
#
# The command's exit code is what's recorded: for a pipeline, use
# `bash -o pipefail -c '...'`, or only the last stage's code counts. The output
# tail goes to bracken through a private temporary file, never a command line, but
# it becomes a permanent contribution in the Ground and in git history, so don't
# use this for commands whose output can hold secrets.
#
# Verifying someone else's branch, run the main checkout's copy by absolute path,
# never the branch's own: "$main/scripts/bk-evidence".
set -euo pipefail

usage() {
  echo "usage: bk-evidence <claim> [--as <identity>] [--lines N] [--any-head] [--on <main> [--reuse]] -- <command> [args...]" >&2
  exit 2
}
fail() { echo "bk-evidence: $*" >&2; exit 1; }

[ $# -ge 1 ] || usage
claim=$1
shift
agent=${BRACKEN_AGENT:-}
lines=40
any_head=false
on=
reuse=false
while [ $# -gt 0 ]; do
  case "$1" in
    --as) [ $# -ge 2 ] || usage; agent=$2; shift 2 ;;
    --lines) [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; lines=$2; shift 2 ;;
    --any-head) any_head=true; shift ;;
    --on) [ $# -ge 2 ] || usage; on=$2; shift 2 ;;
    --reuse) reuse=true; shift ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
[ $# -ge 1 ] || usage
[[ $claim =~ ^[0-9a-f]{12,64}$ ]] || fail "'$claim' isn't a claim id (12 to 64 hex characters)"
[ -n "$agent" ] || fail "no identity: pass --as <identity> or set BRACKEN_AGENT"
if $reuse; then
  [ -n "$on" ] || fail "--reuse needs --on: only a merged tree has a key to reuse"
  [ $# -eq 1 ] && [ "$1" = scripts/test-table ] || fail "--reuse is only for exactly scripts/test-table"
  command -v jq >/dev/null || fail "--reuse needs jq"
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
top=$(git rev-parse --show-toplevel 2>/dev/null) || fail "$PWD is not inside a git checkout"
changes() { git -C "$top" status --porcelain | grep -E -v '^\?\? \.bracken/' || true; }
sha=$(git -C "$top" rev-parse HEAD)
dirty=$(changes)
[ -z "$dirty" ] || fail "the checkout has uncommitted changes, so '@ $sha' would be wrong; commit first:
$dirty"
# With --on, the command runs in a scratch worktree holding HEAD merged with that commit.
run_dir=$PWD
scratch=
remove_scratch() { [ -z "$scratch" ] || git -C "$top" worktree remove --force "$scratch/tree" 2>/dev/null || true; }
trap remove_scratch EXIT
if [ -n "$on" ]; then
  onto=$(git -C "$top" rev-parse --verify -q "$on^{commit}") || fail "no commit '$on' (nothing run)"
  scratch=$(mktemp -d)
  git -C "$top" worktree add -q --detach "$scratch/tree" "$sha" || fail "couldn't make a worktree at $sha (nothing run)"
  # No hooks, no signing, and a fixed identity: the merge commit is only for this run.
  if ! err=$(git -C "$scratch/tree" -c core.hooksPath=/dev/null -c commit.gpgsign=false -c merge.verifySignatures=false \
    -c user.name=bk-evidence -c user.email=bk-evidence@invalid merge -q --no-ff --no-edit "$onto" 2>&1); then
    fail "$sha doesn't merge cleanly with $onto: merge main into the branch, then test that head (nothing run). git said: $(tail -n 3 <<<"$err")"
  fi
  merged=$(git -C "$scratch/tree" rev-parse HEAD)
  key=$(cd "$top" && "$here/code-scope" key "$merged") || fail "couldn't take the merged tree's key (nothing run)"
  # The caller's subdirectory, from where it runs (with -C the prefix would always be empty).
  prefix=$(git rev-parse --show-prefix)
  run_dir="$scratch/tree/$prefix"
  [ -d "$run_dir" ] ||
    fail "the merge with $onto has no ${prefix%/}/, the directory this was run from: run it from the checkout's top (nothing run)"
fi
kind=$(cd "$run_dir" && type -t "$1" || true)
case "$kind" in
  file) ;;
  "") echo "bk-evidence: command not found: $1 (nothing recorded)" >&2; exit 127 ;;
  *)
    path=$(cd "$run_dir" && type -P "$1" || true)
    echo "bk-evidence: '$1' is a shell $kind, and bk-evidence runs only executable files; pass ${path:-the program path}, or wrap it in bash -c '...' (nothing recorded)" >&2
    exit 127
    ;;
esac
"$here/bk" id list | awk -v n="$agent" '$2 == n && NF == 2 { found = 1 } END { exit !found }' ||
  fail "this replica can't sign as '$agent' (see scripts/bk id list)"
# Outputs are captured first and searched with here-strings: under pipefail, a grep that stops
# early in a pipeline kills the writer with SIGPIPE once the output passes the pipe buffer.
help=$("$here/bk" evidence --help)
grep -q -- --details-file <<<"$help" ||
  fail "the pinned bracken is too old: it can't take --details-file. Ask the manager to upgrade it (docs/releases.md, 'Upgrading the pinned binary'). Nothing was run."
# The JSON keeps each string on one line with its quotes escaped, so a statement can't
# contain an unescaped '"statement": "' or '"id": "', and the first of each is the claim's own.
shown=$(BRACKEN_AGENT=$agent "$here/bk" show "$claim" --json 2>/dev/null) || fail "no contribution $claim in the Ground"
statement=$(grep -m1 -E '^ *"statement": "' <<<"$shown" || true)
[ -n "$statement" ] || fail "$claim isn't a claim in the Ground"
[[ $shown =~ \"id\":\ \"([0-9a-f]{64})\" ]] || fail "couldn't read $claim's id from the Ground"
full=${BASH_REMATCH[1]}
if $any_head; then
  # bracken matches the tag exactly, so no tag can hide 'pr'.
  prs=$(BRACKEN_AGENT=$agent "$here/bk" log --tag pr --json)
  ! grep -qF "\"id\": \"$full\"" <<<"$prs" ||
    fail "--any-head is for claims that aren't pr claims; $claim is tagged pr, so its head must be HEAD ($sha)"
else
  grep -qE "^ *\"statement\": \"PR #[0-9]+ [^ \"]+ @ $sha:" <<<"$statement" ||
    fail "claim $claim doesn't start 'PR #<n> <branch> @ $sha:', so it isn't the pr claim for HEAD; record on the current pr claim, or pass --any-head for a claim that isn't a pr claim"
fi

# With --reuse, an earlier pass of the whole table by this identity, on a pr claim of the same PR, of
# a merged tree with this key. Its method ends exactly "tree <key>": a docs-only or reused pass doesn't count.
command=("$@")
reused=
if $reuse; then
  [[ $statement =~ \"statement\":\ \"PR\ \#([0-9]+)\  ]] || fail "couldn't read the PR number from $claim"
  pr=${BASH_REMATCH[1]}
  prs=$(BRACKEN_AGENT=$agent "$here/bk" log --tag pr --json)
  passes=$(BRACKEN_AGENT=$agent "$here/bk" log --kind evidence --author "$agent" --json)
  reused=$(printf '%s\n%s\n' "$prs" "$passes" | jq -rs --arg pr "PR #$pr " --arg key "$key" '
    (.[0] | map(select((.body.statement // "") | startswith($pr)) | .id)) as $claims
    | [.[1][] | select(.retracted == false and .body.verdict == "pass" and (.body.target as $t | $claims | index($t))
        and (.body.method | test("^scripts/test-table @ [0-9a-f]{40} on [0-9a-f]{40} tree " + $key + "$")))]
    | .[0].id // empty')
  if [ -n "$reused" ]; then
    echo "bk-evidence: this merged tree's key $key already passed the whole table for PR #$pr: evidence $reused; running only the Ground guards" >&2
    command=(scripts/ground-guards "$onto" HEAD)
  fi
fi

# mktemp makes each file private (0600) without changing the umask the command runs with.
out=$(mktemp)
kept=$(mktemp)
details=$(mktemp)
trap 'rm -f "$out" "$kept" "$details"; remove_scratch' EXIT
set +e
(cd "$run_dir" && "${command[@]}") 2>&1 | tee "$out"
code=${PIPESTATUS[0]}
set -e
# Read before $out is cut to its tail below: the line comes early in the table's output.
docs_only=false
if [ -z "$reused" ] && [ $# -eq 1 ] && [ "$1" = scripts/test-table ] &&
  grep -qx 'test-table: docs-only: skipped clippy and cargo test' "$out"; then
  docs_only=true
fi

after=$(git -C "$top" rev-parse HEAD)
[ "$after" = "$sha" ] || fail "the command moved HEAD from $sha to $after; nothing recorded (exit $code)"
dirty=$(changes)
[ -z "$dirty" ] || fail "the command changed the checkout, so the run didn't test $sha; nothing recorded (exit $code):
$dirty"
if [ -n "$on" ]; then
  [ "$(git -C "$scratch/tree" rev-parse HEAD)" = "$merged" ] &&
    [ -z "$(git -C "$scratch/tree" status --porcelain | grep -E -v '^\?\? \.bracken/' || true)" ] ||
    fail "the command changed the merged tree, so the run didn't test it; nothing recorded (exit $code)"
fi

verdict=pass
[ "$code" -eq 0 ] || verdict=fail
tail -n "$lines" "$out" >"$kept"
if [ "$(wc -c <"$kept")" -gt 8000 ]; then
  tail -c 8000 "$kept" >"$out"
  # The cut can start mid-line: drop that partial line, unless it's the only one.
  if [ "$(wc -l <"$out")" -ge 2 ]; then tail -n +2 "$out" >"$kept"; else cp "$out" "$kept"; fi
fi
# The output is untrusted: drop invalid UTF-8, C0 controls except tab and newline, DEL and C1 controls,
# so the evidence always records and never drives the terminal of whoever reads it.
{
  printf 'exit %s\n' "$code"
  iconv -c -f UTF-8 -t UTF-8 <"$kept" 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\037\177' |
    LC_ALL=C sed $'s/\xc2[\x80-\x9f]//g' || true
} >"$details"
method="$(printf '%q ' "$@")@ $sha"
[ -z "$on" ] || method="$method on $onto tree $key"
[ -z "$reused" ] || method="$method reuses $reused"
! $docs_only || method="$method docs-only"
if id=$("$here/bk" evidence "$claim" "$verdict" --method "$method" --details-file "$details" --as "$agent"); then
  echo "bk-evidence: recorded $verdict $id (exit $code)" >&2
  exit "$code"
fi
echo "bk-evidence: the command exited $code, but recording the evidence failed" >&2
exit $((code != 0 ? code : 1))
