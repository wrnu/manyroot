#!/usr/bin/env bash
# team-server: run the team's sync server on this machine (network-sync step 3), for the main
# checkout's Ground.
#
#   team-server setup <dir> [port]   once: make <dir> (outside the repo) and a server replica in it
#   team-server token <identity>     issue, or replace, an identity's token (restarts a running server)
#   team-server key <identity>       make a new identity whose key the server holds, and issue its token
#   team-server retire <identity>    stop signing for a server-held identity, and drop its token
#   team-server start | stop
#   team-server run                  the server in the foreground, for launchd (scripts/services)
#   team-server check                wait until the server listens and answers a sync
#
# <dir> holds everything, mode 0700: the server's own replica (ground/), the tokens (tokens/<identity>,
# 0600, one per identity, which scripts/bk reads), their blake3 hashes (tokens.b3, which the server
# reads), the allowlist of author keys, the first-seen log, the server's log and pid, and its URL.
# setup records <dir> in the main checkout's .bracken-team (not committed): from then on scripts/bk
# pushes and confirms every write, and scripts/merge refuses to decide without a pull.
#
# The server binds 127.0.0.1 only (the default port is 7391). It reads its replica, tokens and
# allowlist when it starts, so token restarts a running server. start returns once the server is
# listening and has answered a sync of the main checkout's replica. Nothing else writes its replica:
# scripts/bk writes the main checkout's and syncs. A token is written once, to its 0600 file;
# it's never printed, never in argv, and never in the Ground. Needs b3sum (cargo install --locked b3sum).
#
# The server holds new identities' keys and signs for them (docs/design/agent-keys.md, part A step 2;
# approval 1ec8c15fd00f): key makes the identity with its private key in <dir>/keys/ (0700), never copied
# out, and its public entry in the main checkout's .bracken/agents/ through bracken, as id new does; held.jsonl
# lists every such identity's name and public key, for scripts/ground-guards. The server signs only within
# <dir>/scopes.toml (key writes a first one, which the manager edits; the server reads it on every
# request), and logs each signature in signed.jsonl. retire records the key in <dir>/keys/retired.jsonl,
# moves it to <dir>/keys/retired/ and drops its token; note it in a claim. The server never signs with a key
# that is in retired/ or named in retired.jsonl, even one put back in keys/ by hand. Existing identities keep their key
# files in .bracken/identities/ and sign as they do.
#
# Once scripts/services install has made the server a launchd agent, launchd keeps it running: start
# and stop refuse (stopping it would only restart it; scripts/services uninstall stops it), and token
# restarts it through launchd.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
bin="${BRACKEN_BIN:-$main/.bracken-bin/bin/bracken}"
marker="$main/.bracken-team"
fail() { echo "team-server: $*" >&2; exit 1; }
usage() {
  echo "usage: team-server setup <dir> [port] | token <identity> | key <identity> | retire <identity> | start | stop | run | check" >&2
  exit 2
}
# The launchd agent scripts/services installs, and whether it is loaded for this checkout (its working
# directory is the main checkout; another repository's agent, or a test's, isn't this one).
label=jx.rs.bracken.team-server
managed() {
  command -v launchctl >/dev/null || return 1
  launchctl print "gui/$(id -u)/$label" 2>/dev/null | awk -v want="$main" '
    { sub(/^[ \t]+/, "") } index($0, "working directory = ") == 1 && substr($0, 21) == want { found = 1 }
    END { exit !found }'
}
[ -x "$bin" ] || fail "no bracken at $bin"

team_dir() {
  [ -f "$marker" ] || fail "not set up: run team-server setup <dir> first"
  dir=$(cat "$marker")
  [ -d "$dir/ground" ] || fail "$dir/ground is missing; $marker points at a team directory that isn't there"
}
# The pid in server.pid, if that process is still this server.
running_pid() {
  local pid command
  pid=$(cat "$dir/server.pid" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  command=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
  [[ $command == *" --dir $dir/ground serve "* ]] || return 1
  echo "$pid"
}
# The identities the main checkout's Ground knows, as JSON.
identities() { BRACKEN_DIR="$main/.bracken" "$bin" id list --json; }

# The serve command in $serve, its allowlist written, its URL in $url.
prepare() {
  local known
  [ -s "$dir/tokens.b3" ] || fail "no tokens yet: team-server token <identity>"
  url=$(cat "$dir/url")
  # Every identity the main checkout knows may push; contributions are signed, so this is who
  # may author, not who may connect (that's the tokens).
  known=$(identities)
  grep -oE '"agent": "[0-9a-f]{64}"' <<<"$known" | grep -oE '[0-9a-f]{64}' >"$dir/allow"
  # Limits from network-sync.md, "Memory, for choosing step 3's limits".
  serve=("$bin" --dir "$dir/ground" serve --port "${url##*:}" --tokens "$dir/tokens.b3" --allow "$dir/allow"
    --first-seen "$dir/first-seen.jsonl" --batch-bytes 17825792 --id-budget 8388608 --max-sessions 16)
  if [ -d "$dir/keys" ]; then
    signs ||
      fail "$dir/keys holds keys, but $bin can't sign for them (no serve --keys): upgrade the pinned binary (docs/releases.md); nothing was started"
    serve+=(--keys "$dir/keys" --scopes "$dir/scopes.toml" --signed "$dir/signed.jsonl")
  fi
}

# Whether $bin can hold keys: serve --keys/--scopes/--signed and id new --key-dir (finding 0d9dbdbc9f35).
signs() {
  local serve_help id_help
  serve_help=$("$bin" serve --help 2>/dev/null) && id_help=$("$bin" id new --help 2>/dev/null) || return 1
  [[ $serve_help == *--keys* && $serve_help == *--scopes* && $serve_help == *--signed* && $id_help == *--key-dir* ]]
}

# Restarts the server if it runs, so it reads its tokens, allowlist and keys again: a token it doesn't know
# would let the identity write locally and block everyone's pushes.
restart() {
  local old
  can_restart
  if managed; then
    echo "team-server: restarting the server through launchd, so it knows $1"
    old=$(running_pid || true)
    launchctl kickstart -k "gui/$(id -u)/$label"
    await_up "$old" || exit 1
  elif running_pid >/dev/null; then
    echo "team-server: restarting the server, so it knows $1"
    stop_server
    start_server
  fi
}

# Whether $1 was retired: its key in keys/retired/, or its name in keys/retired.jsonl, which stays when a
# key file is moved back (finding ab071f5d3de6).
retired() {
  [ -e "$dir/keys/retired/$1.json" ] || grep -q "\"name\":\"$1\"" "$dir/keys/retired.jsonl" 2>/dev/null
}

# Refuses, before anything changes, when a running server would have to restart under a binary that can't
# serve the held keys: stopping it would leave it down, and a token replaced without the restart would lock
# its identity out (finding d8703c51297c).
can_restart() {
  if [ -d "$dir/keys" ] && { managed || running_pid >/dev/null; } && ! signs; then
    fail "$dir/keys holds keys, but $bin can't sign for them (no serve --keys): upgrade the pinned binary (docs/releases.md); nothing was changed, and the running server was left as it is"
  fi
}

# Issues, or replaces, $name's token.
issue_token() {
  local hash
  command -v b3sum >/dev/null || fail "needs b3sum: cargo install --locked b3sum"
  # 32 random bytes as hex, straight into the 0600 file.
  od -An -tx1 -N32 /dev/urandom | tr -d ' \n' >"$dir/tokens/$name.new"
  hash=$(b3sum --no-names <"$dir/tokens/$name.new")
  mv "$dir/tokens/$name.new" "$dir/tokens/$name"
  { grep -v "^$name " "$dir/tokens.b3" 2>/dev/null || true; echo "$name $hash"; } >"$dir/tokens.b3.new"
  mv "$dir/tokens.b3.new" "$dir/tokens.b3"
  echo "team-server: token for $name in $dir/tokens/$name"
}

# The first scopes, from what each role has written in this Ground (docs/design/agent-keys.md, 4.2).
first_scopes() {
  cat <<'TOML'
# What the team server signs for each identity whose key it holds (docs/design/agent-keys.md, 4.2). The
# manager edits this file; the server reads it on every request, and signs nothing while it doesn't parse.
# An entry is a name, or a name's start followed by '*'; an exact name wins over a pattern, and a longer
# pattern over a shorter one. A name with no entry gets nothing signed. In an entry, kinds and relations
# list what may be signed (absent: nothing), tags the only tags a claim may carry (absent: any), and
# forbidden_tags those it may not.

[scope."builder-*"]
kinds = ["claim", "relation", "evidence", "retract"]
relations = ["supports", "contradicts", "depends_on", "refines", "supersedes", "implements", "tests"]
forbidden_tags = ["approval", "decision", "task", "owner-review", "weave-gate"]
TOML
}

# Waits up to 30 seconds for a server other than pid $1 (if given) that is running, listening and has
# answered a sync of the main checkout's replica, as scripts/bk's would; says which, or why not.
await_up() {
  local old=${1:-} pid='' tokens err
  url=$(cat "$dir/url")
  for _ in $(seq 300); do
    pid=$(running_pid) && [ "$pid" != "$old" ] && (exec 3<>"/dev/tcp/127.0.0.1/${url##*:}") 2>/dev/null && break
    pid=''
    sleep 0.1
  done
  [ -n "$pid" ] || { echo "team-server: no server listening on $url within 30 seconds; see $dir/server.log" >&2; return 1; }
  tokens=("$dir"/tokens/*)
  err=$(BRACKEN_DIR="$main/.bracken" "$bin" sync "$url" --token-file "${tokens[0]}" --deadline 30 2>&1 >/dev/null) || {
    echo "team-server: the server is listening (pid $pid) but a sync with it failed: ${err##*$'\n'}" >&2
    return 1
  }
  echo "team-server: listening on $url (pid $pid)"
}

# Starts the server, and returns once it is listening and has answered a sync.
start_server() {
  local pid
  prepare
  nohup "${serve[@]}" </dev/null >>"$dir/server.log" 2>&1 &
  pid=$!
  echo "$pid" >"$dir/server.pid"
  # A server that exits at once (its port taken, say) fails here rather than after the wait.
  sleep 0.2
  kill -0 "$pid" 2>/dev/null || fail "the server exited; see $dir/server.log"
  await_up || {
    kill "$pid" 2>/dev/null || true
    exit 1
  }
}

stop_server() {
  local pid
  pid=$(running_pid) || { echo "team-server: not running"; return 0; }
  kill "$pid"
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || { echo "team-server: stopped"; return 0; }
    sleep 0.1
  done
  fail "pid $pid didn't stop"
}

umask 077
case "${1:-}" in
  setup)
    [ $# -ge 2 ] && [ $# -le 3 ] || usage
    dir=$2 port=${3:-7391}
    [[ $dir = /* ]] || fail "give <dir> as an absolute path"
    [[ $port =~ ^[1-9][0-9]*$ ]] && [ "$port" -le 65535 ] || fail "'$port' isn't a port"
    case "$dir/" in "$main"/*) fail "<dir> must be outside the repository" ;; esac
    [ ! -f "$marker" ] || fail "already set up, in $(cat "$marker")"
    [ ! -e "$dir/ground" ] || fail "$dir/ground already exists"
    mkdir -p "$dir/tokens"
    chmod 700 "$dir" "$dir/tokens"
    "$bin" --dir "$main/.bracken" export "$dir/seed.bundle" >/dev/null
    "$bin" --dir "$dir/ground" join "$dir/seed.bundle" >/dev/null
    rm -f "$dir/seed.bundle"
    printf 'http://127.0.0.1:%s\n' "$port" >"$dir/url"
    printf '%s\n' "$dir" >"$marker"
    echo "team-server: set up in $dir; issue tokens (team-server token <identity>), then team-server start"
    ;;
  token)
    [ $# -eq 2 ] || usage
    name=$2
    team_dir
    [[ $name =~ ^[a-z0-9_-]{1,64}$ ]] || fail "'$name' isn't an identity name"
    retired "$name" && fail "$name is retired: its key is no longer signed with"
    known=$(identities)
    [[ $known == *"\"name\": \"$name\""* ]] || fail "no identity $name in the main checkout's Ground"
    can_restart
    issue_token
    restart "$name"
    ;;
  key)
    [ $# -eq 2 ] || usage
    name=$2
    team_dir
    [[ $name =~ ^[a-z0-9_-]{1,64}$ ]] || fail "'$name' isn't an identity name"
    command -v b3sum >/dev/null || fail "needs b3sum: cargo install --locked b3sum"
    known=$(identities)
    [[ $known != *"\"name\": \"$name\""* ]] || fail "$name is already an identity; key makes new ones only"
    ! grep -q "\"name\":\"$name\"" "$dir/held.jsonl" 2>/dev/null || fail "$name was held by this server before"
    # Before anything in the team directory changes: with keys/ present every start passes --keys, which
    # an older binary refuses, and the server would stay down for everyone.
    signs || fail "$bin can't hold keys (no serve --keys or id new --key-dir): upgrade the pinned binary first (docs/releases.md); nothing was changed"
    mkdir -p "$dir/keys/retired"
    chmod 700 "$dir/keys" "$dir/keys/retired"
    [ -e "$dir/scopes.toml" ] || first_scopes >"$dir/scopes.toml"
    # The private key into the server's directory, the public entry into the main checkout's agents/.
    agent=$(BRACKEN_DIR="$main/.bracken" "$bin" id new "$name" --key-dir "$dir/keys") ||
      fail "couldn't make identity $name"
    [[ $agent =~ ^[0-9a-f]{64}$ ]] || fail "bracken id new printed no key for $name"
    printf '{"name":"%s","agent":"%s"}\n' "$name" "$agent" >>"$dir/held.jsonl"
    echo "team-server: made $name ($agent), its key held in $dir/keys"
    issue_token
    restart "$name"
    ;;
  retire)
    [ $# -eq 2 ] || usage
    name=$2
    team_dir
    [[ $name =~ ^[a-z0-9_-]{1,64}$ ]] || fail "'$name' isn't an identity name"
    # Resumable (finding 7dc098439105): each step is done only if it's still to do, so a retire that was
    # interrupted, or a key put back by hand, is finished by running it again.
    # A link in place of a key file would make the cmp below compare a file with itself, and the rm
    # delete the only copy (finding f6e5238e58db's verdict, 3d9b83e27f55): refuse before anything changes.
    for key in "$dir/keys/$name.json" "$dir/keys/retired/$name.json"; do
      [ ! -L "$key" ] || fail "$key is a symbolic link; tell the owner, nothing was changed"
    done
    listed=false
    grep -q "\"name\":\"$name\"" "$dir/keys/retired.jsonl" 2>/dev/null && listed=true
    in_keys=false
    [ -f "$dir/keys/$name.json" ] && in_keys=true
    tokened=false
    { [ -e "$dir/tokens/$name" ] || grep -q "^$name " "$dir/tokens.b3" 2>/dev/null; } && tokened=true
    if ! $listed && ! $in_keys; then
      [ -e "$dir/keys/retired/$name.json" ] || fail "this server holds no key for $name"
    fi
    # A differing copy in keys/ stops retire before it lists the key, so a refused retire changes nothing.
    if $in_keys && [ -e "$dir/keys/retired/$name.json" ]; then
      cmp -s "$dir/keys/$name.json" "$dir/keys/retired/$name.json" ||
        fail "$dir/keys/$name.json differs from the retired copy in $dir/keys/retired/; tell the owner, nothing was changed"
    fi
    if $listed && ! $in_keys && ! $tokened && [ -e "$dir/keys/retired/$name.json" ]; then
      # Nothing is left on disk, but the restart leaves no trace there: a retire stopped after it rewrote
      # tokens.b3 and before it restarted would leave a running server that still signs with the key and
      # takes the token (finding f6e5238e58db). Restarting is harmless, so a running server is restarted.
      can_restart
      if [ -s "$dir/tokens.b3" ]; then restart "$name's retirement"; elif running_pid >/dev/null; then stop_server; fi
      fail "$name is already retired"
    fi
    can_restart
    if ! $listed; then
      agent=$(grep "\"name\":\"$name\"" "$dir/held.jsonl" | grep -oE '[0-9a-f]{64}' | tail -1) ||
        fail "$name isn't in $dir/held.jsonl, so its public key is unknown"
      printf '{"name":"%s","agent":"%s"}\n' "$name" "$agent" >>"$dir/keys/retired.jsonl"
    fi
    if $in_keys; then
      if [ -e "$dir/keys/retired/$name.json" ]; then
        # Identical: checked above.
        rm "$dir/keys/$name.json"
      else
        mv "$dir/keys/$name.json" "$dir/keys/retired/$name.json"
      fi
    fi
    rm -f "$dir/tokens/$name"
    { grep -v "^$name " "$dir/tokens.b3" || true; } >"$dir/tokens.b3.new"
    mv "$dir/tokens.b3.new" "$dir/tokens.b3"
    echo "team-server: retired $name: the server no longer signs for it, and its token is gone; note it in a claim"
    if [ -s "$dir/tokens.b3" ]; then restart "$name's retirement"; elif running_pid >/dev/null; then stop_server; fi
    ;;
  start)
    [ $# -eq 1 ] || usage
    team_dir
    ! managed || fail "launchd runs the server ($label), and restarts it itself; scripts/services status says how it is"
    ! pid=$(running_pid) || fail "already running (pid $pid)"
    start_server
    ;;
  stop)
    [ $# -eq 1 ] || usage
    team_dir
    ! managed || fail "launchd runs the server ($label) and would restart it; scripts/services uninstall stops it"
    stop_server
    ;;
  run)
    # launchd's: the server in the foreground, as this process, logging where start's does.
    [ $# -eq 1 ] || usage
    team_dir
    # A clean exit: launchd (KeepAlive, SuccessfulExit false) then stops retrying, rather than logging
    # this every 10 seconds while the other server runs.
    if pid=$(running_pid); then
      echo "team-server: already running (pid $pid); not starting another" >&2
      exit 0
    fi
    prepare
    echo "$$" >"$dir/server.pid"
    exec "${serve[@]}" </dev/null >>"$dir/server.log" 2>&1
    ;;
  check)
    [ $# -eq 1 ] || usage
    team_dir
    await_up || exit 1
    ;;
  *) usage ;;
esac
