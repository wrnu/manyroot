#!/usr/bin/env bash
# test-table: the whole test table, as the manager counts it, in one command.
#
#   test-table
#   test-table --remote [-p <package>]...
#   test-table --split [-p <package>]...
#   test-table --light -p <package>...       (in --split -p's box)
#   test-table --lists [-p <package>]...     (in --split's box)
#
# Runs, from the top of the checkout it lives in, stopping at the first that fails:
#   cargo fmt --check
#   cargo clippy --locked --all-targets -- -D warnings
#   cargo clippy --locked --workspace --all-targets --target x86_64-unknown-linux-gnu -- -D warnings
#   timeout 1800 cargo nextest run --locked --workspace --no-fail-fast
#   timeout 1800 cargo test --locked --doc --workspace
#   scripts/ground-guards origin/main HEAD
# That's AGENTS.md's table plus the checks the manager adds (the Linux-target lint, since nothing
# runs on Linux now, and the Ground guards). scripts/merge accepts main ahead of a head in code only
# on a manager pass of exactly this command, run with bk-evidence --on, so a partial re-run after
# main moves can't count. Another project replaces the commands with its own table.
#
# Docs-only (owner decision 642a47c04a10): when everything HEAD changed since it left origin/main is
# docs, by scripts/code-scope (*.md outside crates/; a rename or deletion of anything else is code),
# it runs only cargo fmt --check and the Ground guards, and says 'docs-only: skipped clippy and cargo
# test', which bk-evidence then records in its method. Anything else, no origin/main, or no change
# at all runs the whole table.
#
# HEAD at origin/main itself (verify-seq's run of main alone) runs the whole table but skips the Ground
# guards, which compare a head with main and so have nothing to check, and says so (task
# 1e89b53c6a4a). Any other head runs them; scripts/merge runs them again on every head it merges.
#
# The tests run under cargo-nextest (decision 4bf44934cb67 (4)): every test, each in its own process,
# all of the workspace's test binaries at once, then the doctests, which nextest doesn't run, under
# cargo test --doc. Nothing is left out: nextest's default profile has no filter, and the fast profile
# in .config/nextest.toml is for builders only.
#
# Needs the x86_64-unknown-linux-gnu target (rustup target add x86_64-unknown-linux-gnu), timeout
# (gtimeout on macOS, from coreutils), and cargo-nextest (reference 4f8a96525a1e) where the tests run
# here. A box gets its own (below).
#
# --remote runs the same table, unchanged, in one boat.dev box instead of on this machine (owner
# decision 25c1e3543e76): HEAD and origin/main go in as a git bundle, the box checks HEAD out with
# origin/main beside it and runs this script there, so the Ground guards check the same commits. The
# box gets no account secrets (--no-env), no credentials, and nothing the bundle doesn't hold: the
# bundle is the only thing pushed. The tree must be clean, so what's tested is HEAD. It prints the
# box's output, its exit and its cost line, and exits with the box's exit. The box is deleted on
# every way out: boat run deletes it when the command ends or is interrupted, and once boat has
# printed the box's id, a box still listed in any state when this exits (or any box, if boat can't
# list them) is deleted by id. A Ctrl-C before boat prints the id leaves the deletion to boat run
# alone. In the box, the guards use the bracken cargo just built.
#
# --remote -p <package>... runs only 'cargo test --locked -p <package>...' in the box, after the same
# setup, for a builder's scoped tests (decision ef5b807d3196 (1)) when this machine is loaded. It isn't
# the table, and it never counts as it: scripts/merge and bk-evidence --reuse take only exactly
# scripts/test-table or scripts/test-table --split.
#
# --split is the manager's counted run (owner decision 01a2d668b67e): the whole table in one box, as
# --remote runs it, and at the same time, here, only the tests that need macOS, which Linux skips:
# every test in a 'mod macos_only' (cargo nextest run -E 'test(~macos_only::)'). It passes only if
# both pass. Which tests need macOS comes from the code: the box also lists the tests Linux has and
# ignores, this Mac lists its own, and any test that runs here but is missing or ignored on Linux
# must be in a macos_only module, or the run fails naming it, so no test is skipped on both sides.
# Each side lists its tests twice over: cargo nextest list for the tests in test binaries, and cargo
# test --doc -- --list for the doctests (answer 92eacabfd720). The box runs test-table --lists for its
# side: each list is written whole to a file first, cargo's own output to files too, and printed only
# then, with nothing else writing, each list ending with its cksum, which this side checks. So a line on
# standard error, which the box's output carries in the same stream, can't land inside a list line and
# drop a test from it (task 06d7b4ef2c75), and a list damaged on the way fails as damaged.
# It ends with the last lines of both parts. A docs-only head (below) runs locally, with no box. A
# Ctrl-C or a failure here stops the box, and the box is deleted as --remote deletes it.
#
# --split -p <package>... is the light counted run (decision 464d3ccca45e, finding 94e07ed7dd6b), run by
# scripts/verify-seq --light in the merged tree (bk-evidence --on), the packages scripts/code-scope
# packages computes. It's --split for those packages only: the box runs --light -p <package>... (cargo
# fmt --check, both clippies, cargo nextest run -p <package>..., every test of those packages, the slow
# ones too, cargo test --doc for those of them with a library, and the Ground guards), and this Mac
# runs their macOS-only tests, the lists of both sides restricted to them too. It isn't the whole
# table, and it counts only where scripts/merge takes a light pass: never for a head scripts/code-scope
# full names. A docs-only head runs it too, with no shortcut. --light alone runs the box's part here.
#
# With TEST_TABLE_MODE set (verify-seq sets it: the mode, light or full, and why), a run that passes, or
# fails through a check here, ends with 'test-table: counted run mode: <it>', so the evidence's details
# hold it.
set -euo pipefail
# The tests decide for themselves whether a read goes through the verified snapshot: a full check
# asked for by whoever runs the table mustn't reach them (finding 607273d1d193).
unset BRACKEN_FULL_CHECK

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$(git -C "$here" rev-parse --show-toplevel)"
# The counted run's mode and why, for the evidence's details: verify-seq sets TEST_TABLE_MODE.
mode_line() { [ -z "${TEST_TABLE_MODE:-}" ] || echo "test-table: counted run mode: $TEST_TABLE_MODE"; }
fail() { echo "test-table: $*" >&2; mode_line >&2; exit 1; }
timeout=$(command -v timeout || command -v gtimeout) || fail "needs timeout (on macOS, gtimeout from coreutils)"
# Every compile here runs afresh and refreshes sccache's entry, never reading one: a counted run never
# rests on entries a branch's build wrote (finding 292898be0ce0; scripts/rustc-wrapper passes it on).
export SCCACHE_RECACHE=1

# Whether box $1 may still exist: listed in any state, or boat can't say. --all, because plain list
# shows only running boxes, and one left stopped, pending, stopping or in error keeps its data.
box_left() {
  local listing
  ! listing=$(boat list --all --json 2>/dev/null) || grep -qE "\"id\": *\"$1\"" <<<"$listing"
}
# Deletes box $1 if boat left it, and says so if it's still there.
delete_box() {
  box_left "$1" || return 0
  echo "test-table: deleting box $1" >&2
  # It fails with "not found" if boat had deleted it after all; the check after says which.
  boat delete --yes "$1" >/dev/null 2>&1 || true
  ! box_left "$1" || echo "test-table: box $1 may be left; see boat list --all, and delete it: boat delete --yes $1" >&2
}
# The box boat announced ("bx_… ready") in output file $1, not any id the box's own output mentions.
box_in() { grep -oE '^bx_[a-z0-9]+ ready' "$1" 2>/dev/null | head -1 | cut -d' ' -f1 || true; }

# cargo-nextest for a box (decision 4bf44934cb67 (4), answer 92eacabfd720): its pinned Linux release,
# checked against this sha256 before it's unpacked, and a mismatch stops the box. The hash is the one
# nextest publishes beside the tarball on its GitHub release (cargo-nextest-0.9.150-x86_64-unknown-
# linux-gnu.sha256), which matched GitHub's own digest of the asset and the sha256 of a download, all
# three checked on 2026-10-30. The tarball holds one file, cargo-nextest.
nextest_version=0.9.150
nextest_sha256=b0959bc64232974224cf9fb22c915845398c0e8668fa7831eb5b43fb1eef781f

# Fails unless cargo can run nextest here.
need_nextest() {
  cargo nextest --version >/dev/null 2>&1 || fail "needs cargo-nextest (cargo install --locked cargo-nextest; reference 4f8a96525a1e)"
}

# The packages --remote -p names: the box runs only their tests, not the table. For --split -p
# (light_split) and --light, the light table's packages; libs, after scope_libs, those of them with a
# library, as -p options.
packages=()
light=false
light_split=false
libs=()

# Checks every named package is this workspace's, and sets libs to those with a library, whose
# doctests cargo test --doc can run (it fails on a binary-only package).
scope_libs() {
  local meta p
  command -v jq >/dev/null || fail "-p with --light, --split or --lists needs jq"
  meta=$(cargo metadata --locked --no-deps --format-version 1) || fail "failed: cargo metadata"
  libs=()
  for p in "${packages[@]}"; do
    jq -e --arg p "$p" 'any(.packages[]; .name == $p)' <<<"$meta" >/dev/null || fail "no package $p in this workspace"
    if jq -e --arg p "$p" 'any(.packages[] | select(.name == $p) | .targets[]; .kind | index("lib"))' <<<"$meta" >/dev/null; then
      libs+=(-p "$p")
    fi
  done
}

# The cargo options for the scope: -p <package>... if packages are named, else --workspace.
scope_args() {
  if [ ${#packages[@]} -gt 0 ]; then printf -- '-p\n%s\n' "${packages[@]}"; else echo --workspace; fi
}

# The table in one boat box, for HEAD, or only the tests of $packages; $1, if given, runs in the box
# after it.
remote() {
  local rc line
  command -v boat >/dev/null || fail "--remote needs boat (reference ea41264b3c38)"
  [ -z "$(git status --porcelain)" ] || fail "--remote tests HEAD: commit or set aside the changes first"
  git rev-parse -q --verify refs/remotes/origin/main >/dev/null || fail "no origin/main to bundle"
  # tmp, out and box are globals: the EXIT trap runs after this function has returned.
  tmp=$(mktemp -d)
  out="$tmp/box.out"
  # Every way out deletes the box if boat left one, and the bundle.
  # shellcheck disable=SC2329 # run by the EXIT trap
  cleanup() {
    local box
    box=$(box_in "$out")
    [ -z "$box" ] || delete_box "$box"
    rm -rf -- "$tmp"
  }
  trap cleanup EXIT
  trap 'exit 130' INT TERM
  mkdir "$tmp/push"
  git bundle create -q "$tmp/push/tree.bundle" HEAD refs/remotes/origin/main
  # In the box: the tools it lacks, HEAD checked out with origin/main beside it, then this script.
  # It lacks b3sum (team-server) and a git newer than the 2.43 Ubuntu ships, which neither traces the
  # programs it starts nor fsck-checks a fetched bundle; the experiment's git-mode tests check both and
  # need 2.46 (MIN_GIT in crates/experiment/src/git_mode.rs). The git-core PPA has the current git.
  # Launchpad times out or drops the connection now and then (task 95302a01f49a), so adding the PPA is
  # tried four times, each for at most 2 minutes, 10, 30 and 90 s apart. If it still fails, the image's
  # own git does only if it's 2.46 or later; otherwise setup fails, saying so. Whichever git it ends
  # with is checked against 2.46. Their output shows only if they fail. Then every crate the
  # host's whole package graph needs, dev-dependencies of packages the -p list leaves out included:
  # bracken-scope's cargo metadata --offline reads them all, and a build fetches only what it builds
  # (task 53efd11c6e4a: unicode-properties, manyroot's dev-dependency, without -p manyroot).
  # shellcheck disable=SC2016 # expanded in the box
  local inner='set -eu
sudo=; [ "$(id -u)" -eq 0 ] || sudo=sudo
setup() {
  log=$(mktemp)
  "$@" >"$log" 2>&1 || { rc=$?; echo "test-table: box setup failed (exit $rc): $*" >&2; cat "$log" >&2; exit "$rc"; }
}
need_git=2.46
git_ok() {
  read -r major minor < <(git --version 2>/dev/null | sed -n "s/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p") ||
    return 1
  [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 46 ]; }
}
git_said() { git --version 2>&1 | head -n 1; }
: "${ppa_waits:=10 30 90}"
ppa=no tries=0
for wait in $ppa_waits ""; do
  tries=$((tries + 1)) log=$(mktemp)
  if timeout 120 $sudo add-apt-repository -y ppa:git-core/ppa >"$log" 2>&1; then
    ppa=yes
    break
  else
    rc=$?
  fi
  echo "test-table: box setup: adding ppa:git-core/ppa failed (exit $rc)${wait:+; trying again in ${wait}s}" >&2
  tail -n 5 "$log" >&2
  [ -z "$wait" ] || sleep "$wait"
done
if [ $ppa = yes ]; then
  setup $sudo apt-get install -y -qq -o Acquire::Retries=3 git b3sum curl jq lsof
elif git_ok; then
  echo "test-table: box setup: Launchpad unreachable after $tries tries; using the image'"'"'s $(git_said), which is $need_git or later" >&2
  setup $sudo apt-get update -qq
  setup $sudo apt-get install -y -qq -o Acquire::Retries=3 b3sum curl jq lsof
else
  echo "test-table: box setup failed: couldn'"'"'t add ppa:git-core/ppa after $tries tries (Launchpad unreachable?), and the image'"'"'s $(git_said) is older than the $need_git the experiment'"'"'s git-mode tests need" >&2
  exit 1
fi
git_ok || {
  echo "test-table: box setup failed: $(git_said) is older than the $need_git the experiment'"'"'s git-mode tests need" >&2
  exit 1
}
nextest_tar=cargo-nextest-$nextest_version-x86_64-unknown-linux-gnu.tar.gz
nextest_dir=$(mktemp -d)
setup curl -fsSL -o "$nextest_dir/$nextest_tar" "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-$nextest_version/$nextest_tar"
echo "$nextest_sha256  $nextest_dir/$nextest_tar" | sha256sum -c --quiet - >/dev/null 2>&1 ||
  { echo "test-table: $nextest_tar does not match its pinned sha256; not running it" >&2; exit 1; }
setup tar -xzf "$nextest_dir/$nextest_tar" -C "$nextest_dir" cargo-nextest
export PATH="$nextest_dir:$PATH"
git init -q tree
cd tree
git fetch -q ../tree.bundle +HEAD:refs/heads/tested +refs/remotes/origin/main:refs/remotes/origin/main
git checkout -q tested
setup cargo fetch --locked --target "$(rustc -vV | sed -n "s/^host: //p")"'
  local what="the table"
  if $light_split; then
    what="the light table:$(printf ' -p %s' "${packages[@]}")"
    # The Ground guards need the bracken binary, which the scope's tests may not build.
    # shellcheck disable=SC2016 # expanded in the box
    inner="$inner"'
cargo build --locked -q -p bracken --bin bracken
BRACKEN_BIN="$PWD/target/debug/bracken" scripts/test-table --light'"$(printf ' -p %s' "${packages[@]}")"
  elif [ ${#packages[@]} -gt 0 ]; then
    what="cargo test --locked$(printf ' -p %s' "${packages[@]}")"
    inner="$inner
$what"
  else
    # shellcheck disable=SC2016 # expanded in the box
    inner="$inner"'
BRACKEN_BIN="$PWD/target/debug/bracken" scripts/test-table'
  fi
  inner="nextest_version=$nextest_version nextest_sha256=$nextest_sha256
$inner${1:+
$1}"
  set +e
  # tee -i: a Ctrl-C must not stop the copy before boat has printed the box it's deleting.
  boat run --no-env --push "$tmp/push" --type default --timeout 2400 -- bash -c "$inner" 2>&1 | tee -i "$out"
  rc=${PIPESTATUS[0]}
  set -e
  line=$(grep -E '^exit [0-9]+ · ' "$out" | tail -1 || true)
  echo "test-table: box: ${line:-no cost line from boat}"
  if [ "$rc" -ne 0 ]; then
    echo "test-table: the box's table exited $rc" >&2
    exit "$rc"
  fi
  if $light_split; then
    echo "test-table: $what passed at $(git rev-parse HEAD), in a box; not the whole table"
  elif [ ${#packages[@]} -gt 0 ]; then
    echo "test-table: $what passed at $(git rev-parse HEAD), in a box; not the whole table"
  else
    echo "test-table: all passed at $(git rev-parse HEAD), in a box"
  fi
}

# The tests a 'cargo test -- --list' printed, as sorted '<test binary>|<test>' lines: the binary is the
# crate-type name cargo runs (target/.../deps/<name>-<hash>), or doc:<crate> for doc tests.
tests_listed() {
  awk '
    /Running .*deps\/[A-Za-z0-9_]+-[0-9a-f]+\)/ { t = $0; sub(/.*deps\//, "", t); sub(/-[0-9a-f]+\).*/, "", t); next }
    /Doc-tests / { t = $0; sub(/.*Doc-tests /, "doc:", t); next }
    /: test$/ && t != "" { n = $0; sub(/: test$/, "", n); print t "|" n }
  ' | LC_ALL=C sort -u
}

# The tests a 'cargo nextest list --message-format oneline' printed ('<binary id> <test>' a line), as
# sorted '<binary id>|<test>' lines. Doctests come from tests_listed.
nextest_listed() {
  awk 'NF == 2 { print $1 "|" $2 }' | LC_ALL=C sort -u
}

# --lists, in --split's box: the tests this machine has (all) and those it ignores (ignored), as
# 'LIST <which> nextest|doc <line>' lines, each list ending with 'LIST end <which> <cksum of its lines>'.
# Every list goes to a file first, and cargo's own output too (the doctests' list needs cargo's, which
# names each crate), so nothing writes while they're printed: printed as they're made, a buffered
# list's lines could be split by cargo's lines on standard error, which the box's output carries in the
# same stream.
box_lists() {
  local d which run doc rc cargo_scope
  d=$(mktemp -d)
  mapfile -t cargo_scope < <(scope_args)
  if [ ${#packages[@]} -gt 0 ]; then
    scope_libs
  else
    libs=(--workspace)
  fi
  echo "test-table: the tests Linux has, and those it ignores"
  for which in all ignored; do
    run=all doc=''
    [ "$which" = all ] || { run=only; doc=--ignored; }
    cargo nextest list --locked "${cargo_scope[@]}" --run-ignored "$run" --message-format oneline \
      >"$d/$which.nextest" 2>"$d/err" || { rc=$?; cat "$d/err" >&2; exit "$rc"; }
    if [ ${#libs[@]} -eq 0 ]; then
      : >"$d/$which.doc"
    else
      # shellcheck disable=SC2086 # $doc is one option or none
      cargo test --locked --doc "${libs[@]}" -- --list $doc >"$d/$which.doc" 2>&1 ||
        { rc=$?; cat "$d/$which.doc" >&2; exit "$rc"; }
    fi
    # awk 1: each line ends in a newline, the last one too, as the prefixed lines will.
    awk 1 "$d/$which.nextest" >"$d/$which.n"
    awk 1 "$d/$which.doc" >"$d/$which.d"
  done
  for which in all ignored; do
    sed "s/^/LIST $which nextest /" "$d/$which.n"
    sed "s/^/LIST $which doc /" "$d/$which.d"
    echo "LIST end $which $(cat "$d/$which.n" "$d/$which.d" | cksum)"
  done
  rm -rf -- "$d"
}

# Stops the process group of job $1, if it still runs: SIGINT, which boat takes as a Ctrl-C and
# deletes its box, and the tests' part passes on to timeout; 15 s on, SIGTERM; then SIGKILL, so nothing that
# ignores or outlives a signal holds the run open.
stop_group() {
  local sig
  for sig in INT TERM KILL; do
    kill -0 "$1" 2>/dev/null || break
    kill -"$sig" -- "-$1" 2>/dev/null || true
    for _ in $(seq 75); do
      kill -0 "$1" 2>/dev/null || break
      sleep 0.2
    done
  done
  wait "$1" 2>/dev/null || true
}

# Passes a SIGINT or SIGTERM on to this shell's jobs as SIGTERM: a background job starts with SIGINT
# ignored, and timeout keeps it so, but it takes SIGTERM and signals its group. jobs -p holds a job
# from its fork, before $! is saved, so a signal between the two still reaches it. stopping keeps
# timeout's pid for stop_parts (finding a9acfeadbe06).
stopping=false
pass_on() {
  local j
  stopping=true
  for j in $(jobs -p); do kill -TERM "$j" 2>/dev/null || true; done
}

# Runs the rest under timeout for at most $1 s, as a job: timeout runs it in a process group of its
# own, which it signals whole at the limit or on a SIGTERM (SIGKILL 30 s on), so a test program that
# hangs ends with everything cargo started (finding c7d17b82e315). That group is out of reach of a
# signal to this part's, so the part's traps pass it on (pass_on). wait, which a signal interrupts at
# once, gives the exit even if bash has already reaped timeout (note fa805ecf517e); after a signal it
# waits again while timeout runs. timeout's pid is in a file while it runs, for stop_parts to kill
# what in its group ignored the SIGTERM. Afterwards it stays only if the run ended in a stop (finding
# a9acfeadbe06) or at the limit (124, or 137 after -k; note 263eb49eb068), and only while the group
# still has a process in it (note 76933aa89d52). After a normal end it's cleared: the group is gone,
# and its id could be another process's.
bounded() {
  local t rc=0 limit=$1
  shift
  "$timeout" -k 30 "$limit" "$@" &
  t=$!
  echo "$t" >"$split_tmp/timeout.pid"
  wait "$t" || rc=$?
  while [ "$rc" -gt 128 ] && kill -0 "$t" 2>/dev/null; do
    rc=0
    wait "$t" || rc=$?
  done
  if ! { $stopping || [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; } || ! kill -0 -- "-$t" 2>/dev/null; then
    : >"$split_tmp/timeout.pid"
  fi
  return "$rc"
}

# The macOS-only tests here, then this Mac's lists of the tests it has and ignores, each bounded: of
# the workspace, or for --split -p of the named packages only, where none of them may have such a test.
here_part() {
  trap pass_on INT TERM
  local which rc cargo_scope none=()
  mapfile -t cargo_scope < <(scope_args)
  ! $light_split || none=(--no-tests=pass)
  bounded "$here_limit" cargo nextest run --locked "${cargo_scope[@]}" --no-fail-fast "${none[@]}" -E 'test(~macos_only::)' \
    > >(tee -i "$split_tmp/here") 2>&1 || exit
  for which in all only; do
    bounded 300 cargo nextest list --locked "${cargo_scope[@]}" --run-ignored "$which" --message-format oneline \
      >"$split_tmp/mac-$which.nextest" 2>"$split_tmp/mac-$which.err" ||
      { rc=$?; cat "$split_tmp/mac-$which.err" >&2; exit "$rc"; }
  done
  if [ ${#libs[@]} -eq 0 ]; then
    : >"$split_tmp/mac-all.doc"
    : >"$split_tmp/mac-only.doc"
  else
    bounded 300 cargo test --locked --doc "${libs[@]}" -- --list >"$split_tmp/mac-all.doc" 2>&1 || exit
    bounded 300 cargo test --locked --doc "${libs[@]}" -- --list --ignored >"$split_tmp/mac-only.doc" 2>&1 || exit
  fi
  { nextest_listed <"$split_tmp/mac-all.nextest"; tests_listed <"$split_tmp/mac-all.doc"; } | LC_ALL=C sort -u >"$split_tmp/mac-all"
  { nextest_listed <"$split_tmp/mac-only.nextest"; tests_listed <"$split_tmp/mac-only.doc"; } | LC_ALL=C sort -u >"$split_tmp/mac-ignored"
}

# The whole table in a box and the macOS-only tests here, at once.
split() {
  local rc=0 here_rc=0 escaped
  command -v boat >/dev/null || fail "--split needs boat (reference ea41264b3c38)"
  need_nextest
  [ -z "$(git status --porcelain)" ] || fail "--split tests HEAD: commit or set aside the changes first"
  git rev-parse -q --verify refs/remotes/origin/main >/dev/null || fail "no origin/main to bundle"
  if $light_split; then
    scope_libs
  else
    libs=(--workspace)
  fi
  # split_tmp, box_job and here_job are globals: the EXIT trap runs after this function has returned.
  split_tmp=$(mktemp -d)
  # The tests here end by 1800 s, as the local table's do. TEST_TABLE_HERE_LIMIT can only shorten it
  # (for a test of the bound), never lengthen it.
  here_limit=${TEST_TABLE_HERE_LIMIT:-1800}
  [[ $here_limit =~ ^[1-9][0-9]*$ ]] && [ "$here_limit" -le 1800 ] ||
    fail "TEST_TABLE_HERE_LIMIT must be 1 to 1800 seconds, not '$here_limit'"
  box_job='' here_job=''
  # The box's lists, from this script's --lists there (box_lists): each ends with a line holding its
  # cksum, so a list cut short, or with a line damaged on the way, fails the run and can't hide a test.
  # The whole workspace's lists for the full run: printf with no names would still print ' -p ' once,
  # which --lists refuses (fail 40550d3c989e).
  local lists='scripts/test-table --lists'
  [ ${#packages[@]} -eq 0 ] || lists+=$(printf ' -p %s' "${packages[@]}")
  # Stops both parts on every way out, then deletes the box by id if boat left it: a killed box part
  # can't. Both run as jobs with job control (set -m): each in its own process group, with SIGINT
  # not ignored, as a plain background job's would be (finding 87cfdf4680c7), and this shell waits
  # on them with wait, which a signal interrupts at once.
  # shellcheck disable=SC2329 # run by the EXIT trap
  stop_parts() {
    local box job t
    # jobs -p: each part from its fork, before its pid is saved, as a signal between the two needs.
    for job in $(jobs -p); do
      if [ "$job" = "$box_job" ]; then echo "test-table: stopping the box" >&2; else echo "test-table: stopping the tests here" >&2; fi
      stop_group "$job"
    done
    # timeout's own group, if something in it outlived the tests here: only SIGKILL is sure. bounded
    # leaves its pid only while timeout runs, which the loop above has stopped, or after a stop or a
    # limit hit, while the group still had a process in it; never after a normal end.
    t=$(cat "$split_tmp/timeout.pid" 2>/dev/null || true)
    if [ -n "$t" ] && kill -0 -- "-$t" 2>/dev/null; then
      kill -KILL -- "-$t" 2>/dev/null || true
    fi
    box=$(box_in "$split_tmp/box")
    [ -z "$box" ] || delete_box "$box"
    rm -rf -- "$split_tmp"
  }
  trap stop_parts EXIT
  trap 'exit 130' INT TERM
  if $light_split; then
    echo "test-table: the light table in a box:$(printf ' -p %s' "${packages[@]}") (output at the end), and here their macOS-only tests"
  else
    echo "test-table: the whole table in a box (output at the end), and here the macOS-only tests"
  fi
  set -m
  (remote "$lists") >"$split_tmp/box" 2>&1 &
  box_job=$!
  (here_part) &
  here_job=$!
  set +m
  wait "$here_job" || here_rc=$?
  here_job=''
  if [ "$here_rc" -ne 0 ]; then
    echo "test-table: the macOS-only tests here failed (exit $here_rc)" >&2
    exit "$here_rc"
  fi
  wait "$box_job" || rc=$?
  box_job=''
  local which
  for which in all ignored; do
    {
      sed -n "s/^LIST $which nextest //p" "$split_tmp/box" | nextest_listed
      sed -n "s/^LIST $which doc //p" "$split_tmp/box" | tests_listed
    } | LC_ALL=C sort -u >"$split_tmp/linux-$which"
  done
  echo "== the box, last lines"
  grep -v '^LIST ' "$split_tmp/box" | tail -n 15
  echo "== here, last lines"
  grep -E '^ *Summary \[|^test-table: ' "$split_tmp/here" | tail -n 8 || true
  [ "$rc" -eq 0 ] || { echo "test-table: the box's table exited $rc" >&2; exit "$rc"; }
  local sum got
  for which in all ignored; do
    sum=$(sed -n "s/^LIST end $which //p" "$split_tmp/box" | tail -n 1)
    [ -n "$sum" ] || fail "the box's test lists didn't finish, so which tests need macOS is unknown"
    got=$({
      sed -n "s/^LIST $which nextest //p" "$split_tmp/box"
      sed -n "s/^LIST $which doc //p" "$split_tmp/box"
    } | cksum)
    [ "$got" = "$sum" ] ||
      fail "the box's list of $which tests came back damaged (its cksum doesn't match), so which tests need macOS is unknown"
  done
  [ -s "$split_tmp/linux-all" ] || fail "the box listed no tests, so which tests need macOS is unknown"
  # Runs here but is missing on Linux, or ignored there and not here: it must be one of the tests run here.
  escaped=$({
    LC_ALL=C comm -23 "$split_tmp/mac-all" "$split_tmp/linux-all"
    LC_ALL=C comm -23 "$split_tmp/linux-ignored" "$split_tmp/mac-ignored" | LC_ALL=C comm -12 - "$split_tmp/mac-all"
  } | grep -v '^[^|]*|.*macos_only::' || true)
  [ -z "$escaped" ] ||
    fail "these run on this Mac but not on Linux, and aren't in a macos_only module, so neither part runs them: $(tr '\n' ' ' <<<"$escaped")"
  if $light_split; then
    echo "test-table: light run passed at $(git rev-parse HEAD):$(printf ' -p %s' "${packages[@]}"), in a box, and their macOS-only tests here; not the whole table"
  else
    echo "test-table: all passed at $(git rev-parse HEAD): the whole table in a box, and the macOS-only tests here"
  fi
  mode_line
}

# Parses -p <package>... from $@ into packages, failing with usage $1 on anything else.
take_packages() {
  local use=$1
  shift
  while [ $# -gt 0 ]; do
    [ "$1" = -p ] && [ $# -ge 2 ] || fail "usage: $use"
    # A name goes into the box's script: a letter or digit, then letters, digits, - and _ only, as
    # cargo's package names, so never an option or anything the box's shell would read.
    [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || fail "-p takes a package name, not '$2'"
    packages+=("$2")
    shift 2
  done
}

case "${1:-}" in
  '') ;;
  --remote)
    shift
    take_packages "test-table --remote [-p <package>]..." "$@"
    remote
    exit 0
    ;;
  --light)
    shift
    [ $# -ge 2 ] || fail "usage: test-table --light -p <package>..."
    take_packages "test-table --light -p <package>..." "$@"
    light=true
    ;;
  --lists)
    shift
    take_packages "test-table --lists [-p <package>]..." "$@"
    box_lists
    exit 0
    ;;
  --split)
    shift
    take_packages "test-table --split [-p <package>]..." "$@"
    if [ ${#packages[@]} -gt 0 ]; then
      light_split=true
      split
      exit 0
    fi
    # A docs-only head runs the local docs-only table below: nothing for a box to do.
    "$here/code-scope" docs-only origin/main HEAD >/dev/null 2>&1 || { split; exit 0; }
    ;;
  *) fail "usage: test-table [--remote [-p <package>]... | --split [-p <package>]... | --light -p <package>... | --lists [-p <package>]...]" ;;
esac

step() {
  echo "test-table: $*"
  "$@" || fail "failed: $*"
}
guards() {
  if [ "$(git rev-parse HEAD)" = "$(git rev-parse --verify -q 'origin/main^{commit}' || true)" ]; then
    echo "test-table: HEAD is origin/main: skipped the Ground guards (nothing to compare it with)"
  else
    step scripts/ground-guards origin/main HEAD
  fi
}
if $light; then
  need_nextest
  # Every named package must be this workspace's, and the doctests run for those with a library.
  scope_libs
  scope=$(printf ' -p %s' "${packages[@]}")
  echo "test-table: light:$scope"
  step cargo fmt --check
  step cargo clippy --locked --all-targets -- -D warnings
  step cargo clippy --locked --workspace --all-targets --target x86_64-unknown-linux-gnu -- -D warnings
  # shellcheck disable=SC2086 # $scope is the -p options, one word each
  step "$timeout" 1800 cargo nextest run --locked --no-fail-fast $scope
  if [ ${#libs[@]} -gt 0 ]; then
    step "$timeout" 1800 cargo test --locked --doc "${libs[@]}"
  else
    echo "test-table: no doctests:$scope has no library"
  fi
  guards
  echo "test-table: light run passed at $(git rev-parse HEAD):$scope; not the whole table"
  mode_line
  exit 0
fi
if scope=$("$here/code-scope" docs-only origin/main HEAD 2>&1); then
  echo "test-table: $scope"
  step cargo fmt --check
  echo "test-table: docs-only: skipped clippy and cargo test"
  guards
  echo "test-table: all passed at $(git rev-parse HEAD), docs-only"
  mode_line
  exit 0
fi
need_nextest
step cargo fmt --check
step cargo clippy --locked --all-targets -- -D warnings
step cargo clippy --locked --workspace --all-targets --target x86_64-unknown-linux-gnu -- -D warnings
step "$timeout" 1800 cargo nextest run --locked --workspace --no-fail-fast
step "$timeout" 1800 cargo test --locked --doc --workspace
guards
echo "test-table: all passed at $(git rev-parse HEAD)"
mode_line
