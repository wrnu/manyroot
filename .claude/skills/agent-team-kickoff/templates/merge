      and (.superseded_by_others | length) == 0)' <<<"$approvals" >/dev/null; then
      approved="${a:0:12} supports the pr claim"
      ! jq -e --arg a "$a" 'any(.[]; .id == $a and (.body.tags | index("delegated")))' <<<"$approvals" >/dev/null ||
        approved="$approved, signed by the manager on the owner's delegation"
      break
    fi
  done
  if [ -n "$approved" ]; then
    owner_case="owner-signed approval $approved"
    check ok owner "$owner_case"
  else
    check FAIL owner "no current owner-signed approval supports pr claim $claim itself (one of a task or an earlier head doesn't count); the owner signs one with scripts/owner-approve $claim \"<what>\" (a manager-signed quote doesn't count)"
  fi
fi

[ "$failed" = 0 ] || fail "not merging PR #$pr: a check failed"

body=$(mktemp)
details=$(mktemp)
trap 'rm -f "$body" "$details"' EXIT
jq -n --arg sha "$sha" --arg title "$title (#$pr)" '{merge_method: "squash", sha: $sha, commit_title: $title}' >"$body"
if $dry_run; then
  echo "dry run: all checks pass; would record 'merge gate @ $sha' on $claim, then PUT /pulls/$pr/merge with:"
  cat "$body"
  exit 0
fi

printf 'claim: %s is the current pr claim for #%s (%s @ %s)\ngate: accepted under %s (passes: %s)\nfindings: %s\ngithub head: %s (PR #%s open against main)\nmain: %s\nguards: %s\nfrozen: %s\nowner: %s\n' \
  "$full" "$pr" "$branch" "$sha" "$policy_text" "$passes" "$findings_text" "$f_head" "$pr" "$main_case" "$guards_case" "$frozen_case" "$owner_case" >"$details"
written=$(bk evidence "$claim" pass --method "merge gate @ $sha" --details-file "$details" --as "$agent") ||
  fail "couldn't record the merge-gate evidence; not merging"
# The first line's last word: 'evidence <id>' (task d4e958fd6719), or a bare id from an older pinned binary.
id=${written%%$'\n'*}
id=${id##* }
echo "recorded merge gate evidence $id"
# A live merge-gate pass is what says a PR merged (bracken log --open closes findings against it), so a
# merge GitHub refused takes it back (finding d494f36dee9d). But the call also fails when GitHub
# merges anyway: a proxy's 502 or 504, or a dropped connection, while it's still merging. So GitHub is
# asked (findings f1fc25380904, 3623855aa0e8). Merged at this head keeps the pass. Open, at any head,
# retracts it: at once after a 4xx (a 409 if the head moved), and otherwise only if it's still open after
# asking again for a few seconds. Anything else stops, naming the evidence.
pr_now() { # merged, merged-elsewhere, open or unknown
  local now
  now=$(api GET "/pulls/$pr" 2>/dev/null) || { echo unknown; return; }
  jq -r --arg sha "$sha" 'if .merged == true then (if .head.sha == $sha then "merged" else "merged-elsewhere" end)
    elif .state == "open" then "open" else "unknown" end' <<<"$now" 2>/dev/null || echo unknown
}
if ! status=$(api PUT "/pulls/$pr/merge" "$body" status); then
  outcome=$(pr_now)
  case "$status" in 4??) asks=0 ;; *) asks=3 ;; esac
  while [ "$outcome" = open ] && [ "$asks" -gt 0 ]; do
    sleep 2
    asks=$((asks - 1))
    outcome=$(pr_now)
  done
  case "$outcome" in
    open)
      bk retract "$id" --reason "GitHub didn't merge PR #$pr at $sha (HTTP $status)" --as "$agent" >/dev/null ||
        fail "the merge failed (HTTP $status; a 409 if the head moved) and PR #$pr is open, and retracting the merge gate evidence $id failed or wasn't confirmed: check with scripts/bk show $id, and if it isn't retracted, run scripts/bk retract $id --as $agent, or log --open counts PR #$pr as merged"
      fail "the merge failed (HTTP $status; a 409 if the head moved) and PR #$pr is open; the merge gate evidence $id is retracted, so it still counts as open" ;;
    merged) echo "the merge call failed (HTTP $status), but GitHub shows PR #$pr merged at $sha; the evidence $id stands" ;;
    *) fail "the merge's outcome is unclear: the call failed (HTTP $status), and GitHub shows PR #$pr neither merged at $sha nor open (${outcome}). The merge gate evidence $id stands; if the PR didn't merge at $sha, run scripts/bk retract $id --as $agent" ;;
  esac
fi
echo "merged PR #$pr at $sha"
# GitHub's merge call has no delete_branch_after_merge, so the head branch goes here: only a branch of
# origin's repository (never a fork's, never main), only while it is still at the sha, and best effort.
if [ "$f_head_repo" = "$repo" ] && [ "$f_head_ref" != main ] && [[ $f_head_ref =~ ^[A-Za-z0-9._/-]+$ ]] &&
  [ "$(api GET "/git/ref/heads/$f_head_ref" 2>/dev/null | jq -r '.object.sha // empty' 2>/dev/null)" = "$sha" ]; then
  if deleted=$(api DELETE "/git/refs/heads/$f_head_ref" '' status); then
    echo "deleted branch $f_head_ref"
  else
    echo "merge: couldn't delete branch $f_head_ref (HTTP $deleted); the merge stands"
  fi
fi
if [ -n "$expect_after" ]; then
  git -C "$main" fetch -q origin main || fail "merged PR #$pr, but couldn't fetch main to compare it with the batch: stop the batch"
  now=$(key_of origin/main)
  bad=$(untested "$expect_after" "$(git -C "$main" rev-parse origin/main)")
  [ "$now" = "$(key_of "$expect_after")" ] && [ -z "$bad" ] ||
    fail "merged PR #$pr, but main (key ${now:-unknown}) isn't the batch's prefix $member (commit $expect_after, key $(key_of "$expect_after"))${bad:+, differing in $(tr "\n" " " <<<"$bad")}: stop the batch"
  echo "main is the batch's prefix $member (key $now)"
fi
# Free what finished work left behind (process 11f1ac552f26). The merge stands whatever cleanup does.
if $no_cleanup; then
  :
elif [ -x "$here/cleanup" ]; then
  "$here/cleanup" --apply </dev/null 2>&1 | sed 's/^/  /' || echo "merge: cleanup failed (the merge stands); run scripts/cleanup to see why"
fi
echo "update the main checkout only through scripts/ground-checkpoint and the sha it names, not git pull (process 9.3)"
}

# The whole batch: check every member, then merge them in order (see the header).
if [ "${1:-}" = --batch ]; then
  [ $# -ge 2 ] && [[ $2 =~ ^[0-9a-f]{12,64}$ ]] || usage
  batch=$2
  shift 2
  rest=() dry=false agent=${BRACKEN_AGENT:-}
  for a in "$@"; do
    case "$a" in --dry-run) dry=true ;; *) rest+=("$a") ;; esac
  done
  for ((k = 0; k < ${#rest[@]}; k++)); do [ "${rest[k]}" != --as ] || agent=${rest[k + 1]:-}; done
  command -v jq >/dev/null || fail "needs jq"
  bk() { BK_PULL=required BRACKEN_FULL_CHECK=1 BRACKEN_AGENT=${agent:-manager} "$here/bk" "$@"; }
  read_batch "$batch" || fail "$batch_why"
  # Which members the Ground says merged: a live manager 'merge gate @ <sha>' pass on the claim.
  gated() {
    local j out=()
    for ((j = 0; j < b_n; j++)); do
      bk show "${b_claim[j]}" --json 2>/dev/null | jq -e --arg sha "${b_sha[j]}" 'any(.referrers[]; .kind == "evidence"
        and .retracted == false and .author_name == "manager" and .body.method == "merge gate @ " + $sha)' >/dev/null &&
        out+=("#${b_pr[j]}")
    done
    echo "${out[*]:-none}"
  }
  echo "batch ${b_full:0:12}: $b_n members on main ${b_main:0:12}, tree $b_key"
  for ((k = 0; k < b_n; k++)); do
    echo "== check member $((k + 1)): PR #${b_pr[k]} (${b_claim[k]:0:12})"
    set +e
    (batch_member=$b_full batch_precheck=true; merge_one "${b_pr[k]}" "${b_claim[k]}" "${rest[@]}" --dry-run) 2>&1 | sed 's/^/  /'
    code=${PIPESTATUS[0]}
    set -e
    [ "$code" = 0 ] || fail "member $((k + 1)) (PR #${b_pr[k]}) fails a check: merging none of the batch"
  done
  if $dry; then
    echo "dry run: every member passes; would merge, in order: $(printf '#%s ' "${b_pr[@]}")"
    exit 0
  fi
  for ((k = 0; k < b_n; k++)); do
    echo "== merge member $((k + 1)): PR #${b_pr[k]} (${b_claim[k]:0:12})"
    set +e
    (batch_member=$b_full no_cleanup=true; merge_one "${b_pr[k]}" "${b_claim[k]}" "${rest[@]}") 2>&1 | sed 's/^/  /'
    code=${PIPESTATUS[0]}
    set -e
    if [ "$code" != 0 ]; then
      fail "stopped at member $((k + 1)) (PR #${b_pr[k]}); merged, by the live merge-gate passes: $(gated). main is on a prefix of the batch that nothing tested: verify the rest again on main's new tip"
    fi
  done
  echo "merged the batch, in order: $(gated); main is on the tested tree $b_key"
  if [ -x "$here/cleanup" ]; then
    "$here/cleanup" --apply </dev/null 2>&1 | sed 's/^/  /' || echo "merge: cleanup failed (the merges stand); run scripts/cleanup to see why"
  fi
  exit 0
fi
merge_one "$@"
