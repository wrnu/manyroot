    [ "$b" = "$batch_member" ] || continue
    if batch_pass_ok "$b" "$m" "$k" "$e"; then found=true; break; fi
  done <<<"$batch_passes"
  if ! $found; then
    check FAIL main "no manager batch pass of batch ${batch_member:0:12} on this claim that counts (a current batch claim listing #$pr $full @ $sha, and its run's pass)"
    return
  fi
  if ! chain=$(cd "$main" && "$here/code-scope" chain "$b_main" "${b_sha[@]}" 2>&1); then
    check FAIL main "batch ${b_full:0:12} no longer merges onto its own main: $chain"
    return
  fi
  while read -r j c k; do commits[j]=$c keys[j]=$k; done <<<"$chain"
  if ! batch_ours; then
    check FAIL main "couldn't list the paths batch ${b_full:0:12}'s members change (git merge-base or diff failed)"
    return
  fi
  t=$(key_of "$tip")
  if $batch_precheck; then
    bad=$(untested "${commits[0]}")
    if [ -z "$bad" ] && [ "$t" = "${keys[0]}" ] && [ "$(merged_key "$tip" "${b_sha[@]}")" = "$b_key" ]; then
      main_case="batch ${b_full:0:12}, member $member of $b_n: main ($tip) is the batch's main ${b_main:0:12} but for .bracken/ and docs no member touches, and the members merge onto it, in order, into the tested tree $b_key"
      check ok main "$main_case"
    else
      check FAIL main "main ($tip) has moved since the batch's main ${b_main:0:12} in what can change the tests (${bad:+$(tr "\n" " " <<<"$bad")}key $t, the batch's ${keys[0]}), or the members no longer merge onto it into the tested tree: verify the batch again on main's tip"
    fi
    return
  fi
  # GitHub's squash merge of this head onto main, as git merge-tree computes it, must be the next
  # prefix, before the merge call; after it, the merged main is compared again.
  bad=$(untested "${commits[member - 1]}")
  next=$(merged_commit "$tip" "$sha")
  if [ -z "$bad" ] && [ "$t" = "${keys[member - 1]}" ] && [ -n "$next" ] && [ "$(key_of "$next")" = "${keys[member]}" ] &&
    [ -z "$(untested "${commits[member]}" "$next")" ]; then
    expect_after=${commits[member]}
    main_case="batch ${b_full:0:12}, member $member of $b_n: main ($tip) is the batch's prefix $((member - 1)), and this merge gives prefix $member (key ${keys[member]})"
    [ "$member" != "$b_n" ] || main_case="$main_case, the tested tree"
    check ok main "$main_case"
  else
    check FAIL main "main ($tip, key $t) isn't the batch's prefix $((member - 1)) (key ${keys[member - 1]})${bad:+, differing in $(tr "\n" " " <<<"$bad")}, or merging $sha onto it ($( [ -n "$next" ] && echo "key $(key_of "$next")" || echo "a conflict")) isn't prefix $member (key ${keys[member]}): stop the batch"
  fi
}
# weave_main_ok <main sha>: whether a Weave pass's main may stand for main's tip, by check 5's rule: it
# is the tip, or it holds the branch point and main has moved since only in .bracken/ and docs the head
# doesn't touch (finding 76c500f0c75d).
weave_main_ok() {
  local base ours
  [ "$1" != "$tip" ] || return 0
  base=$(git -C "$main" merge-base "$tip" "$sha") || return 1
  ours=$(git -C "$main" diff --no-renames --name-only "$base" "$sha") || return 1
  git -C "$main" merge-base --is-ancestor "$base" "$1" 2>/dev/null &&
    git -C "$main" merge-base --is-ancestor "$1" "$tip" 2>/dev/null && [ -z "$(untested "$1")" ]
}
# Whether <id> is a current manager pass of the whole table, with key <key>, on a pr claim of this PR.
reuses_a_pass() {
  local about target
  about=$(bk show "$1" --json 2>/dev/null) || return 1
  jq -e --arg k "$2" '.kind == "evidence" and .retracted == false and .author_name == "manager"
    and .body.verdict == "pass" and (.body.method | test("^scripts/test-table( --split)? @ [0-9a-f]{40} on [0-9a-f]{40} tree " + $k + "$"))' \
    <<<"$about" >/dev/null || return 1
  target=$(jq -r .body.target <<<"$about")
  bk show "$target" --json 2>/dev/null | jq -e --arg pr "PR #$pr " '(.body.statement // "") | startswith($pr)' >/dev/null
