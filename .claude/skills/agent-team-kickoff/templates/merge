#!/usr/bin/env bash
# merge: the manager's merge step (process section 5, step 8), checked and recorded.
#
#   merge <pr number> <pr claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]
#   merge --batch <batch claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]
#
# Only the manager merges, so it runs only as manager (a dry run defaults to it), and
# triage and deferrals count only when manager wrote them.
#
# Checks, in order, and reports each:
#   1. the pr claim is current (not retracted, and superseded by no one) and starts
#      "PR #<n> <branch> @ <full sha>:";
#   2. under the given policy, `scripts/bk show <claim>` reports it accepted;
#   3. every finding that contradicts the claim has the manager's evidence, and
#      every confirmed one (a pass) is deferred by the manager: a current task tagged deferred,
#      written by the manager, which the manager related depends_on it (process 4.2);
#   4. the GitHub PR is open, targets main, and its head is that sha;
#   scope: a manager pass of scripts/test-table on the sha that bk-evidence labelled docs-only
#      counts only if the head is docs-only by scripts/code-scope (everything it changed since main
#      is *.md outside crates/); one that reuses an earlier pass ('tree <key> reuses <id>') counts
#      only if <id> is a current manager pass of the whole table on a pr claim of the same PR with the
#      same key (owner decision 642a47c04a10). Any other such pass fails this check. Here and in 5,
#      'scripts/test-table --split' (the whole table in a box plus the macOS-only tests on the Mac,
#      owner decision 01a2d668b67e) counts as scripts/test-table; --remote alone doesn't. A light pass
#      ('scripts/test-table --split -p <package>... @ <sha> on <main sha> tree <key>', from
#      scripts/verify-seq --light: decision 464d3ccca45e, answer 10cf8a5053a3) counts as the --on form
#      does in 5, but fails this check unless all of these hold: scripts/code-scope full names no path
#      the head changed since main's tip (its list, the one list of the paths that need the whole
#      table, is the only place they're named); its packages include every one scripts/code-scope packages computes
#      for the head (bracken-scope packages, findings 0095e19fcdb7, 4825c59b07e9); and the pr claim's
#      author has the five passes on the exact sha that verify-seq --light checks first (scripts/code-scope
#      light-passes, finding 013ac6db02d9). It exists only for a merged tree, never for the bare head;
#   5. main's tip is an ancestor of the sha, or every file main changed since the
#      branch point is under .bracken/, or is untouched by the branch and either
#      under docs/ (not docs/vision.md) or a .md file under .claude/skills/ outside
#      any templates/ directory: none of these can change what builds, tests or
#      runs. Renames count as a deletion and an addition. Otherwise, main may be
#      ahead in any path if a manager pass on the claim ran the whole test table on
#      the merge ('scripts/test-table @ <sha> on <main sha>', from bk-evidence --on, with
#      ' tree <key>' and then ' docs-only' or ' reuses <id>' after it as bk-evidence now
#      records them) with a main sha that main's tip has moved past only in those same
#      paths. A light pass counts here too, where the scope check allows it, and so does a Weave pass
#      ('scripts/test-table --weave @ <sha> on <main sha> tree <key> manifest <H>', from verify-seq
#      --weave: line main's Weave results on that merge, plan cc496dcee0e3 step 1b), but the scope
#      check fails unless scripts/weave-gate check agrees, reading everything afresh: the Weave gate
#      on, git's merge with that key, weave verify of it against H, and weave green --manifest H with
#      exactly the results the pass names. A pass of
#      any other command with --on doesn't count: part of the table proves too little;
#   6. scripts/ground-guards passes on the sha against main's tip: no keys or stray
#      files under .bracken/, the Ground append-only, the Ground opens, and
#      docs/vision.md matches it;
#   frozen: what Weave's format freeze guards (docs/design/weave-freeze.md 2.4, G6; decision
#      bae92c497714), as main's scripts/code-scope frozen names it for the head since main's tip. If it
#      names anything, then for each kind of line it prints: a 'frozen:' path needs a current claim
#      tagged owner-review, by manager, not retracted or superseded, whose first line names the pr
#      claim's full id and the head's full sha; an 'owner:' path (a golden vector, a pinned fixture value,
#      tests/fixtures/) also needs the owner's own go (question 3): a current approval the owner ran with
#      scripts/owner-approve, not --delegated, of the pr claim's full id, that owner related supports the
#      claim (the claim names the sha); a 'security:' path (the directories of the freeze's refusals,
#      section 1.8) needs a pass by reviewer, not retracted, on the claim, 'independent review (<model>)
#      @ <sha>'. Each refusal names the paths and what's missing. Only frozen's exit 3 and its one line mean
#      nothing to check; any other exit, or an exit 0 with a line that isn't '<kind>: <path> (<why>)' of
#      those three kinds, fails the check (findings db2dc1c6120e, e3f9ae2b1820);
#   7. with --owner-approval, for a PR whose class needs the owner's go (docs/development.md, Owner
#      approvals): a current claim tagged approval, written by owner (scripts/owner-approve), that owner
#      related supports this pr claim itself, by its full id. An approval of a task, another PR or an
#      earlier head doesn't count (findings 9e8e0c849724, fb07d1777cf6): each head needs its own. A
#      manager-signed quote doesn't count. In v0 keys are shared, so this checks recorded intent, not
#      proof (task ec880b9c2c86).
# A batch pass (scripts/verify-seq --batch, decision db6f7705c0a4) is a manager pass whose method is
# 'scripts/test-table[ --split] @ <sha> batch <batch claim> on <main> tree <key> run <evidence>'. It
# counts only if the batch claim is a current manager claim tagged batch that lists this PR, claim and
# sha with that main and key, and <evidence> is the manager's pass on the batch claim of a commit whose
# key is <key>. In check 5, the plain form accepts it only when this head merged with main's tip is
# exactly the tested tree: the same key, and differing from the tested commit only in .bracken/ and docs
# no member touches (finding 9a3eaf48e2d7). Never a prefix of the batch.
#
# --batch merges a whole batch, all or nothing. It first runs every check for every member, in a dry
# run, with check 5 asking that main's tip differs from the batch's main only in .bracken/ and docs no
# member touches (the same untested() rule as below, and the same key), and that the members merge onto
# it, in order, into the tested tree. If any member fails, it merges none. Then it merges them in the
# tested order, each with every check again and check 5 asking that main's tip is the prefix before it,
# by the same rule, and that the squash merge's tree (git merge-tree) is the next prefix; after each
# merge, including one GitHub made though the call failed (the outcome handling below), it fetches
# main and compares again (finding 3199c8e0a8ad). If anything fails part way, it stops, and says which members
# merged, by their live merge-gate passes: main is then on a prefix nothing tested, and the rest need a
# new run on it. Which member it checks or merges, and how, is state inside this process: merge reads
# none from the environment (finding f692f52a1a43).
#
# If all pass, it records manager evidence "merge gate @ <sha>" on the claim, then
# squash-merges through GitHub's API (PUT pulls/<n>/merge) with sha set to the head, so
# GitHub refuses the merge (409) if the branch moved after the check. If the merge fails and
# GitHub shows the PR still open, it retracts that evidence: a live merge-gate pass
# means the PR merged. If the outcome is unclear, it keeps it and says so. After a merge, it
# deletes the head branch if it is in origin's repository and still at the sha; that is best
# effort, and the merge stands whatever it does. --dry-run runs every check, records nothing,
# and makes only GET requests.
#
# GitHub is reached only through `gh api --hostname <origin's host>`, which authenticates from gh's
# own credential store (gh auth login). merge never reads, holds or passes a token: gh runs with
# GH_TOKEN, GITHUB_TOKEN and the enterprise token variables unset, so a token in the caller's
# environment is never used, and GH_DEBUG unset, so gh logs no HTTP traffic.
# With the team server set up (scripts/team-server), every read pulls from it first, and the
# gate refuses if it can't.
# Needs gh and jq.
set -euo pipefail
# Never trace or auto-export (both can be inherited through SHELLOPTS).
set +ax

usage() {
  echo "usage: merge <pr number> <pr claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]" >&2
  echo "       merge --batch <batch claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]" >&2
  exit 2
}
fail() { echo "merge: $*" >&2; exit 1; }
# Batch state lives in these shell variables, set only by --batch below for the members it checks and
# merges, never from the environment (finding f692f52a1a43); a caller still setting the old variables is
# told so, rather than ignored.
for v in MERGE_BATCH MERGE_BATCH_PRECHECK MERGE_NO_CLEANUP; do
  [ -z "${!v+x}" ] || fail "$v is set in the environment; merge takes no batch state from it: unset it, and use merge --batch"
done
batch_member='' batch_precheck=false no_cleanup=false
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# read_batch <id>: the batch claim, if it is current, the manager's, tagged batch, and well formed. Sets
# b_full, b_main, b_key, b_n and the arrays b_pr, b_claim, b_sha (members in the tested order, from 0);
# otherwise returns 1 with batch_why saying why.
read_batch() {
  local about items item k=0
  about=$(bk show "$1" --json 2>/dev/null) || { batch_why="no contribution $1 in the Ground"; return 1; }
  b_full=$(jq -r .id <<<"$about")
  jq -e '.kind == "claim" and .retracted == false and .author_name == "manager" and (.body.tags | index("batch"))' \
    <<<"$about" >/dev/null || { batch_why="$1 isn't a current manager claim tagged batch"; return 1; }
  bk log --tag batch --current --json | jq -e --arg id "$b_full" \
    'any(.[]; .id == $id and .retracted == false and (.superseded_by_others | length) == 0)' >/dev/null ||
    { batch_why="batch $1 is superseded"; return 1; }
  [[ $(jq -r .body.statement <<<"$about") =~ ^Batch\ of\ ([1-9][0-9]*)\ on\ main\ ([0-9a-f]{40})\ tree\ ([0-9a-f]{40,64}),\ tested\ in\ this\ order:\ (.*)$ ]] ||
    { batch_why="batch $1's statement isn't 'Batch of <n> on main <sha> tree <key>, tested in this order: ...'"; return 1; }
  b_n=${BASH_REMATCH[1]} b_main=${BASH_REMATCH[2]} b_key=${BASH_REMATCH[3]} items=${BASH_REMATCH[4]}
  b_pr=() b_claim=() b_sha=()
  while [ -n "$items" ]; do
    item=${items%%; *}
    [ "$item" = "$items" ] && items='' || items=${items#*; }
    k=$((k + 1))
    [[ $item =~ ^$k\ PR\ \#([1-9][0-9]*)\ ([0-9a-f]{64})\ @\ ([0-9a-f]{40})$ ]] ||
      { batch_why="batch $1's member $k isn't '$k PR #<n> <claim> @ <sha>'"; return 1; }
    b_pr+=("${BASH_REMATCH[1]}") b_claim+=("${BASH_REMATCH[2]}") b_sha+=("${BASH_REMATCH[3]}")
  done
  [ "$k" = "$b_n" ] || { batch_why="batch $1 says $b_n members and lists $k"; return 1; }
}


# merge_one <pr number> <pr claim> <options>: checks one PR and, unless it's a dry run, merges it. Its body
# is the whole plain form, left unindented; --batch runs it in a subshell per member, with batch_member
# (and batch_precheck) set.
merge_one() {
# --batch runs this in a subshell with errexit off around it, so it turns errexit back on: every read
# below that isn't checked otherwise must stop the gate (finding 54a83c918a26).
set -e
[ $# -ge 2 ] || usage
pr=$1
claim=$2
shift 2
[[ $pr =~ ^[1-9][0-9]*$ ]] || fail "'$pr' isn't a PR number"
[[ $claim =~ ^[0-9a-f]{12,64}$ ]] || fail "'$claim' isn't a claim id (12 to 64 hex characters)"
agent=${BRACKEN_AGENT:-}
min_passes=
dry_run=false
owner_approval=false
policy=()
while [ $# -gt 0 ]; do
  case "$1" in
    --validator) [ $# -ge 2 ] || usage; policy+=(--validator "$2"); shift 2 ;;
    --min-passes) [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; min_passes=$2; shift 2 ;;
    --as) [ $# -ge 2 ] || usage; agent=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --owner-approval) owner_approval=true; shift ;;
    *) usage ;;
  esac
done
[ ${#policy[@]} -gt 0 ] && [ -n "$min_passes" ] || fail "give the gate's policy: --validator <id>... --min-passes N (process section 4.2)"
$dry_run || [ -n "$agent" ] || fail "no identity: pass --as manager or set BRACKEN_AGENT"
[ "${agent:-manager}" = manager ] ||
  fail "only the manager merges (process 4.2): run with --as manager, not '$agent' (dry runs too)"
for tool in gh jq; do command -v "$tool" >/dev/null || fail "needs $tool"; done

main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
# With a team server set up, the gate decides only on a replica that has just pulled from it
# (network-sync.md section 5): every read below must pull, with no fallback to the local replica.
# Its own Ground reads are full checks, never through the verified snapshot (docs/cli.md, The verified
# snapshot); only these, never the tests it runs (finding 607273d1d193).
bk() { BK_PULL=required BRACKEN_FULL_CHECK=1 BRACKEN_AGENT=${agent:-manager} "$here/bk" "$@"; }
bk heads >/dev/null || fail "can't pull from the team server, so the gate won't decide on a replica that may be behind"
if [ -f "$main/.bracken-team" ]; then
  echo "team server: every read pulls from $(cat "$(cat "$main/.bracken-team")/url")"
else
  echo "team server: none set up (no .bracken-team); reading the local replica"
fi

origin=$(git -C "$main" config --get remote.origin.url)
# Not printed: an origin URL can carry a password.
[[ $origin =~ ^https://([^/@]+)/([^/]+)/([^/]+)$ ]] ||
  fail "origin's URL isn't https://<host>/<owner>/<repo>, with no user or password in it"
host=${BASH_REMATCH[1]}
repo="${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}"
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "origin's owner and repository aren't plain names"

# gh_ <args>: gh with only its own credential store (see the header), never prompting.
gh_() {
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u GH_DEBUG -u DEBUG \
    -u GH_HOST -u GH_REPO GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh "$@"
}
gh_ auth status --hostname "$host" >/dev/null 2>&1 ||
  fail "gh has no login for $host in its own credential store: run gh auth login --hostname $host"

# api <method> <path> [json body file] [status]: prints the response body, or with "status" only the HTTP
# status (000 if there was no reply), from gh's --include status line; it fails unless the status is 2xx.
# <path> is under repos/<owner>/<repo>. In a dry run, anything but GET is refused here, before any request.
api() {
  local method=$1 path=$2 body=${3:-} status=${4:-} out code rc=0
  [ "$method" = GET ] || ! $dry_run || fail "dry run: refusing $method $path"
  local args=(api --hostname "$host" -X "$method" -H "Accept: application/vnd.github+json"
    -H "X-GitHub-Api-Version: 2022-11-28")
  [ -z "$body" ] || args+=(--input "$body")
  if [ -z "$status" ]; then
    gh_ "${args[@]}" "repos/$repo$path"
    return
  fi
  out=$(gh_ "${args[@]}" --include "repos/$repo$path" 2>/dev/null) || rc=$?
  code=$(sed -n '1s|^HTTP/[0-9.]* \([0-9][0-9][0-9]\).*|\1|p' <<<"$out")
  printf '%s' "${code:-000}"
  [ "$rc" = 0 ] && [[ ${code:-000} == 2?? ]]
}

failed=0
check() { # check <ok|FAIL> <name> <detail>
  printf '%-4s  %-12s %s\n' "$1" "$2" "$3"
  [ "$1" = ok ] || failed=1
}

# 1. The claim.
shown=$(bk show "$claim" "${policy[@]}" --min-passes "$min_passes" --json 2>/dev/null) || fail "no contribution $claim in the Ground"
statement=$(jq -r '.body.statement // empty' <<<"$shown")
full=$(jq -r '.id' <<<"$shown")
[[ $statement =~ ^PR\ \#([0-9]+)\ ([^ ]+)\ @\ ([0-9a-f]{40}): ]] || fail "$claim isn't a pr claim ('PR #<n> <branch> @ <sha>: ...')"
[ "${BASH_REMATCH[1]}" = "$pr" ] || fail "$claim is for PR #${BASH_REMATCH[1]}, not #$pr"
branch=${BASH_REMATCH[2]}
sha=${BASH_REMATCH[3]}
current=$(bk log --tag pr --current --json) || fail "couldn't read the current pr claims"
# log --current keeps a claim someone else superseded, marked; that one isn't current either.
if jq -e --arg id "$full" 'any(.[]; .id == $id and .retracted == false and (.superseded_by_others | length) == 0)' \
  <<<"$current" >/dev/null; then
  check ok claim "$claim is the current pr claim for #$pr: $branch @ $sha"
else
  check FAIL claim "$claim isn't the current pr claim (retracted, or superseded by its author or someone else)"
fi

# 2. The gate.
status=$(jq -r '.assessment.status' <<<"$shown")
passes=$(jq -r '[.assessment.passes[][:12]] | join(" ")' <<<"$shown")
policy_text="${policy[*]} --min-passes $min_passes"
if [ "$status" = accepted ]; then
  check ok gate "accepted under $policy_text (passes: $passes)"
else
  check FAIL gate "$status under $policy_text, not accepted"
fi

# 3. Findings: `bracken findings` is the check, one definition shared with `bracken log --open`
# (task dea48fd16754, docs/cli.md): every contribution with a contradicts relation to the claim that
# isn't retracted and whose link still counts (live, or retracted by someone other than the finding's
# author and the triager), each triaged from the triager's live evidence. Untriaged and confirmed
# findings block; a confirmed one deferred to a current task of the triager's doesn't.
triager=manager
found=$(bk findings "$full" --triager "$triager" --json) ||
  fail "couldn't read the findings against $full, so the findings check can't decide"
# The read's shape first, in one jq: a jq error inside the for lists below would go unnoticed, since
# errexit doesn't cover a command substitution there (finding d9682243cef7). Slurped (-s), so it judges
# the whole output as exactly one document, not just the last of several; and every id and task is 64
# lowercase hex, so none can split away in a for list (finding 6fd12dd898ee): \A and \z, since $ also
# matches before a final newline (b0cec6d917b6).
jq -es 'length == 1 and (.[0] | (.findings | type) == "array" and (.blocking | type) == "number"
  and all(.findings[]; (.id | type) == "string" and (.id | test("\\A[0-9a-f]{64}\\z"))
    and (.triage | IN("untriaged", "confirmed", "deferred", "rejected"))
    and (.triage != "deferred" or ((.task | type) == "string" and (.task | test("\\A[0-9a-f]{64}\\z")))))
  and .blocking == ([.findings[] | select(.triage == "untriaged" or .triage == "confirmed")] | length))' \
  <<<"$found" >/dev/null ||
  fail "bracken findings --json for $full isn't in the shape this check reads, so the findings check can't decide"
findings_count=$(jq '.findings | length' <<<"$found")
untriaged=() undeferred=() deferred=()
for f in $(jq -r '.findings[] | select(.triage == "untriaged") | .id[:12]' <<<"$found"); do untriaged+=("$f"); done
for f in $(jq -r '.findings[] | select(.triage == "confirmed") | .id[:12]' <<<"$found"); do undeferred+=("$f"); done
for f in $(jq -r '.findings[] | select(.triage == "deferred") | "\(.id[:12])->\(.task[:12])"' <<<"$found"); do
  deferred+=("$f")
done
# And what the for lists read agrees with the count, in case anything slipped past the shape check.
[ "$(jq '.blocking' <<<"$found")" -eq $((${#untriaged[@]} + ${#undeferred[@]})) ] ||
  fail "bracken findings' blocking count disagrees with its findings, so the findings check can't decide"
if [ ${#untriaged[@]} -eq 0 ] && [ ${#undeferred[@]} -eq 0 ]; then
  findings_text="$findings_count against the claim, all triaged by $triager; confirmed and deferred: ${deferred[*]:-none}"
  check ok findings "$findings_text"
else
  check FAIL findings "untriaged (no $triager evidence): ${untriaged[*]:-none}; confirmed but not deferred (no current task tagged deferred that $triager wrote and related depends_on it): ${undeferred[*]:-none}"
fi

# 4. The GitHub PR.
info=$(api GET "/pulls/$pr") || fail "couldn't read PR #$pr from $host"
f_head=$(jq -r '.head.sha' <<<"$info")
f_state=$(jq -r 'if .merged then "merged" else .state end' <<<"$info")
f_base=$(jq -r '.base.ref' <<<"$info")
title=$(jq -r '.title' <<<"$info")
# Where the head branch lives, for deleting it after the merge: only a branch of origin's repository.
f_head_repo=$(jq -r '.head.repo.full_name // empty' <<<"$info")
f_head_ref=$(jq -r '.head.ref // empty' <<<"$info")
if [ "$f_state" = open ] && [ "$f_base" = main ] && [ "$f_head" = "$sha" ]; then
  check ok github "PR #$pr is open against main, head $f_head"
else
  check FAIL github "PR #$pr is $f_state against $f_base, head $f_head (the claim says $sha)"
fi

# 5. main.
git -C "$main" fetch -q origin main "refs/pull/$pr/head" || fail "couldn't fetch main and PR #$pr from origin"
tip=$(git -C "$main" rev-parse --verify -q "origin/main^{commit}") || fail "no origin/main"

# The manager's passes of scripts/test-table naming the sha, one '<main sha>\x1f<key>\x1f<suffix>' line
# each, split on the unit separator: a tab is whitespace to read, so an empty main and key would collapse
# and a suffix land in the wrong field, never checked (task 962bd6b61626); the main and key are empty for a pass without --on, the suffix ' docs-only', ' reuses <id>',
# ' light -p <package>...' (a light pass, always with --on), ' weave <manifest> <evidence>' (line main's
# Weave results on the merge, recorded by verify-seq --weave and re-checked below by scripts/weave-gate
# check) or empty.
tables=$(jq -r --arg full "$full" --arg sha "$sha" '[.referrers[] | select(.kind == "evidence"
  and .retracted == false and .author_name == "manager" and .body.target == $full and .body.verdict == "pass")
  | . as $e | .body.method
  | ((capture("^scripts/test-table( --split)? @ (?<h>[0-9a-f]{40})( on (?<m>[0-9a-f]{40})( tree (?<k>[0-9a-f]{40,64}))?)?(?<x> docs-only| reuses [0-9a-f]{64})?$")?)
     // (capture("^scripts/test-table --split(?<p>( -p [A-Za-z0-9][A-Za-z0-9_-]*)+) @ (?<h>[0-9a-f]{40}) on (?<m>[0-9a-f]{40}) tree (?<k>[0-9a-f]{40,64})$")?
         | .x = " light" + .p)
     // (capture("^scripts/test-table --weave @ (?<h>[0-9a-f]{40}) on (?<m>[0-9a-f]{40}) tree (?<k>[0-9a-f]{40,64}) manifest (?<w>blake3:[0-9a-f]{64})$")?
         | .x = " weave " + .w + " " + $e.id))
  | select(.h == $sha) | [.m // "", .k // "", .x // ""] | join("\u001f")] | unique | .[]' <<<"$shown")
# The manager's batch passes naming the sha, one '<batch>\t<main>\t<key>\t<run>' line each.
batch_passes=$(jq -r --arg full "$full" --arg sha "$sha" '[.referrers[] | select(.kind == "evidence"
  and .retracted == false and .author_name == "manager" and .body.target == $full and .body.verdict == "pass")
  | .body.method | capture("^scripts/test-table( --split)? @ (?<h>[0-9a-f]{40}) batch (?<b>[0-9a-f]{64}) on (?<m>[0-9a-f]{40}) tree (?<k>[0-9a-f]{40,64}) run (?<e>[0-9a-f]{64})$")?
  | select(.h == $sha) | [.b, .m, .k, .e] | @tsv] | unique | .[]' <<<"$shown")
# batch_pass_ok <batch> <main> <key> <run>: whether a batch pass counts (see the header). Sets member to
# this PR's place in the batch, from 1, and leaves read_batch's b_* set.
batch_pass_ok() {
  local about c j
  read_batch "$1" || return 1
  [ "$b_main" = "$2" ] && [ "$b_key" = "$3" ] || return 1
  member=''
  for ((j = 0; j < b_n; j++)); do
