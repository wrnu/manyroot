key_of() { (cd "$main" && "$here/code-scope" key "$1" 2>/dev/null); }
# untested <from> [<to>]: what changed from <from> to <to> (main's tip by default) that can change what
# builds, tests or runs. Docs and skill .md files count only where $ours, the paths the head (or the
# batch's members) changed, lists them; docs/vision.md and skill templates always count.
untested() {
  local changed
  # A diff that fails says so as a line of its own, so it counts as untested, never as nothing.
  changed=$(git -C "$main" diff --no-renames --name-only "$1" "${2:-$tip}") ||
    { echo "(git diff $1 ${2:-$tip} failed)"; return; }
  printf '%s\n' "$changed" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      .bracken/*) ;;
      docs/vision.md) echo "$f" ;;
      .claude/skills/templates/* | .claude/skills/*/templates/*) echo "$f" ;;
      docs/* | .claude/skills/*.md) ! grep -qxF -- "$f" <<<"$ours" || echo "$f" ;;
      *) echo "$f" ;;
    esac
  done
}
# batch_ours: sets ours to every path a member of the batch read_batch last read changed since its main.
batch_ours() {
  local h base paths all=''
  for h in "${b_sha[@]}"; do
    base=$(git -C "$main" merge-base "$b_main" "$h") || return 1
    paths=$(git -C "$main" diff --no-renames --name-only "$base" "$h") || return 1
    all=$(printf '%s\n%s' "$all" "$paths")
  done
  ours=$(sort -u <<<"$all")
