# merged_commit <onto> <head>...: <onto> merged with the heads in order (code-scope chain); empty on a conflict.
merged_commit() { (cd "$main" && "$here/code-scope" chain "$@" 2>/dev/null | tail -n 1 | cut -d' ' -f2); }
# merged_key <onto> <head>...: the key of <onto> merged with the heads in order; empty if they don't merge.
merged_key() { (cd "$main" && "$here/code-scope" chain "$@" 2>/dev/null | tail -n 1 | cut -d' ' -f3); }
