        # packages (code-scope packages), read as verify-seq --light reads them.
        [ -n "$needs_full" ] || needs_full=$(cd "$main" && "$here/code-scope" full "$tip" "$sha" 2>&1; echo "exit $?")
        case "${needs_full##*exit }" in
          1) ;;
          0) wrong+=("a light pass on main $m, but the head needs the whole table: $(sed '$d; s/^code-scope: full: //' <<<"$needs_full" | tr '\n' ' ' | sed 's/ $//')") ;;
          *) wrong+=("a light pass on main $m, and code-scope full failed: $(sed '$d' <<<"$needs_full" | tr '\n' ' ')") ;;
        esac
        [ -n "$light_packages" ] || light_packages=$(cd "$main" && "$here/code-scope" packages "$tip" "$sha" 2>&1; echo "exit $?")
        if [ "${light_packages##*exit }" != 0 ]; then
          wrong+=("a light pass on main $m, and code-scope packages failed: $(sed '$d' <<<"$light_packages" | tr '\n' ' ')")
        elif [ "$light_packages" = "exit 0" ]; then
          wrong+=("a light pass on main $m, but the head has no package to test")
        else
          lacks=()
          while IFS= read -r p; do
            [[ "$x " == *" -p $p "* ]] || lacks+=("$p")
          done < <(sed '$d' <<<"$light_packages")
          [ ${#lacks[@]} -eq 0 ] || wrong+=("a light pass on main $m that leaves out ${lacks[*]}, which the head's changes need")
          # The pr claim's author's five passes on the exact sha, verify-seq --light's precondition.
          if [ -z "$light_passes" ]; then
            # shellcheck disable=SC2046 # one package name a word
            light_passes=$(jq -r --arg full "$full" '.author_name as $a | [.referrers[] | select(.kind == "evidence"
              and .retracted == false and .author_name == $a and .body.target == $full and .body.verdict == "pass")
              | .body.method] | .[]' <<<"$shown" | "$here/code-scope" light-passes "$sha" $(sed '$d' <<<"$light_packages") 2>&1; echo "exit $?")
