#!/usr/bin/env bash
# ci-result: a head's GitHub Actions result (.github/workflows/ci.yml), read through gh, as a check that
# bk-evidence can record on its pr claim (task 87d7f62409b0), so the manager can compare it with the
# counted run. It records nothing itself and changes nothing on GitHub: only GET requests.
#
#   ci-result [--event pull_request|push] [<sha>]
#   ci-result --record <pr claim> [--as <identity>] [--event pull_request|push]
#
# For <sha> (HEAD by default), it finds ci.yml's runs on origin's GitHub repository whose head is that
# sha, takes the latest of the given event, or by default the latest pull_request run (it tests the head
# merged with main, as the counted run does) or, with none, the latest push run (the head alone). It
# prints the run's URL, event, attempt, the PR's base for a pull_request run, and each job's conclusion.
# Only origin's own runs count (finding 6ef8d93b7020): a run whose head repository is another (a fork's
# pull request of the same commit, which anyone can open on a public repository) is never read, and a
# pull_request run counts only if its PR targets main. After the PR is closed, as once it has merged,
# GitHub lists no PR on the run, and the PR is read from the repository's pull requests, by the run's
# branch and the sha. It also says what Actions leaves out, which only
# the counted run checks (finding a5b068929177).
# A job GitHub cancelled with no runner and no steps (one left in the queue until it timed out, note
# 3be490258b13) never ran: it's reported as 'not run', neither a pass nor a fail.
# It exits 0 only if the run completed, its conclusion is success and so is every job's; 1 if it
# completed otherwise, with at least one job that ran and didn't pass (or no jobs at all); 4 if every job
# passed but one or more weren't run (re-run them: gh run rerun <id> --failed); 3 if it hasn't completed
# (run it again later); 2 if there's no such run, or it can't read one.
#
# --record runs the main checkout's bk-evidence on <pr claim> with this script as the command, from a
# clean checkout at the claim's head: the evidence is "scripts/ci-result @ <sha>", with this output and
# exit code. A run that hasn't completed records a fail, so wait for it to complete first. A run with a
# job not run records nothing: it reads the run first and, on exit 4, says so and exits 4, since there's
# no result to compare with the counted run.
#
# gh authenticates from its own credential store (gh auth login), with GH_TOKEN, GITHUB_TOKEN, the
# enterprise token variables and GH_DEBUG unset for it, as in scripts/merge. Needs gh and jq.
set -euo pipefail
set +ax

fail() { echo "ci-result: $*" >&2; exit 2; }
usage() {
  echo "usage: ci-result [--event pull_request|push] [<sha>]" >&2
  echo "       ci-result --record <pr claim> [--as <identity>] [--event pull_request|push]" >&2
  exit 2
}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

event='' sha='' record='' as=''
while [ $# -gt 0 ]; do
  case "$1" in
    --event) [ $# -ge 2 ] && [[ $2 =~ ^(pull_request|push)$ ]] || usage; event=$2; shift 2 ;;
    --record) [ $# -ge 2 ] && [[ $2 =~ ^[0-9a-f]{12,64}$ ]] || usage; record=$2; shift 2 ;;
    --as) [ $# -ge 2 ] || usage; as=$2; shift 2 ;;
    -*) usage ;;
    *) [ -z "$sha" ] || usage; sha=$1; shift ;;
  esac
done

if [ -n "$record" ]; then
  [ -z "$sha" ] || fail "--record takes the sha from the claim's checkout: give no <sha>"
  main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  cd "$(git rev-parse --show-toplevel)"
  args=("$record")
  [ -z "$as" ] || args+=(--as "$as")
  # A job not run isn't a result: read the run first, and record nothing for one.
  code=0
  "$here/ci-result" ${event:+--event "$event"} >/dev/null 2>&1 || code=$?
  if [ "$code" -eq 4 ]; then
    "$here/ci-result" ${event:+--event "$event"} || true
    echo "ci-result: a job wasn't run, so there's no result to record; nothing was recorded on $record" >&2
    exit 4
  fi
  exec "$main/scripts/bk-evidence" "${args[@]}" -- scripts/ci-result ${event:+--event "$event"}
fi
[ -z "$as" ] || usage

for tool in gh jq; do command -v "$tool" >/dev/null || fail "needs $tool"; done
[ -n "$sha" ] || sha=$(git rev-parse HEAD)
[[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "'$sha' isn't a full commit sha"

origin=$(git -C "$here" config --get remote.origin.url) || fail "no origin"
[[ $origin =~ ^https://([^/@]+)/([^/]+)/([^/]+)$ ]] ||
  fail "origin's URL isn't https://<host>/<owner>/<repo>, with no user or password in it"
host=${BASH_REMATCH[1]}
repo="${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}"
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "origin's owner and repository aren't plain names"

gh_() {
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u GH_DEBUG -u DEBUG \
    -u GH_HOST -u GH_REPO GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh "$@"
}
get() { gh_ api --hostname "$host" -X GET -H "Accept: application/vnd.github+json" "repos/$repo/$1"; }

runs=$(get "actions/workflows/ci.yml/runs?head_sha=$sha&per_page=100") ||
  fail "couldn't read ci.yml's runs for $sha from $host (is gh logged in? gh auth login --hostname $host)"
# Origin's own runs of the sha: a fork's are never read, nor looked up below.
own=$(jq -ce --arg sha "$sha" --arg repo "$repo" '[.workflow_runs[]
  | select(.head_sha == $sha and (.head_repository.full_name // "" | ascii_downcase) == ($repo | ascii_downcase))]' \
  <<<"$runs") || fail "couldn't read ci.yml's runs for $sha: not the JSON GitHub sends"
# Once its PR is closed (merged, as every head is after scripts/merge), GitHub lists no PR on a
# pull_request run: its pull_requests array is empty (note 415d217b1015). Its PR is then read from the
# repository's pull requests, by the run's branch: those whose head is origin's branch at this sha. The
# run counts below only if there's one at least and all of them target main, as for a listed PR.
found='{}'
while IFS= read -r branch; do
  q=$(jq -rn --arg owner "${repo%%/*}" --arg branch "$branch" '"\($owner):\($branch | @uri)"')
  found=$(get "pulls?state=all&head=$q&per_page=100" |
    jq -ce --arg branch "$branch" --arg sha "$sha" --arg repo "$repo" --argjson found "$found" \
      '$found + {($branch): [.[] | select(.head.sha == $sha and .head.ref == $branch
        and (.head.repo.full_name // "" | ascii_downcase) == ($repo | ascii_downcase))]}') ||
    fail "couldn't read $repo's pull requests from $branch, to find the base of a pull_request run whose PR is closed"
done < <(jq -r '[.[] | select(.event == "pull_request" and (.pull_requests | length) == 0)
  | .head_branch // empty] | unique[]' <<<"$own")
# The latest run of the event, by id, among those (and for pull_request, those whose PR targets main);
# with no event given, pull_request first, then push.
run=$(jq -ce --arg event "$event" --argjson found "$found" 'map(
    if .event == "pull_request" and (.pull_requests | length) == 0
    then .pull_requests = ($found[.head_branch // ""] // []) | .closed_pr = true else . end
    | select(.event != "pull_request" or (.pull_requests | length) > 0 and all(.pull_requests[]; .base.ref == "main"))) as $r
  | (if $event != "" then [$event] else ["pull_request", "push"] end)
  | map(. as $e | [$r[] | select(.event == $e)] | max_by(.id)) | map(select(. != null)) | first' <<<"$own") ||
  fail "no ci.yml run on $repo for $sha${event:+ ($event)}: push the head, or start one with gh workflow run ci.yml --ref <branch>"
id=$(jq -r .id <<<"$run")
[[ $id =~ ^[0-9]+$ ]] || fail "a run without a numeric id"
status=$(jq -r .status <<<"$run")
conclusion=$(jq -r '.conclusion // "none"' <<<"$run")
echo "ci-result: $(jq -r .html_url <<<"$run")"
echo "ci-result: run $id, $(jq -r .event <<<"$run") on $sha, attempt $(jq -r .run_attempt <<<"$run"): $status, $conclusion"
if [ "$(jq -r .closed_pr <<<"$run")" = true ]; then
  echo "ci-result: pull_request run: the head merged with main, for $(jq -r '[.pull_requests[] | "PR #\(.number) (\(.state))"] | join(", ")' <<<"$run"); GitHub no longer lists the PR on the run, so its base is read from the PR, and the commit of main it merged with isn't shown"
elif [ "$(jq -r .event <<<"$run")" = pull_request ]; then
  echo "ci-result: pull_request run: the head merged with $(jq -r '.pull_requests[0].base | "\(.ref) at \(.sha)"' <<<"$run") as of the run"
fi
echo "ci-result: Actions leaves out what only the counted run checks: the Docker-backed macos_only tests (the macOS job has no Docker and lists them as skipped), and --split's check that every test runs on Linux or the Mac"
if [ "$status" != completed ]; then
  echo "ci-result: run $id hasn't completed; run ci-result again when it has" >&2
  exit 3
fi
jobs=$(get "actions/runs/$id/jobs?per_page=100") || fail "couldn't read run $id's jobs"
# A job not run: cancelled, with no runner and no steps (GitHub never started it).
not_run='def not_run: .conclusion == "cancelled" and (.runner_name // "") == "" and ((.steps // []) | length) == 0;'
jq -r "$not_run"' .jobs[] | "ci-result: job \(.name): \(if not_run
  then "not run (cancelled with no runner and no steps: GitHub never started it)" else .conclusion // .status end)"' <<<"$jobs"
if [ "$conclusion" = success ] &&
  jq -e '(.jobs | length) > 0 and all(.jobs[]; .conclusion == "success")' <<<"$jobs" >/dev/null; then
  echo "ci-result: passed at $sha"
  exit 0
fi
# Every job passed or wasn't run, and one wasn't: not run, neither a pass nor a fail.
if jq -e "$not_run"' any(.jobs[]; not_run) and all(.jobs[]; .conclusion == "success" or not_run)' <<<"$jobs" >/dev/null; then
  skipped=$(jq -r "$not_run"' [.jobs[] | select(not_run) | .name] | join(", ")' <<<"$jobs")
  echo "ci-result: not run at $sha: $skipped never got a runner, so this is neither a pass nor a fail; re-run with gh run rerun $id --failed" >&2
  exit 4
fi
echo "ci-result: failed at $sha ($conclusion)" >&2
exit 1
