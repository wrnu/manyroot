#!/usr/bin/env bash
# weave-shadow: Weave dogfood, the shadow: stage 1, and stage 2a's merges of builders' proposals
# (docs/design/weave.md, section 6 rows 9 and 10a; docs/development.md, Weave shadow; task 87a1bcba025d). Everything goes through scripts/weave, so it opens only the Weave Ground,
# ~/bracken-weave/manyroot, with every check scripts/weave makes.
#
#   scripts/weave-shadow --init --owner-decision <id>
#       Once, after the owner's go to create the Weave Ground: weave init (the marker and line main, by
#       weave-integrator), the validator identity weave-runner, and line main's policy: integrator
#       weave-integrator, validator weave-runner, checks fmt and clippy. <id> is the owner's go: a claim
#       tagged approval and signed by owner (scripts/owner-approve), in the coordination Ground. Run again
#       after it stopped part way, it finishes the steps not yet done; once the Ground is set up, it
#       refuses. As scripts/weave does, it refuses if ~/bracken-weave doesn't exist: creating it is the
#       owner's go.
#
#   scripts/weave-shadow [--repo <dir>] [--proposal <id>]... [--mismatched] <merged commit>
#       After each merge to main, one merge at a time, in order: records the commit as a decision on line
#       main by weave-integrator, whose parent is the line's head, the previous decision, and checks it
#       with weave verify against the commit. Exits non-zero on any difference. Before writing anything it
#       refuses a commit that isn't on origin/main, or that doesn't come after the commit line main's head
#       records (older, or unrelated). Run again for that recorded commit, it records nothing and verifies
#       it again. <dir> is the git repository (the default is the main checkout).
#       The commit brings in one PR's squash, or with a merge commit, the squashes on its second parent's
#       line down to its first parent: a batch, oldest first, each subject ending (#N). With a --proposal
#       for each (scripts/weave-propose; each pr claim names it), Weave merges them itself, in that order,
#       into one decision: weave integrate --proposals <ids> --mirrors <commit>, which writes the merge only
#       if it comes out as the commit's tree. Each proposal must be of a PR the commit brings in, and of the
#       head that merged: the one named by the PR's pr claim carrying the manager's merge gate pass, pulled
#       from the team server first, and by that claim's author. Its base must be where weave-propose puts
#       it. That needs the head to mirror the commit's first parent (outside
#       .bracken/, which Weave leaves out), so merges are shadowed one at a time. Then:
#         - a per-file conflict falls back to importing the commit's tree, with the conflicting paths in
#           the decision's note;
#         - a merge that differs from git's stops it, writing nothing: report it. To go on, run it again
#           with --mismatched, which checks the merge still differs and imports the commit's tree, with the
#           differing paths in the note;
#         - but where Weave's tree is exactly git's with each differing path brought back by a proposal
#           based on an ancestor of its PR's merge-base (scripts/weave-propose's fallback, when the shadow
#           hadn't recorded the merge-base: a squash merge), from a commit since undone, and in a batch no
#           other proposal changed that path but to bring the same back, it isn't Weave's merge that is
#           wrong: the commit's tree is imported, noted as from an ancestor base, and counted apart from
#           mismatches;
#         - with no --proposal, or none for one of the PRs, the commit's tree is imported, noted as having
#           no proposal (and for which PRs).
#       Every decision's note says which, and each run ends by counting them on line main since stage 2a
#       began.
#
# Every run but --init first checks the committed pin, .config/weave-root on main (scripts/weave-pin
# check), and refuses unless the Weave Ground and its replica's root match it.
#
# "Line main" is always the default line: the line named main whose first version the counted marker's
# author, the Ground's root, weave-integrator, wrote. Anyone can write another line named main, which never becomes the default, so
# this script never names line main by name, where such a line would make it ambiguous (finding
# b5b5871cc017). It gives no --line, or the default line's id.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
  echo "weave-shadow: $here is not inside a git repository" >&2
  exit 1
}
main=$(dirname "$common")
weave="$here/weave"
fail() { echo "weave-shadow: $*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p;}' "${BASH_SOURCE[0]}"; }

init='' owner='' repo=$main rev='' proposals=() mismatched=''
while [ $# -gt 0 ]; do
  case "$1" in
    --init) init=1 ;;
    --proposal) [ $# -ge 2 ] || fail "--proposal needs an id"; proposals+=("$2"); shift ;;
    --proposal=*) proposals+=("${1#*=}") ;;
    --mismatched) mismatched=1 ;;
    --owner-decision) [ $# -ge 2 ] || fail "--owner-decision needs an id"; owner=$2; shift ;;
    --owner-decision=*) owner=${1#*=} ;;
    --repo) [ $# -ge 2 ] || fail "--repo needs a directory"; repo=$2; shift ;;
    --repo=*) repo=${1#*=} ;;
    -h | --help) usage; exit 0 ;;
    -*) fail "unknown option $1; see --help" ;;
    *) [ -z "$rev" ] || fail "one commit at a time"; rev=$1 ;;
  esac
  shift
done

if [ -n "$init" ]; then
  [ -z "$rev" ] || fail "--init takes no commit"
  [ -n "$owner" ] ||
    fail "--init needs --owner-decision <id>: the owner's go to create the Weave Ground, an approval scripts/owner-approve wrote"
  # The owner's go is checked before anything is created: a claim tagged approval, signed by owner and not
  # retracted, as scripts/owner-approve writes it. A plain decision claim isn't the owner's go.
  [[ $owner =~ ^[0-9a-f]{12,64}$ ]] || fail "--owner-decision $owner: give the approval's id, 12 to 64 lowercase hex digits"
  shown=$(env -u BRACKEN_AGENT "$main/scripts/bk" show "$owner" --json 2>/dev/null) ||
    fail "--owner-decision $owner: the coordination Ground has no such contribution"
  jq -e '. as $c | .kind == "claim" and (.retracted | not) and .author_name == "owner"
         and ((.body.tags // []) | index("approval") != null)
         and ([.referrers[]? | select(.kind == "relation" and .body.kind == "supersedes" and .body.to == $c.id
                                and .author == $c.author and (.retracted | not))] | length) == 0' <<<"$shown" >/dev/null 2>&1 ||
    fail "--owner-decision $owner: it isn't a claim tagged approval, signed by owner, not retracted and not superseded (scripts/owner-approve)"
  path="${HOME:?HOME is not set}/bracken-weave/manyroot"
  policy=(--integrator weave-integrator --validator weave-runner
    --check 'fmt=cargo fmt --check' --check 'clippy=cargo clippy --all-targets -- -D warnings'
    --owner-decision "$owner" --as weave-integrator)
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    "$weave" weave init --as weave-integrator --purpose dogfood
  else
    # A Ground already there is finished, not created again: --init may have stopped part way, and nothing
    # under ~/bracken-weave is ever edited by hand. It must be one this script started: weave-integrator signs
    # here.
    ids=$("$weave" id list --json) || fail "$path isn't a Ground this script can open"
    jq -e 'any(.[]; .name == "weave-integrator" and .can_sign)' <<<"$ids" >/dev/null ||
      fail "$path holds no weave-integrator key, so --init didn't start it; it won't touch it"
    echo "resuming --init in $path"
  fi
  # Each step only if it isn't done yet. weave-runner first, so a line written below can name it.
  ids=$("$weave" id list --json)
  jq -e 'any(.[]; .name == "weave-runner")' <<<"$ids" >/dev/null || "$weave" id new weave-runner
  # line main's current policy, as a dry run that changes nothing shows it; no line if weave init stopped
  # after its marker, before writing the line. The line by its id, never by its name. Only with no default
  # line is line main created: a dry run that fails stops here with its error, rather than write a second
  # line main (finding b33d60c94e6d).
  # Only weave head's own "no default line" error means there is none (finding b9e95bfb20fc); any other
  # failure stops --init with its error.
  err=$(mktemp)
  if head=$("$weave" weave head --json 2>"$err"); then
    line=$(jq -r '.line // empty' <<<"$head")
    [ -n "$line" ] || { rm -f -- "$err"; fail "weave head printed no line"; }
  elif grep -q 'has no default line' "$err"; then
    line=''
  else
    cat -- "$err" >&2
    rm -f -- "$err"
    fail "weave head failed, so --init stops and writes nothing"
  fi
  rm -f -- "$err"
  if [ -z "$line" ]; then
    "$weave" weave line create main "${policy[@]}"
  else
    shown=$("$weave" weave line policy "$line" --dry-run --json --owner-decision "$owner" --as weave-integrator) ||
      fail "can't read line main's policy ($line), so --init stops and writes nothing"
    runner=$(jq -r '.[] | select(.name == "weave-runner") | .agent' <<<"$("$weave" id list --json)")
    jq -e --arg r "$runner" '(.validators | index($r) != null) and .checks.fmt != null and .checks.clippy != null' \
      <<<"$shown" >/dev/null && fail "the Weave Ground $path is already set up; --init has nothing to do"
    "$weave" weave line policy "$line" "${policy[@]}"
  fi
  exit 0
fi

[ -n "$rev" ] || fail "which merged commit? see --help"
[ -z "$owner" ] || fail "--owner-decision goes with --init"
[ -z "$mismatched" ] || [ ${#proposals[@]} -gt 0 ] || fail "--mismatched goes with the proposals that mismatched"
sha=$(git -C "$repo" rev-parse -q --verify "$rev^{commit}") || fail "$rev isn't a commit in $repo"

# Only merged commits, in order, before anything is written (finding 93dea3dd7ec2): the commit must be on
# origin/main, and it must be the commit line main's head records, or descend from it. The ref's full name:
# git takes a local branch or tag called origin/main before the remote-tracking ref (finding 7315c1ccfaf4).
git -C "$repo" rev-parse -q --verify refs/remotes/origin/main >/dev/null ||
  fail "$repo has no refs/remotes/origin/main to check $sha against"
git -C "$repo" merge-base --is-ancestor "$sha" refs/remotes/origin/main ||
  fail "$sha isn't on refs/remotes/origin/main: only merged commits are shadowed"
# The committed pin (docs/design/weave-marker.md, option A): the Weave Ground's id and its replica's root
# must be .config/weave-root's on main, before the Weave Ground is read or written. No exception here: until the
# replica's root is set (rollout step 2, scripts/weave weave root set), every shadow run refuses.
pinned=$("$here/weave-pin" check 2>&1) || fail "refused: ${pinned##*weave-pin: }"
head=$("$weave" weave head --json)
[ "$(jq -r '.forked' <<<"$head")" = false ] || fail "line main is forked; settle it before shadowing more commits"
decision=$(jq -r '.heads[0].decision // empty' <<<"$head")
recorded=''
if [ -n "$decision" ]; then
  log=$("$weave" weave log --limit 1 --json)
  [ "$(jq -r '.decisions[0].decision' <<<"$log")" = "$decision" ] || fail "line main's newest decision isn't its head"
  recorded=$(jq -r '.decisions[0].source.git // empty' <<<"$log")
  [ -n "$recorded" ] || fail "line main's head $decision names no git commit, so the next commit can't be checked against it"
  [[ $recorded =~ ^[0-9a-f]{40}$ ]] || fail "line main's head $decision names '$recorded', which isn't a full git commit id"
fi
# The commit weave-propose bases a proposal on: the nearest first-parent ancestor of merge-base $1, itself
# included, that a decision on line main written by the proposal's time $2 (ms) mirrors.
nearest() {
  local c d t
  [[ $2 =~ ^[0-9]+$ ]] || return 0
  for c in $(git -C "$repo" rev-list --first-parent --max-count 1000 "$1"); do
    for d in $(awk -v c="$c" '$2 == c { print $1 }' <<<"$mirrored"); do
      t=$("$weave" show "$d" --json 2>/dev/null | jq -r '.timestamp_ms // empty') || t=''
      [[ $t =~ ^[0-9]+$ ]] && [ "$t" -le "$2" ] && { echo "$c"; return 0; }
    done
  done
}
# A path's tree entry in commit $1, '<mode> <type> <object>', or nothing.
entry() { git --literal-pathspecs -C "$repo" ls-tree --full-tree "$1" -- "$2" | cut -f1; }
# Whether Weave's merge ($out's .manifest, differing from git's $sha at $out's paths) is exactly git's tree
# with each differing path brought back from an ancestor base (finding 1553d7b4898a). A path p is brought
# back by a proposal based on commit F, of PR head H with merge-base B, only if the commits between F and B
# changed it (F:p != B:p), line main's head still holds it as F did ($sha^1:p == F:p), so a correct merge
# takes the PR's side, and git's merge doesn't (H:p != $sha:p). In a batch, every other proposal must leave
# p as its own base had it, or bring the same p back itself: one that changed p otherwise has a side Weave's
# merge could have dropped there (finding 4dd7841ae9c7). Weave's tree must then be $sha's with H:p at every
# such p: the shadow builds that tree and compares its manifest with Weave's.
resurrected() {
  local p a f b h e j fj bj hj mode type object idx tree expected want
  idx=$(mktemp -d)
  GIT_INDEX_FILE=$idx/index git -C "$repo" read-tree "$sha"
  while IFS= read -r p; do
    e=''
    for a in "${ancestral[@]}"; do
      read -r f b h <<<"$a"
      [ "$(entry "$f" "$p")" != "$(entry "$b" "$p")" ] && [ "$(entry "$sha^1" "$p")" = "$(entry "$f" "$p")" ] &&
        [ "$(entry "$h" "$p")" != "$(entry "$sha" "$p")" ] || continue
      e=$(entry "$h" "$p") || e=''
      [ -n "$e" ] || e=deleted
      break
    done
    [ -n "$e" ] || { rm -rf -- "$idx"; return 1; }
    for j in ${members[@]+"${members[@]}"}; do
      read -r fj bj hj <<<"$j"
      [ "$hj" != "$h" ] || continue
      [ "$(entry "$hj" "$p")" = "$(entry "$fj" "$p")" ] && continue
      [ "$(entry "$fj" "$p")" != "$(entry "$bj" "$p")" ] && [ "$(entry "$sha^1" "$p")" = "$(entry "$fj" "$p")" ] &&
        [ "$(entry "$hj" "$p")" = "$(entry "$h" "$p")" ] && continue
      rm -rf -- "$idx"
      return 1
    done
    if [ "$e" = deleted ]; then
      GIT_INDEX_FILE=$idx/index git --literal-pathspecs -C "$repo" update-index --force-remove -- "$p"
    else
      read -r mode type object <<<"$e"
      [ "$type" = blob ] || { rm -rf -- "$idx"; return 1; }
      GIT_INDEX_FILE=$idx/index git -C "$repo" update-index --add --cacheinfo "$mode,$object,$p"
    fi
  done < <(jq -r '.differs[].path' <<<"$out")
  tree=$(GIT_INDEX_FILE=$idx/index git -C "$repo" write-tree)
  rm -rf -- "$idx"
  expected=$(git -C "$repo" -c user.name=weave-shadow -c user.email=weave-shadow@localhost \
    commit-tree "$tree" -p "$sha" -m "weave-shadow: $sha with what an ancestor base brings back")
  want=$("$weave" weave import --from-git "$expected" --repo "$repo" --dry-run --json 2>/dev/null | jq -r '.manifest // empty') ||
    return 1
  [ -n "$want" ] && [ "$want" = "$(jq -r '.manifest // empty' <<<"$out")" ]
}
if [ -n "$recorded" ] && [ "$sha" = "$recorded" ]; then
  echo "decision $decision (already recorded for $sha)"
else
  if [ -n "$recorded" ]; then
    git -C "$repo" merge-base --is-ancestor "$recorded" "$sha" ||
      fail "$sha doesn't come after $recorded, the commit line main's head records: an older or unrelated commit"
  fi
  # The PRs the merge brings in, oldest first: a merge commit's second-parent line down to its first
  # parent (a batch of squashes, or one), or a squash straight onto main. Each squash's subject ends (#N).
  if git -C "$repo" rev-parse -q --verify "$sha^2" >/dev/null; then
    squashes=$(git -C "$repo" rev-list --reverse --first-parent "$sha^2" "^$sha^1")
  else
    squashes=$sha
  fi
  # Each PR's proposal, as "<n>=<id>" (no associative arrays: macOS's bash is 3.2).
  prs=() got=() ancestral=() members=()
  of_pr() { local e; for e in ${got[@]+"${got[@]}"}; do [ "${e%%=*}" != "$1" ] || { echo "${e#*=}"; return; }; done; }
  for c in $squashes; do
    subject=$(git -C "$repo" log -1 --format=%s "$c")
    if [[ $subject =~ \(#([0-9]+)\)$ ]]; then
      prs+=("${BASH_REMATCH[1]}")
    elif [ ${#proposals[@]} -gt 0 ]; then
      fail "$c ('$subject') brings in no PR: its subject doesn't end with (#N)"
    fi
  done
  if [ ${#proposals[@]} -gt 0 ]; then
    # Weave's merge of the proposals stands for git's merge only onto the same tree: the head must mirror
    # the commit's first parent, outside .bracken/.
    [ -n "$recorded" ] || fail "line main has no decision yet, so there's nothing to merge the proposals onto"
    git -C "$repo" diff --quiet "$recorded" "$sha^1" -- . ':(exclude).bracken' ||
      fail "line main's head mirrors $recorded, not $sha's first parent: shadow the merges in order, one at a time"
    # Each proposal is of a PR this merge brings in, and of the head that merged: the one named by the PR's
    # pr claim that carries the manager's live 'merge gate @ <head>' pass (scripts/merge; a pass, not a
    # failed gate: task 0a58850fa794), and by that claim's
    # author (findings 1f66448c728d, f168bd561a98, c40a5a70c5de). The claims are pulled from the team server
    # first, as the manager, or it fails: the last ones may not be in the main checkout's replica yet.
    coord() { BK_PULL=required BRACKEN_AGENT=manager "$main/scripts/bk" "$@"; }
    claims=$(coord log --tag pr --current --json) || fail "can't read the pr claims in the coordination Ground"
    mirrored=$("$weave" weave log --limit 100000 --json |
      jq -r '.decisions[] | select(.source.git != null) | "\(.decision) \(.source.git)"')
    for p in "${proposals[@]}"; do
      shown=$("$weave" weave review --proposal "$p" --json 2>/dev/null) || shown='{}'
      summary=$(jq -r '.proposals[0].summary // empty' <<<"$shown" 2>/dev/null) || summary=''
      [[ $summary =~ ^PR\ \#([0-9]+)\ [^\ ]+\ @\ ([0-9a-f]{40})$ ]] ||
        fail "proposal $p isn't one scripts/weave-propose wrote: its summary is '$summary'"
      n=${BASH_REMATCH[1]} head_sha=${BASH_REMATCH[2]}
      [[ " ${prs[*]-} " == *" $n "* ]] || fail "proposal $p is of PR #$n, which $sha doesn't bring in"
      [ -z "$(of_pr "$n")" ] || fail "proposals $(of_pr "$n") and $p are both of PR #$n"
      record=$("$weave" show "$p" --json 2>/dev/null) || record='{}'
      author=$(jq -r '.author_name // empty' <<<"$record")
      [ -n "$author" ] || fail "can't read who wrote proposal $p"
      gated='' merged_head='' by=''
      for id in $(jq -r --arg n "PR #$n " '[.[] | select(.body.statement // "" | startswith($n))] | reverse | .[].id' <<<"$claims"); do
        claim=$(coord show "$id" --json) || fail "can't read pr claim $id in the coordination Ground"
        c=$(jq -r '.body.statement // "" | capture("@ (?<sha>[0-9a-f]{40})").sha // empty' <<<"$claim")
        [ -n "$c" ] && jq -e --arg sha "$c" 'any(.referrers[]?; .kind == "evidence" and .retracted == false
          and .author_name == "manager" and .body.verdict == "pass" and .body.method == "merge gate @ " + $sha)' \
          <<<"$claim" >/dev/null || continue
        gated=$id merged_head=$c by=$(jq -r '.author_name // empty' <<<"$claim")
        break
      done
      [ -n "$gated" ] ||
        fail "no current pr claim for PR #$n carries the manager's merge gate pass, so proposal $p can't be checked against what merged"
      [ "$merged_head" = "$head_sha" ] ||
        fail "proposal $p is of $head_sha, but PR #$n merged at $merged_head (pr claim $gated): propose the merged head"
      [ "$by" = "$author" ] || fail "proposal $p is by $author, but PR #$n's merged pr claim $gated is by $by"
      got+=("$n=$p")
      # Its base must be where weave-propose put it: the decision mirroring the nearest first-parent ancestor
      # of the PR's merge-base (itself included) that line main had recorded when the proposal was written
      # (finding 1553d7b4898a). Where that's an ancestor, the proposal carries the unrecorded commits' edits
      # too, and Weave's merge can bring back what a later PR undid (finding b2dd0470fb61).
      base=$(jq -r '.proposals[0].base // empty' <<<"$shown")
      from=$(awk -v d="$base" '$1 == d { print $2; exit }' <<<"$mirrored")
      [[ $from =~ ^[0-9a-f]{40}$ ]] || fail "proposal $p's base $base isn't a decision on line main that mirrors a git commit"
      fork=$(git -C "$repo" merge-base "$head_sha" "$sha^1") || fail "PR #$n's head $head_sha shares no history with $sha^1"
      [ "$from" = "$(nearest "$fork" "$(jq -r '.timestamp_ms // empty' <<<"$record")")" ] ||
        fail "proposal $p is based on $from's decision, not where scripts/weave-propose would base it"
      members+=("$from $fork $head_sha")
      [ "$from" = "$fork" ] || ancestral+=("$from $fork $head_sha")
    done
  fi
  # How the decision comes about, which its note records: merged (Weave's own merge), or a fallback that
  # imports the commit's tree.
  how='' paths='' ordered=() missing=()
  for n in ${prs[@]+"${prs[@]}"}; do
    if [ -n "$(of_pr "$n")" ]; then ordered+=("$(of_pr "$n")"); else missing+=("#$n"); fi
  done
  list=${ordered[@]+"${ordered[*]}"}
  word=proposal
  [ ${#ordered[@]} -le 1 ] || word=proposals
  if [ ${#proposals[@]} -gt 0 ] && [ ${#missing[@]} -eq 0 ]; then
    err=$(mktemp)
    if out=$("$weave" weave integrate --proposals "${ordered[@]}" --mirrors "$sha" --repo "$repo" \
      --note "shadow of $sha: merged $word $list" --as weave-integrator --json 2>"$err"); then
      [ -z "$mismatched" ] || { rm -f -- "$err"; fail "the $word merged equal to $sha after all, so --mismatched recorded it as merged"; }
      how=merged
    elif paths=$(jq -er '[.conflicts[]?.path] | select(length > 0) | join(", ")' <<<"$out" 2>/dev/null); then
      how=conflict
    elif paths=$(jq -er '[.differs[]?.path] | select(length > 0) | join(", ")' <<<"$out" 2>/dev/null); then
      # Where only an ancestor base's resurrections make the difference, it isn't a wrong merge: it falls
      # back to the import, noted and counted apart.
      if [ ${#ancestral[@]} -gt 0 ] && resurrected; then
        how=ancestor
      elif [ -z "$mismatched" ]; then
        jq -r '.differs[] | "differs: \(.change) \(.path)"' <<<"$out" >&2
        rm -f -- "$err"
        fail "Weave's merge of $word $list differs from git's $sha; nothing was written. Stop and report it; to go on, run again with --mismatched"
      else
        how=mismatch
      fi
    else
      cat -- "$err" >&2
      rm -f -- "$err"
      fail "weave integrate --proposals $list failed for $sha, so nothing was recorded"
    fi
    rm -f -- "$err"
  elif [ -n "$recorded" ]; then
    [ -z "$mismatched" ] || fail "--mismatched goes with the proposals that mismatched"
    how=none
  fi
  case $how in
    merged) note='' ;;
    conflict) note="shadow of $sha: $word $list conflicted at $paths" ;;
    mismatch) note="shadow of $sha: $word $list mismatched at $paths" ;;
    ancestor) note="shadow of $sha: $word $list differed at $paths, from an ancestor base" ;;
    none) note="shadow of $sha: no proposal${missing[@]+ for PR ${missing[*]}}" ;;
    *) note="shadow of $sha" ;;
  esac
  if [ "$how" != merged ]; then
    "$weave" weave import --from-git "$sha" --repo "$repo" --as weave-integrator
    out=$("$weave" weave integrate --from-git "$sha" --repo "$repo" --note "$note" --as weave-integrator --json)
  fi
  decision=$(jq -r '.decision // empty' <<<"$out")
  [ -n "$decision" ] || fail "weave integrate recorded no decision for $sha: $out"
  echo "decision $decision"
  echo "outcome ${how:-first}"
fi

# weave verify's exit code isn't enough: its JSON says whether the trees are equal.
verified=$("$weave" weave verify --git "$sha" --at "$decision" --repo "$repo" --json) || true
equal=$(jq -r '.equal // empty' <<<"$verified" 2>/dev/null) || equal=''
if [ "$equal" != true ]; then
  jq -r '.differences[]? | "\(.difference): \(.path)"' <<<"$verified" >&2 2>/dev/null || true
  fail "decision $decision doesn't verify equal to git's $sha"
fi
echo "verified $decision equal to $sha"

# How often Weave's own merge was used: line main's decisions by what their notes say.
notes=$("$weave" weave log --limit 100000 --json | jq -r '.decisions[].note')
count() { grep -cE "^shadow of [0-9a-f]+: $1" <<<"$notes" || true; }
merged=$(count 'merged proposals? ') none=$(count 'no proposal( for PR .*)?$')
conflict=$(count 'proposals? [0-9a-f ]+ conflicted at ') mismatch=$(count 'proposals? [0-9a-f ]+ mismatched at ')
ancestor=$(count 'proposals? [0-9a-f ]+ differed at .*, from an ancestor base$')
echo "stage 2a so far: $((merged + none + conflict + mismatch + ancestor)) merges, $merged by Weave's own merge;" \
  "fallbacks: $none no proposal, $conflict conflict, $mismatch mismatch, $ancestor ancestor base"
