#!/usr/bin/env bash
# metrics: the week's process metrics, and every experiment's state, from the Ground and git (task
# 9b65c13e9d66, decision 9be9ab6b1b1f; AGENTS.md, Process changes and experiments).
#
#   metrics [--week <Monday, YYYY-MM-DD>] [--today <YYYY-MM-DD>] [--ref <git ref>] [--json | --post]
#
# It reads `scripts/bk log --json` and `git log <ref> --first-parent` and fetches nothing. It prints one
# claim statement; with --post it also records it, as the runner identity (decision ff456e4e2fcc), a claim
# typed metric (bracken claim --type metric) whose keys are the week and every number below, and prints
# its id. The manager runs that weekly:
#
#   scripts/metrics --post
#
# --post writes only that one claim, through scripts/bk as runner, and refuses, writing nothing, if runner
# has no team token. Without --post it writes nothing.
#
# --week is the Monday (UTC) the week starts; by default the last complete week before --today (by default,
# today). --ref is the main line (origin/main, or main where there's no origin/main). --json prints the
# numbers as an object instead, keyed as an experiment's 'metric:' names them:
#
#   prs_merged            first-parent commits in the week whose subject ends '(#<n>)'
#   reverts               first-parent commits in the week whose subject starts 'Revert'
#   follow_up_fixes       merged PRs in the week whose title says fix or follow-up (a heuristic)
#   findings_real, findings_rejected, findings_untriaged
#                         finding claims written in the week, by the manager's latest evidence on each:
#                         pass (real), fail (rejected), none
#   findings_real_per_pr, findings_rejected_per_pr
#                         those over prs_merged (null when nothing merged)
#   review_rounds_per_pr  for the PRs merged in the week, the mean count of their pr claims (heads) that
#                         reviewer or security gave evidence on: claims with the PR's number and the merged
#                         claim's branch, as numbers restarted on GitHub (null when nothing merged)
#   gate_misfires         claims tagged misfire written in the week (the gate refused a good head or let
#                         a bad one through), plus merge-gate passes retracted in the week
#   owner_asks_gated, owner_asks_other
#                         claims tagged approval / owner-ask written in the week
#   experiments_active    current experiments not yet expired on --today
#   builder_pass_minutes  for the builders' pr claims written in the week whose head this checkout holds, the minutes
#                         from the head commit's committer time to the last pass its claim's author recorded
#                         on it; the median (null when there are none)
#   escapes_14d           a heuristic proxy for defects that escaped review (research-d, step A): finding
#                         claims written in the week that the manager confirmed (latest evidence pass) and
#                         that name a file a PR merged 1 to 14 days before them changed, counted once each,
#                         leaving out a PR the finding's own pr claim (what it contradicts) is for, as that
#                         one was still under review; plus revert commits in the week that change such a
#                         file. A finding names a file by its typed at key (path:line) or any path:line in
#                         its statement (a path holding a '/' or a '.'), matched to the merge's changed
#                         paths exactly
#   perf_claims_without_ab
#                         a heuristic proxy (experiment 5cae9af16145): pr and report claims written in the
#                         week whose statement gives a timing, a number followed by ms, µs or s, or p50 or
#                         p95, and doesn't say A/B or back to back
#
# A pr claim typed pr (claim --type pr) whose typed fields conform is read from them; one typed anything else
# isn't read as a pr claim; an untyped one from its statement, as before.
#
# An experiment is a current claim tagged experiment with lines 'rule:', 'metric:' (a key above),
# 'baseline:', 'target:' and 'expires: <YYYY-MM-DD>', or one typed experiment (claim --type experiment)
# whose typed fields conform, read from its metric, baseline, target and expires keys and its 'rule:' line. With no expires line it ends 14 days after it was
# written, and never later than 28 days after. Past its end it has lapsed, unless a current manager
# decision supports it (scripts/merge names the lapsed ones too). Each is listed with its days left, or
# lapsed or kept, and any field it lacks.
set -euo pipefail

usage() { echo 'usage: metrics [--week <YYYY-MM-DD>] [--today <YYYY-MM-DD>] [--ref <git ref>] [--json | --post]' >&2; exit 2; }
fail() { echo "metrics: $*" >&2; exit 1; }

week='' today='' ref='' json=false post=false
while [ $# -gt 0 ]; do
  case "$1" in
    --week) [ $# -ge 2 ] || usage; week=$2; shift 2 ;;
    --today) [ $# -ge 2 ] || usage; today=$2; shift 2 ;;
    --ref) [ $# -ge 2 ] || usage; ref=$2; shift 2 ;;
    --json) json=true; shift ;;
    --post) post=true; shift ;;
    *) usage ;;
  esac
done
! $json || ! $post || usage
for d in "$week" "$today"; do
  [ -z "$d" ] || [[ $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "'$d' isn't a date (YYYY-MM-DD)"
done
command -v jq >/dev/null || fail "needs jq"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(git -C "$here" rev-parse --show-toplevel) || fail "not in a git checkout"
if [ -z "$ref" ]; then
  if git -C "$repo" rev-parse -q --verify origin/main >/dev/null; then ref=origin/main; else ref=main; fi
fi
git -C "$repo" rev-parse -q --verify "$ref^{commit}" >/dev/null || fail "no commit '$ref'"

tmp=$(mktemp -d)
trap 'rm -r "$tmp"' EXIT
"$here/bk" log --json >"$tmp/all.json" || fail "couldn't read the Ground"
"$here/bk" log --tag experiment --current --json >"$tmp/experiments.json" || fail "couldn't read the experiments"
"$here/bk" log --tag decision --current --json >"$tmp/decisions.json" || fail "couldn't read the decisions"
git -C "$repo" log "$ref" --first-parent --format='%ct%x09%s' >"$tmp/main.txt"
# Each first-parent commit's time, subject and the paths it changed, for escapes_14d.
git -C "$repo" log "$ref" --first-parent -m --name-only --format='@@C%x09%ct%x09%s' >"$tmp/changes.txt"
# Typed readings, shared by both jq programs: a claim typed exactly <type> whose typed fields conform, a pr
# claim's number and branch or sha from its typed fields or, untyped, its statement as before.
typed='def typed_is($t): (.typed.type? // null) == $t and (.typed.problems // [""]) == [];
def untyped: (.typed.type? // null) == null;
def pr_nb: if typed_is("pr") then {n: .typed.data.pr, branch: .typed.data.branch}
  elif untyped then ((.body.statement // "") | capture("^PR #(?<n>[0-9]+) (?<branch>[^ ]+) @ ")) // null else null end;
def pr_sha: if typed_is("pr") then .typed.data.sha
  elif untyped then ((.body.statement // "") | capture("^PR #[0-9]+ [^ ]+ @ (?<sha>[0-9a-f]{40}):") | .sha) // null
  else null end;
'
# Each pr claim's head commit time, for the heads this checkout holds (others are left out).
jq -r "$typed"'.[] | select(.kind == "claim" and ((.body.tags // []) | index("pr"))) | pr_sha // empty' "$tmp/all.json" | sort -u |
  git -C "$repo" cat-file --batch-check='%(objectname) %(objecttype)' | awk '$2 == "commit" { print $1 }' |
  git -C "$repo" log --no-walk=unsorted --stdin --format='%H%x09%ct' >"$tmp/heads.txt"

# compute <as JSON, true or false>: the metrics, as the claim statement or the JSON object.
compute() {
jq -nr --arg week "$week" --arg today "$today" --arg ref "$ref" --argjson as_json "$1" \
  --slurpfile all "$tmp/all.json" --slurpfile exps "$tmp/experiments.json" --slurpfile decs "$tmp/decisions.json" \
  --rawfile main "$tmp/main.txt" --rawfile heads "$tmp/heads.txt" --rawfile changes "$tmp/changes.txt" "$typed"'
def day: . / 86400 | floor;
def date_s: . * 86400 | todate[0:10];
def of_date: . + "T00:00:00Z" | fromdateiso8601 | day;
def ratio($n; $d): if $d == 0 then null else ($n / $d * 10 | round / 10) end;
def field($k): [(.body.statement // "") | match("(?m)^" + $k + ":[ \\t]*(.*?)[ \\t]*$") | .captures[0].string] | first // null;
def xfield($k): if typed_is("experiment") and $k != "rule" then .typed.data[$k] else field($k) end;
($all[0]) as $all | ($exps[0]) as $exps | ($decs[0]) as $decs
| (if $today == "" then now | day else $today | of_date end) as $t
| (if $week == "" then $t - (($t + 3) % 7) - 7 else $week | of_date end) as $w
| if (($w + 3) % 7) != 0 then error("--week \($w | date_s) isn'"'"'t a Monday") else . end
| ($w + 7) as $e
| def inweek: (.timestamp_ms / 1000 | day) as $d | $d >= $w and $d < $e;
  ($main | split("\n") | map(select(length > 0) | split("\t") | {d: (.[0] | tonumber | day), s: (.[1:] | join("\t"))})
    | map(select(.d >= $w and .d < $e))) as $commits
| ($commits | map(select(.s | test("\\(#[0-9]+\\)$")))) as $merged
| ($merged | map(.s | capture("\\(#(?<n>[0-9]+)\\)$").n)) as $numbers
| ($all | map(select(.kind == "claim"))) as $claims
| ($all | map(select(.kind == "evidence"))) as $evidence
| ($all | map(select(.kind == "retract") | .body.target)) as $retracted
| ($evidence | map(select(.author_name == "manager")) | group_by(.body.target)
    | map({key: .[0].body.target, value: (max_by(.timestamp_ms).body.verdict)}) | from_entries) as $triage
| ($claims | map(select((.body.tags // []) | index("finding")) | select(inweek) | $triage[.id] // "untriaged")) as $findings
| ($merged | length) as $n
# PR numbers restarted at the move to GitHub (2026-11-04), so the heads of a merged PR are the pr claims with
# its number and its branch: the branch of the latest such claim with a live merge-gate pass, else the latest.
| ($all | map(select(.kind == "retract") | .body.target)) as $gone
| ([$numbers[] as $num
    | [$claims[] | select((.body.tags // []) | index("pr"))
        | pr_nb as $m
        | select($m != null and $m.n == $num) | . + {branch: $m.branch}] as $mine
    | ([$mine[] | .id as $id | select(any($evidence[]; .body.target == $id and .author_name == "manager"
          and ((.body.method // "") | startswith("merge gate @")) and (.id as $e | any($gone[]; . == $e) | not)))]
        | max_by(.timestamp_ms) // ($mine | max_by(.timestamp_ms))) as $merged_claim
    | [$mine[] | select(.branch == $merged_claim.branch)
        | .id as $id | select(any($evidence[]; .body.target == $id and (.author_name == "reviewer" or .author_name == "security")))]
    | length] | add // 0) as $rounds
| ($decs | map(select(.kind == "claim" and .author_name == "manager" and .retracted == false) | .id)) as $decision_ids
| ($all | map(select(.kind == "relation" and .body.kind == "supports" and .author_name == "manager"
    and (.id as $r | any($retracted[]; . == $r) | not)
    and (.body.from as $f | any($decision_ids[]; . == $f))) | .body.to)) as $supported
| ["prs_merged", "reverts", "follow_up_fixes", "findings_real", "findings_rejected", "findings_untriaged",
   "findings_real_per_pr", "findings_rejected_per_pr", "review_rounds_per_pr", "gate_misfires", "owner_asks_gated",
   "owner_asks_other", "experiments_active", "builder_pass_minutes", "escapes_14d", "perf_claims_without_ab"] as $keys
| ($heads | split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: (.[1] | tonumber)}) | from_entries) as $head_time
| ([$claims[] | select(((.body.tags // []) | index("pr")) and inweek) | . as $pr
    | pr_sha as $sha
    | select($sha != null and $head_time[$sha] != null)
    | select(($pr.author_name // "") | startswith("builder"))
    | [$evidence[] | select(.body.target == $pr.id and .body.verdict == "pass" and .author_name == $pr.author_name
        and (.id as $i | any($retracted[]; . == $i) | not)) | .timestamp_ms] as $passes
    | select(($passes | length) > 0)
    | (($passes | max) / 1000 - $head_time[$sha]) / 60] | sort) as $pass_minutes
| (if ($pass_minutes | length) == 0 then null
   else ($pass_minutes | length) as $l
     | (if $l % 2 == 1 then $pass_minutes[($l - 1) / 2] else ($pass_minutes[$l / 2 - 1] + $pass_minutes[$l / 2]) / 2 end)
     | . * 10 | round / 10 end) as $builder_pass_minutes
# escapes_14d (see the header): the merges on main by day with the paths they changed, then the
# confirmed findings and reverts of the week that touch a path a merge 1 to 14 days before them changed.
| ($changes | split("\n") | reduce .[] as $l ([];
    if ($l | startswith("@@C\t")) then . + [($l | split("\t")) as $f | {d: ($f[1] | tonumber | day), s: ($f[2:] | join("\t")), files: []}]
    elif ($l | length) > 0 and length > 0 then .[-1].files += [$l] else . end)) as $hist
| ($hist | map(select(.s | test("\\(#[0-9]+\\)$")) | . + {n: (.s | capture("\\(#(?<n>[0-9]+)\\)$").n)})) as $merges
| def escaped($d; $paths; $own): any($merges[]; .d >= $d - 14 and .d <= $d - 1 and (.n as $n | $own | index($n) | not)
    and (.files as $f | any($paths[]; . as $p | $f | index($p))));
  ($claims | map({key: .id, value: .}) | from_entries) as $by_id
| ($all | map(select(.kind == "relation" and .body.kind == "contradicts")) | group_by(.body.from)
    | map({key: .[0].body.from, value: [.[].body.to]}) | from_entries) as $contradicts
| ([$claims[] | select(((.body.tags // []) | index("finding")) and inweek and ($triage[.id] // "") == "pass")
    | ([((.typed.data.at? // "") | sub(":[0-9].*$"; "") | select(length > 0)),
        ((.body.statement // "") | scan("(?<p>[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+|[A-Za-z0-9_-]+\\.[A-Za-z0-9]+):[0-9]+") | .[0])]
       | unique) as $paths
    | [($contradicts[.id] // [])[] | $by_id[.] // empty | pr_nb | .n // empty] as $own
    | select(escaped(.timestamp_ms / 1000 | day; $paths; $own))] | length) as $escaped_findings
| ($hist | map(select(.d >= $w and .d < $e and (.s | test("^Revert"; "i")) and escaped(.d; .files; [])))
    | length) as $escaped_reverts
| ($claims | map(select((((.body.tags // []) | index("pr")) or ((.body.tags // []) | index("report"))) and inweek)
    | select((.body.statement // "") | test("\\b[0-9]+(\\.[0-9]+)? ?(ms|µs|s)\\b|\\bp(50|95)\\b"; "i"))
    | select((.body.statement // "") | test("A/B|back[- ]to[- ]back"; "i") | not)) | length) as $perf_without_ab
| ($exps | map(select(.kind == "claim" and .retracted == false and ((.body.tags // []) | index("experiment"))))
   | map((.timestamp_ms / 1000 | day) as $start | xfield("expires") as $given
     | (if $given and ($given | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) then $given | of_date else $start + 14 end) as $want
     | ([$want, $start + 28] | min) as $ends
     | {id: .id[:12], metric: xfield("metric"), ends: ($ends | date_s), days_left: ($ends - $t),
        state: (if $ends >= $t then "active" elif (.id as $i | any($supported[]; . == $i)) then "kept" else "lapsed" end),
        missing: ([("rule", "metric", "baseline", "target") as $k | select((xfield($k) // "") == "") | $k]
          + (if (xfield("metric") // "") as $m | $m != "" and ($keys | index($m) | not) then ["a known metric"] else [] end))})) as $experiments
| {week: ($w | date_s),
   prs_merged: $n,
   reverts: ($commits | map(select(.s | test("^Revert"; "i"))) | length),
   follow_up_fixes: ($merged | map(select(.s | test("\\b(fix|fixes|fixed|follow-?up)\\b"; "i"))) | length),
   findings_real: ($findings | map(select(. == "pass")) | length),
   findings_rejected: ($findings | map(select(. == "fail")) | length),
   findings_untriaged: ($findings | map(select(. == "untriaged")) | length),
   review_rounds_per_pr: ratio($rounds; $n),
   gate_misfires: (($claims | map(select(((.body.tags // []) | index("misfire")) and inweek)) | length)
     + ($all | map(select(.kind == "retract" and inweek) | .body.target) as $gone
        | $evidence | map(select((.body.method // "") | startswith("merge gate @")) | select(.id as $i | any($gone[]; . == $i)))
        | length)),
   owner_asks_gated: ($claims | map(select(((.body.tags // []) | index("approval")) and inweek)) | length),
   owner_asks_other: ($claims | map(select(((.body.tags // []) | index("owner-ask")) and inweek)) | length),
   experiments_active: ($experiments | map(select(.state == "active")) | length),
   builder_pass_minutes: $builder_pass_minutes,
   escapes_14d: ($escaped_findings + $escaped_reverts),
   perf_claims_without_ab: $perf_without_ab,
   experiments: $experiments}
| .findings_real_per_pr = ratio(.findings_real; $n) | .findings_rejected_per_pr = ratio(.findings_rejected; $n)
| if $as_json then . else
    def show: if . == null then "n/a" else tostring end;
    "Metrics, week of \(.week): | PRs merged \(.prs_merged) | reverts \(.reverts) / follow-up fixes \(.follow_up_fixes)"
    + " | findings \(.findings_real) real / \(.findings_rejected) rejected / \(.findings_untriaged) untriaged"
    + " (per PR: \(.findings_real_per_pr | show) real, \(.findings_rejected_per_pr | show) rejected)"
    + " | review rounds per PR \(.review_rounds_per_pr | show) | gate misfires \(.gate_misfires)"
    + " | owner asks \(.owner_asks_gated) gated / \(.owner_asks_other) other"
    + " | builder pass minutes (median) \(.builder_pass_minutes | show)"
    + " | escapes in 14 days \(.escapes_14d) (proxy) | perf claims without an A/B \(.perf_claims_without_ab) (proxy)"
    + " | experiments: " + (if (.experiments | length) == 0 then "none" else
        (.experiments | map("\(.id) \(.metric // "no metric") "
          + (if .state == "active" then "\(.days_left) days left" elif .state == "kept" then "kept by a decision"
             else "lapsed \(.ends)" end)
          + (if (.missing | length) > 0 then " (lacks \(.missing | join(", ")))" else "" end)) | join("; ")) end)
    + " | Method: scripts/metrics (task 9b65c13e9d66), weeks from Monday UTC, \($ref)."
  end'
}

if ! $post; then
  compute "$json"
  exit
fi
# --post: the statement, and as a claim typed metric, its week and every number as a key, signed by runner.
text=$(compute false)
data=$(compute true)
attrs=(--attr "week=$(jq -r .week <<<"$data")")
while IFS= read -r kv; do attrs+=(--attr "$kv"); done < <(jq -r 'to_entries[] | select(.value | type == "number") | "\(.key)=\(.value)"' <<<"$data")
printf '%s\n' "$text"
BRACKEN_AGENT=runner "$here/bk" claim "$text" --type metric "${attrs[@]}" --as runner ||
  fail "the metrics claim wasn't recorded as runner (see above); nothing else was written"
