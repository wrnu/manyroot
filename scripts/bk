#!/usr/bin/env bash
# bk: run the team's pinned bracken against the team's shared Ground, from any worktree.
#
# Every agent, in every worktree, must read and write the same Ground: the main
# checkout's .bracken/. This script finds the main checkout from its own location
# (not the caller's directory), so running it from elsewhere can't select another
# repo's Ground. For the same reason it ignores an inherited BRACKEN_DIR (left over
# from testing a throwaway Ground). It runs only the pinned binary in
# <main>/.bracken-bin, never whatever `bracken` is on PATH: a broken or stray build
# must not touch the team's Ground. Set BRACKEN_BIN to override deliberately.
#
# Once the team server is set up (scripts/team-server setup, which writes the main checkout's
# .bracken-team), the main checkout's replica syncs with it, using the token of the identity in --as
# or BRACKEN_AGENT:
#   - a write (claim, artifact, relate, evidence, retract, intend) is pushed, and bk fails unless the server
#     then confirms its heads cover it (one retry). Don't report work done on a failed write: it is only local
#     until a later sync pushes it.
#   - a read pulls first, with a short timeout, and falls back to the local replica, saying so on
#     stderr. With BK_PULL=required (scripts/merge) a read fails instead.
#   - watch is a read. With --follow it also syncs with the server before each look, on its own
#     --interval (at least 2 seconds), through watch's --sync and --token-file, which only bk gives.
#     If the pinned bracken has watch --feed, bk gives that too: watch then waits on the server's change
#     feed instead, and syncs only if the server has none.
#
# It refuses what would reach another Ground, or bring in work the team server can't confirm: --dir in
# any form, import, sync with anything but the team server, the weave command, and an artifact with a
# Weave media type (docs/design/weave.md, Keeping the two scripts apart). The Weave Ground is reached
# only through scripts/weave.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
  echo "bk: $here is not inside a git repository" >&2
  exit 1
}
main=$(dirname "$common")
export BRACKEN_DIR="$main/.bracken"

bin="${BRACKEN_BIN:-$main/.bracken-bin/bin/bracken}"
if [ ! -x "$bin" ]; then
  echo "bk: no pinned bracken at $bin" >&2
  echo "bk: the manager installs it (agent-team-kickoff skill, SKILL.md section 2.1)" >&2
  exit 1
fi
fail() { echo "bk: $*" >&2; exit 1; }
# A Weave media type, in any case. scripts/ground-guards and scripts/ground-checkpoint use the same test.
weave_media() { [[ $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') == application/vnd.bracken.weave* ]]; }
# The command, and whose token: --as before any '--', else BRACKEN_AGENT. What follows '--' is the
# command's own (evidence --run -- <cmd> ...), so an --as there isn't bk's (note 6b211180ec3a).
cmd='' who=${BRACKEN_AGENT:-} at=0 help=false follow=false peer=false
media=()
for ((i = 1; i <= $#; i++)); do
  case "${!i}" in
    --) break ;;
    --as) j=$((i + 1)); who=${!j:-}; i=$j ;;
    --as=*) who=${!i#--as=} ;;
    --dir | --dir=*) fail "--dir is refused: bk always uses the team's Ground. Test with your branch's binary and BRACKEN_DIR=\$(mktemp -d)/g instead" ;;
    --media-type) j=$((i + 1)); media+=("${!j:-}"); i=$j ;;
    --media-type=*) media+=("${!i#--media-type=}") ;;
    # Help runs only after every refusal: an option that takes the rest of the line, such as sync's
    # --exec, can make -h the argument of something that really runs (finding 3e1a0454a03b).
    -h | --help) help=true ;;
    --follow) follow=true ;;
    --sync | --sync=* | --token-file | --token-file=* | --feed) peer=true ;;
    -*) ;;
    *) [ -n "$cmd" ] || { cmd=${!i}; at=$i; } ;;
  esac
done
[ "$cmd" != weave ] || fail "weave is refused: the Weave Ground is reached only through scripts/weave"
# watch syncs only with the team server, as sync does (finding 6d623aa585d9): bk gives its --sync itself.
[ "$cmd" != watch ] || ! $peer || fail "watch's --sync, --token-file and --feed are refused: bk syncs watch --follow with the team server itself"
for m in ${media[@]+"${media[@]}"}; do
  ! weave_media "$m" || fail "a Weave media type is refused: Weave records go only into the Weave Ground, through scripts/weave"
done
# import adds whole bundles, other authors' work included, which the team server can't confirm: it
# never goes into the team's Ground through bk (finding 410e2e5d0239).
if [ "$cmd" = import ]; then
  echo "bk: import is refused: it would add a bundle to the team's Ground unconfirmed. Try it in a throwaway Ground with your branch's binary: export BRACKEN_DIR=\$(mktemp -d)/g; target/debug/bracken init; target/debug/bracken import <bundle>" >&2
  exit 1
fi
marker="$main/.bracken-team"
url=''
if [ -f "$marker" ]; then
  team=$(cat "$marker")
  url=$(cat "$team/url")
fi
# sync with a replica directory or --exec would bring in other authors' work unconfirmed: only the team
# server is a peer (finding 6d623aa585d9). Its arguments are parsed as clap does, past the global --as
# and the options that take a value (finding bf1a2d50d9d0): exactly one peer, the team server's URL.
if [ "$cmd" = sync ]; then
  peers=()
  for ((i = 1; i <= $#; i++)); do
    [ "$i" -ne "$at" ] || continue
    case "${!i}" in
      --) peers+=("${@:i+1}"); break ;;
      --exec | --exec=*) peers+=(--exec); break ;;
      --as | --token-file | --deadline | --budget | --id-budget | --batch-bytes) i=$((i + 1)) ;;
      -*) ;;
      *) peers+=("${!i}") ;;
    esac
  done
  [ -n "$url" ] && [ ${#peers[@]} -eq 1 ] && [ "${peers[0]}" = "$url" ] ||
    fail "sync is refused except with the team server${url:+ ($url)}: another peer would bring in work the team server can't confirm"
fi
! $help || exec "$bin" "$@"
[ -n "$url" ] || exec "$bin" "$@"

case "$cmd" in
  claim | artifact | relate | evidence | retract | intend) write=true ;;
  log | show | heads | conflicts | accepted | cat | export | watch) write=false ;;
  *) exec "$bin" "$@" ;;
esac
token="$team/tokens/$who"
[[ $who =~ ^[a-z0-9_-]{1,64}$ ]] && [ -f "$token" ] || token=
# sync_team <deadline> [--confirm]: the sync's last line of errors in $err, if it fails.
sync_team() {
  local out
  out=$("$bin" sync "$url" --token-file "$token" --deadline "$1" "${@:2}" 2>&1 >/dev/null) && return
  err=${out##*$'\n'}
  return 1
}

if $write; then
  [ -n "$token" ] || fail "no team token for '${who:-}' (pass --as <identity>), so nothing was written; the manager issues one with scripts/team-server token <identity>"
  "$bin" "$@" || exit
  # One retry, after 0.5 to 2 seconds, in case the server's sessions were all busy.
  sync_team 60 --confirm || {
    delay=$((RANDOM % 1500 + 500))
    sleep "$((delay / 1000)).$(printf %03d $((delay % 1000)))"
    sync_team 60 --confirm
  } ||
    fail "written to the local replica, but the team server didn't confirm it ($err). Don't report it done; retry with a read (bk heads), which pushes it"
  exit 0
fi
# watch --follow syncs again before each look, even if this first pull fails.
more=()
if [ "$cmd" = watch ] && $follow && [ -n "$token" ]; then
  more=(--sync "$url" --token-file "$token")
  # The change feed (task 09bf8248e69b), once the pinned bracken has it.
  ! "$bin" watch --help 2>/dev/null | grep -q -- '--feed' || more+=(--feed)
fi
if [ -z "$token" ]; then
  err="no team token for '${who:-}'; set BRACKEN_AGENT to your identity"
  [ "$cmd" != watch ] || ! $follow || [ "${BK_PULL:-}" = required ] ||
    echo "bk: watch --follow won't sync with the team server ($err): it reads only the local replica, which sees others' work only when something else pulls" >&2
elif sync_team "$([ "${BK_PULL:-}" = required ] && echo 60 || echo 5)"; then
  exec "$bin" "$@" ${more[@]+"${more[@]}"}
fi
[ "${BK_PULL:-}" != required ] || fail "can't pull from the team server, and this read must be current: $err"
echo "bk: not pulled from the team server ($err); reading the local replica" >&2
exec "$bin" "$@" ${more[@]+"${more[@]}"}
