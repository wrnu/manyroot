#!/usr/bin/env bash
# rustc-wrapper: cargo's build.rustc-wrapper for this repository (.cargo/config.toml, owner decision
# 8ac9b0239d90, docs/development.md under Builds). Cargo runs it as `rustc-wrapper <compiler> <args>...`.
#
# With sccache on PATH, the compile goes through sccache: one compile cache for every worktree on this
# machine, capped at SCCACHE_CACHE_SIZE (15G unless the caller set it). Without sccache (the boat box, a
# fresh machine) it runs the compiler itself, so nothing needs sccache to build.
#
# The sccache server listens on a unix socket in /tmp/bracken-sccache-<uid>, a directory of this user's at
# mode 0700, never on a TCP port another local process could reach (finding 292898be0ce0). If that
# directory is anything else (a symlink, someone else's, another mode), the compile skips sccache.
#
# When sccache can't reach or start its server (a sandbox that denies the socket, a server that won't
# start), it exits 2 before the compiler runs; the wrapper then runs the compiler itself, so the build goes
# on uncached (finding 20a5ceea1005). sccache 0.19 also exits 2 when a compile it ran itself was killed by a
# signal (a crash, the OOM killer), and says so last on stdout: "sccache: Compile terminated by signal <n>",
# at the end of the last line, which the compiler's own stdout may have begun (finding 19b295a1bb9a).
# That one is passed on, never rerun (finding ec492ce1a7d1); one the server ran ends 254, passed on too.
# Its errors can't be sorted reliably into before and after the compile (one context, "failed to execute
# compile", covers both, and the compiler's stderr is in the same stream: findings 5e48b5f2a88e,
# 38094ff61ec4), so any other exit 2 is rerun as before, a compile that had already run included. So is
# every exit 2 when the copy of stdout can't be made (finding 2bc99ca95dc3).
#
# sccache's client sends its environment to the server, which runs the compiler with it. So sccache gets
# only what a compile needs: the names cargo sets for a compile (CARGO_PKG_*, CARGO_BIN_EXE_*,
# CARGO_MANIFEST_*, CARGO_CRATE_NAME and the rest in the case below, even with AUTH or TOKEN in a name),
# then, never one that looks like a secret, the names in KEEP and the prefixes below (finding
# 289f76c488af: a user's CARGO_FORGE_TOKEN stays out). Nothing else in the caller's environment (tokens, keys)
# reaches the server. A build script's `cargo:rustc-env` variable passes only if it's listed here: if a
# dependency needs one, the build fails with "environment variable not defined", and the fix is to add
# its name to KEEP.
#
# Clippy (cargo runs `rustc-wrapper clippy-driver rustc <args>` for workspace members) skips sccache,
# so a lint is never answered from a cache made under other lint flags.
#
# It prints nothing of its own, and never logs a command or the environment: it drops sccache's own
# log settings too.
set -euo pipefail

sccache=$(command -v sccache || true)
case "${1##*/}" in
  clippy-driver*) sccache= ;;
esac
if [[ -n "$sccache" ]]; then
  uid=$(id -u)
  socket_dir=/tmp/bracken-sccache-$uid
  [[ -e "$socket_dir" || -L "$socket_dir" ]] || mkdir -m 700 "$socket_dir" 2>/dev/null || true
  if [[ -L "$socket_dir" ]] ||
    [[ -z "$(find "$socket_dir" -maxdepth 0 -type d -user "$uid" -perm 700 2>/dev/null)" ]]; then
    sccache=
  fi
fi
if [[ -z "$sccache" ]]; then
  exec "$@"
fi

KEEP=" PATH HOME TMPDIR USER LOGNAME LANG OUT_DIR TARGET HOST PROFILE OPT_LEVEL DEBUG NUM_JOBS SDKROOT \
DEVELOPER_DIR MACOSX_DEPLOYMENT_TARGET CC CXX AR CFLAGS CXXFLAGS LDFLAGS "
kept=()
# The environment as the process has it, NUL-separated. Not bash's own list (compgen -e, ${!name}): bash 5
# leaves out names that aren't shell identifiers, such as cargo's CARGO_BIN_EXE_<bin-with-hyphens>.
while IFS= read -r -d '' entry; do
  name=${entry%%=*}
  case "$name" in
    SCCACHE_LOG | SCCACHE_ERROR_LOG | SCCACHE_SERVER_*) continue ;;
    # What cargo sets for a compile, before the secret patterns: CARGO_PKG_AUTHORS has AUTH in it (finding
    # 58223509a78e), and a binary may be called tokenizer.
    CARGO | CARGO_PKG_* | CARGO_BIN_EXE_* | CARGO_BIN_NAME | CARGO_CRATE_NAME | CARGO_MANIFEST_* | \
      CARGO_PRIMARY_PACKAGE | CARGO_CFG_* | CARGO_ENCODED_RUSTFLAGS | CARGO_MAKEFLAGS | CARGO_TARGET_TMPDIR | \
      CARGO_RUSTC_CURRENT_DIR | __CARGO_* | DEP_*) ;;
    *TOKEN* | *SECRET* | *PASSWORD* | *PASSWD* | *CREDENTIAL* | *_KEY | *_KEY_* | *AUTH*) continue ;;
    RUSTC* | RUST_* | CLIPPY_* | SCCACHE_* | LC_*) ;;
    *) [[ "$KEEP" == *" $name "* ]] || continue ;;
  esac
  kept+=("$entry")
done < <(/usr/bin/env -0)

# sccache's stdout goes on through tee, with a copy in the private socket directory for its last line.
# stderr isn't touched (rustc's diagnostics and artifact notices go there, as they come), and nor is any
# other file descriptor: cargo's jobserver is on inherited ones (CARGO_MAKEFLAGS --jobserver-auth=3,5,
# finding c3665d850bc9).
out=$(mktemp "$socket_dir/stdout.XXXXXX" 2>/dev/null) || out=""
trap '[[ -z $out ]] || rm -f -- "$out"' EXIT
set +e
/usr/bin/env -i "${kept[@]}" \
  SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-15G}" \
  SCCACHE_IGNORE_SERVER_IO_ERROR="${SCCACHE_IGNORE_SERVER_IO_ERROR:-1}" \
  SCCACHE_SERVER_UDS="$socket_dir/server.sock" \
  "$sccache" "$@" | tee -- "${out:-/dev/null}"
rc=${PIPESTATUS[0]}
set -e
[[ $rc -eq 2 ]] || exit "$rc"
# A compile sccache ran and a signal killed: passed on. Any other 2: compile without sccache.
if [[ -n $out ]] && tail -n 1 -- "$out" | grep -Eq 'sccache: Compile terminated by signal [0-9]+$'; then
  exit 2
fi
[[ -z $out ]] || rm -f -- "$out"
exec "$@"
