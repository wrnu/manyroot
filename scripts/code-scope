#!/usr/bin/env bash
# code-scope: which changes can't alter what builds or tests, for scripts/test-table, bk-evidence
# and merge (owner decision 642a47c04a10, task a40bde8af77d).
#
#   code-scope docs-only <base> <head>
#   code-scope key <commit>
#   code-scope chain <main> <head>...
#
# Docs are the *.md files outside crates/: crates/ holds .md files the code compiles in (the
# experiment's prompts), so those count as code. .bracken/ is the Ground.
#
# docs-only exits 0 when what <head> changed since its merge base with <base> is at least one path,
# and every path is docs. Renames count as a deletion and an addition, so renaming or deleting a
# file that isn't docs is a code change. It exits 1, naming the first such path, otherwise, and 2 on
# an error (no such commit, say): only 0 means docs-only.
#
# key prints a hash of <commit>'s tree without .bracken/ and docs. Two trees with the same key
# differ only in the Ground and docs, so they build and test alike; the Ground guards, which read
# both, must still run.
#
# chain prints the prefixes of a batch (decision db6f7705c0a4): P_0 = <main>, then P_i = P_(i-1)
# merged with the i-th head, as git merge-tree computes it, which is the tree the forge's squash merge
# of that head onto P_(i-1) produces. One line each, '<i> <commit> <key>', for i = 0..n. The merge
# commits are made with git commit-tree, nothing else refers to them, and no ref or worktree changes.
# A head that doesn't merge cleanly onto its prefix stops it: exit 1, naming that head.
set -euo pipefail

usage() {
  echo "usage: code-scope docs-only <base> <head> | code-scope key <commit> | code-scope chain <main> <head>..." >&2
  exit 2
}

docs() {
  case "$1" in
    crates/*) return 1 ;;
    *.md) return 0 ;;
    *) return 1 ;;
  esac
}

case "${1:-}" in
  docs-only)
    [ $# -eq 3 ] || usage
    base=$(git merge-base "$2" "$3") || exit 2
    changed=$(mktemp)
    trap 'rm -f "$changed"' EXIT
    git diff --no-renames --name-only -z "$base" "$3" >"$changed" || exit 2
    any=false
    while IFS= read -r -d '' path; do
      any=true
      docs "$path" || { echo "code-scope: not docs: $path"; exit 1; }
    done <"$changed"
    $any || { echo "code-scope: no change since $base"; exit 1; }
    echo "code-scope: docs only since $base"
    ;;
  key)
    [ $# -eq 2 ] || usage
    tree=$(git rev-parse --verify -q "$2^{tree}") || { echo "code-scope: no commit $2" >&2; exit 2; }
    listing=$(mktemp)
    trap 'rm -f "$listing"' EXIT
    git ls-tree -r -z --full-tree "$tree" >"$listing" || exit 2
    # Each entry is '<mode> <type> <object>\t<path>'; only the path decides what's left out.
    while IFS= read -r -d '' entry; do
      path=${entry#*$'\t'}
      case "$path" in .bracken/*) continue ;; esac
      docs "$path" && continue
      printf '%s\0' "$entry"
    done <"$listing" | git hash-object --stdin
    ;;
  chain)
    [ $# -ge 3 ] || usage
    self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
    prefix=$(git rev-parse --verify -q "$2^{commit}") || { echo "code-scope: no commit $2" >&2; exit 2; }
    shift 2
    echo "0 $prefix $("$self" key "$prefix")"
    i=0
    for head in "$@"; do
      i=$((i + 1))
      head=$(git rev-parse --verify -q "$head^{commit}") || { echo "code-scope: no commit $head" >&2; exit 2; }
      tree=$(git merge-tree --write-tree "$prefix" "$head" 2>/dev/null | head -n 1) && [ -n "$tree" ] ||
        { echo "code-scope: head $i, $head, doesn't merge cleanly onto the batch before it" >&2; exit 1; }
      prefix=$(git -c user.name=code-scope -c user.email=code-scope@invalid commit-tree "$tree" -p "$prefix" -p "$head" \
        -m "batch prefix $i") || exit 2
      echo "$i $prefix $("$self" key "$prefix")"
    done
    ;;
  *) usage ;;
esac
