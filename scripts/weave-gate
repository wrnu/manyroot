#!/usr/bin/env bash
# weave-gate: line main's Weave results on a PR's merged tree, counted by scripts/merge in place of the
# manager's counted run (plan cc496dcee0e3 step 1b, design note 4f98bbf64314, decision bbbf898cbcfe).
# One definition of the switch and the fallbacks, for verify-seq --weave (record) and scripts/merge
# (check).
#
#   weave-gate state
#   [ON=<main rev>] weave-gate record <pr claim>:<sha>
#   weave-gate check <pr claim> <sha> <main sha> <key> <manifest> <pointer evidence> <main's tip>
#
# state: the switch. It's on only if exactly one current claim tagged weave-gate, written by the manager,
# exists (current: not retracted, and not superseded by its author, manager or owner; anyone else's
# supersede is ignored and named on stderr, finding 20a7646f3579), and its statement's first line is exactly 'Weave gate: on', nothing after it: 'Weave gate: on
# hold' and 'on-hold' are off (findings 307d5bd13ec5, 840e29c4202c). Reasons go on later lines. With
# none, an 'off' one, or several, it's off: so it
# stays off until the manager writes 'Weave gate: on', and one claim superseding it turns it off again at
# the next merge (plan section 6's stop conditions, without asking). Prints 'on <claim>' and exits 0, or
# 'off: <why>' and exits 1.
#
# record (verify-seq --weave, as manager): with the switch on, it computes M, git's merge of main (ON, by
# default origin/main) with the head, as scripts/merge does (scripts/tree-scope chain). It imports M into
# the Weave Ground as manifest H (weave-integrator), checks weave verify --git M --manifest H says equal,
# and has weave-runner validate H for the checks with no result yet. If line main's current policy has
# fmt, clippy, table and mac and weave green --manifest H says each is green, it records one manager
# evidence on the pr claim, the pointer:
#   'scripts/test-table --weave @ <sha> on <main sha> tree <key> manifest <H>'
# with details naming H, M, the policy version and each check's counted result ids. Otherwise it names
# why and says to run git's counted run, recording nothing. A check with no result at all, pass or fail,
# isn't a test failure: validate recorded nothing for it (a check that can't run stops validate and
# records nothing, gotcha c05efcb89101), so it says that, with validate's exit code and last line of
# error output, and which of the tools the checks need (cargo, cargo-nextest, boat, jq, timeout or
# gtimeout) aren't on PATH. It falls back the same way, before anything runs, when:
#   - the head doesn't merge cleanly onto main;
#   - the pr claim names no 'Weave proposal <64 hex>' that the Weave Ground holds (weave-shadow --proposal
#     needs it after the merge: it checks Weave's own merge against git's). A claim typed pr names it by
#     its weave key, an untyped one by the first in its statement (pr_claim, below);
#   - the head changes scripts/test-table, its template copy, or Cargo.lock: the policy pins main's
#     test-table, so the head's own copy would be untested, and the vendor directory is main's;
#   - git's merge holds what weave import leaves out and weave verify doesn't compare (finding
#     81648e74e519): a submodule anywhere, or a root entry other than the directory .bracken whose name
#     could fold to start with .bracken (unimported, below). The manifest would verify equal without it.
#
# check (scripts/merge, for each pointer on the claim): exits 0 only if, each read afresh and none taken
# from the pointer, the switch is on; the pointer is a current manager pass on the claim with that method;
# <main sha> is main's tip, or an ancestor of it that holds the head's merge base with the tip (finding
# 76c500f0c75d: a merge with a commit off main would test another tree; scripts/merge also requires main
# to have moved since only in .bracken/ and docs the head doesn't touch, its check-5 rule);
# the head is none of the fallbacks above against <main sha>; git's merge of <main sha> with the head has
# key <key> and holds nothing Weave leaves out; weave verify --git <that merge> --manifest <manifest> says equal; and weave green --manifest
# gives fmt, clippy, table and mac green under line main's current policy, with exactly the result ids the
# pointer's details name (a later re-run or fail makes the pointer stale). Otherwise it prints why on one
# line and exits 1.
#
# Both record and check first refuse, failing closed, a Weave Ground they can't trust (finding
# 26d9361e0a9f; decision d01c83b654d1 (5), narrowing decision 03534914ec55's check once option A of
# docs/design/weave-marker.md landed): one whose Ground id or replica root isn't the committed pin's
# (scripts/weave-pin check: no exception here, so until the pin is set, it refuses everything); one with no
# counted marker; one whose counted marker isn't signed by the pinned root; where --line main names
# another line than the default one; or where a record on a line main's judgement reads doesn't decode
# with the pinned binary (docs/design/weave-freeze.md G8), as weave head --line main warns. Another identity's marker never counts under the root rule, so it is
# no reason to refuse: refusing on one would hand every writer a stop. record exits 1, saying to run git's
# counted run, and check exits 1 with the reason; if any of these reads fails, it refuses the same way.
#
# Results are read only through weave green --manifest, by scripts/weave (decision bbbf898cbcfe).
#
# Every Weave read record and check make runs under timeout or gtimeout, WEAVE_GATE_TIMEOUT seconds (120 by
# default): one that runs out fails closed, record saying to run git's counted run and check failing,
# naming the read (report 0b5600268856). With neither tool on PATH, neither runs.
set -euo pipefail

here=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
weave="$here/weave"
# The checks a pointer needs, in the order validate runs them: mac reads table's passing log.
required=(fmt clippy table mac)
# The integrator: it signs the gate's imports.
integrator=weave-integrator
# Paths whose change by the head means git's counted run: the policy pins main's test-table, and the
# vendor directory follows main's Cargo.lock.
runner_paths=(scripts/test-table .claude/skills/agent-team-kickoff/templates/test-table Cargo.lock)

fail() { echo "weave-gate: $*" >&2; exit 2; }
# Every Weave read here, scripts/weave-pin check's included, runs under a bound, so a slow or stuck read
# fails closed rather than hang scripts/merge (report 0b5600268856, part C (5)): WEAVE_GATE_TIMEOUT seconds,
# 120 by default. A read that runs out counts as failed, and record or check then fails, whatever else it
# read, naming the read on its last line. weave import and weave validate (record only) are writes, which
# take as long as the tree or the checks do, and aren't bounded.
bound=${WEAVE_GATE_TIMEOUT:-120}
timeouts=''
usage() {
  echo "usage: weave-gate state | [ON=<main>] weave-gate record <pr claim>:<sha> | weave-gate check <pr claim> <sha> <main sha> <key> <manifest> <evidence> <tip>" >&2
  exit 2
}
command -v jq >/dev/null || fail "needs jq"
# The gate's Ground reads pull first and are full checks, as scripts/merge's are.
bk() { BK_PULL=required BRACKEN_FULL_CHECK=1 BRACKEN_AGENT=manager "$here/bk" "$@"; }

# bounded <label> <command>...: the command under timeout (or gtimeout), killed 10 s after the bound if it
# ignores TERM. One that runs out is noted in $timeouts, which outlives the command substitutions most reads
# run in, and returns non-zero like any failed read.
bounded() {
  local label=$1 rc=0
  shift
  "$timeout_bin" -k 10 "$bound" "$@" || rc=$?
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    echo "$label timed out after ${bound}s (WEAVE_GATE_TIMEOUT)" >>"$timeouts"
  fi
  return "$rc"
}
# wv <args>: a Weave read, bounded.
wv() { if [ "$1" = weave ]; then bounded "weave $2" "$weave" "$@"; else bounded "weave $1" "$weave" "$@"; fi; }
timed_out() { [ -n "$timeouts" ] && [ -s "$timeouts" ]; }
# bounds <mode>: sets up the bound for record or check, or refuses: with no timeout or gtimeout on PATH, a
# read could hang, so neither runs. The exit trap names a read that ran out, last, as the reason.
bounds() {
  [[ $bound =~ ^[1-9][0-9]{0,5}$ ]] || fail "WEAVE_GATE_TIMEOUT must be a whole number of seconds, not '$bound'"
  if command -v timeout >/dev/null; then
    timeout_bin=timeout
  elif command -v gtimeout >/dev/null; then
    timeout_bin=gtimeout
  elif [ "$1" = record ]; then
    echo "weave-gate: neither timeout nor gtimeout is on PATH, so the Weave reads can't be bounded; run git's counted run" >&2
    exit 1
  else
    echo "neither timeout nor gtimeout is on PATH, so the Weave reads can't be bounded"
    exit 1
  fi
  timeouts=$(mktemp)
  mode=$1
  trap on_exit EXIT
}
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && timed_out; then
    rc=1
    if [ "$mode" = record ]; then
      echo "weave-gate: $(head -n 1 "$timeouts"), so nothing from the Weave Ground counts; run git's counted run" >&2
    else
      echo "$(head -n 1 "$timeouts"), so nothing from the Weave Ground counts"
    fi
  fi
  rm -f "$timeouts" "${errors:-}" "${details:-}"
  exit "$rc"
}

# The current manager claims tagged weave-gate, as a JSON array. A claim superseded by another identity
# stops counting only if that identity is manager or owner (finding 20a7646f3579, as in scripts/merge): any
# writer can relate a claim 'supersedes' this one, so anyone else's is ignored, and named on stderr.
gate_claims() {
  local all ignored
  all=$(bk log --tag weave-gate --current --json) || return 1
  ignored=$(jq -r '[.[] | select(.kind == "claim" and .author_name == "manager") | .id[:12] as $c
    | .superseded_by_others[]? | select(.author_name != "manager" and .author_name != "owner")
    | "\($c) by \(.author_name // .author[:12]) (\(.id[:12]))"] | join(", ")' <<<"$all") || return 1
  [ -z "$ignored" ] ||
    echo "weave-gate: ignored a supersede of weave-gate claim $ignored: only its author, manager or owner can supersede it here (finding 20a7646f3579)" >&2
  jq '[.[] | select(.kind == "claim" and .retracted == false and .author_name == "manager"
    and (.superseded_by_others | type) == "array"
    and ([.superseded_by_others[] | select(.author_name == "manager" or .author_name == "owner")] | length) == 0)]' <<<"$all"
}

# switch: sets why; returns 0 if on.
switch() {
  local claims n
  claims=$(gate_claims) || { why="off: couldn't read the weave-gate claims"; return 1; }
  n=$(jq length <<<"$claims")
  case "$n" in
    0) why="off: no current manager claim tagged weave-gate"; return 1 ;;
    1) ;;
    *) why="off: $n current weave-gate claims, and only one may decide"; return 1 ;;
  esac
  if jq -e '.[0].body.statement | split("\n")[0] == "Weave gate: on"' <<<"$claims" >/dev/null; then
    why="on $(jq -r '.[0].id[:12]' <<<"$claims")"
    return 0
  fi
  why="off: the current weave-gate claim, $(jq -r '.[0].id[:12]' <<<"$claims"), doesn't have 'Weave gate: on' as its whole first line"
  return 1
}

# pr_claim <show json>: sets claim_pr, claim_sha and claim_proposal (empty if it names none) from a pr claim,
# or why and returns 1. A claim typed exactly pr (claim --type pr) whose typed fields conform is read from
# them, its proposal the weave key; a namespaced type such as bracken.pr isn't pr. An untyped claim is read
# from its statement, as before: 'PR #<n> <branch> @ <sha>:', and the first 'Weave proposal <64 hex>'.
pr_claim() {
  local typed statement
  typed=$(jq -r 'if (.typed.type? // null) == null then "untyped"
    elif .typed.type != "pr" then "bad it is typed \(.typed.type), not pr"
    elif (.typed.problems // ["no problems field"]) != [] then "bad its typed fields don'"'"'t conform"
    else "pr \(.typed.data.pr) \(.typed.data.sha) \(.typed.data.weave // "")" end' <<<"$1") ||
    { why="its JSON doesn't read"; return 1; }
  case "$typed" in
    untyped)
      statement=$(jq -r '.body.statement // empty' <<<"$1")
      [[ $statement =~ ^PR\ \#([0-9]+)\ [^\ ]+\ @\ ([0-9a-f]{40}): ]] || { why="it isn't a pr claim"; return 1; }
      claim_pr=${BASH_REMATCH[1]} claim_sha=${BASH_REMATCH[2]} claim_proposal=''
      if [[ $statement =~ Weave\ proposal\ ([0-9a-f]{64}) ]]; then claim_proposal=${BASH_REMATCH[1]}; fi
      ;;
    pr\ *)
      read -r _ claim_pr claim_sha claim_proposal <<<"$typed"
      [[ $claim_pr =~ ^[0-9]+$ && $claim_sha =~ ^[0-9a-f]{40}$ && $claim_proposal =~ ^([0-9a-f]{64})?$ ]] ||
        { why="its typed pr fields aren't a PR number, sha and proposal"; return 1; }
      ;;
    *) why=${typed#bad }; return 1 ;;
  esac
}

# fallback <base> <sha> <proposal>: sets why and returns 0 if the head must take git's counted run.
fallback() {
  local changed p proposal
  changed=$(git -C "$main" diff --no-renames --name-only "$1" "$2") || { why="git diff $1 $2 failed"; return 0; }
  for p in "${runner_paths[@]}"; do
    if grep -qxF -- "$p" <<<"$changed"; then
      why="the head changes $p, which Weave's run doesn't test from the head"
      return 0
    fi
  done
  [ -n "$3" ] || { why="the pr claim names no 'Weave proposal <64 hex>'"; return 0; }
  proposal=$3
  wv show "$proposal" --json >/dev/null 2>&1 || { why="the Weave Ground holds no proposal ${proposal:0:12}"; return 0; }
  return 1
}

# unimported <commit>: sets why and returns 0 if git's tree at <commit> holds what weave import leaves out
# and weave verify doesn't compare (finding 81648e74e519), so a manifest can verify equal to it without
# holding it: a submodule (mode 160000) anywhere, or a root entry, other than the directory .bracken itself,
# whose name Weave's path fold could start with .bracken. That fold is Unicode's (crates/tree/src/path.rs),
# so here a root name counts if, lowercased, it starts with .bracken, or if git quotes it (a byte outside
# ASCII, or a control character): a wider net than the fold's, which only ever means git's counted run.
# Returns 1 if the tree holds none; a git read that fails counts as holding one.
unimported() {
  local listing name
  listing=$(git -C "$main" -c core.quotePath=true ls-tree -r --full-tree "$1") || { why="git ls-tree $1 failed"; return 0; }
  name=$(awk -F '\t' '$1 ~ /^160000 / { print $2; exit }' <<<"$listing")
  [ -z "$name" ] || { why="git's merge $1 has a submodule at $name, which Weave leaves out of the manifest"; return 0; }
  listing=$(git -C "$main" -c core.quotePath=true ls-tree --full-tree "$1") || { why="git ls-tree $1 failed"; return 0; }
  name=$(awk -F '\t' '$1 ~ /^040000 tree / && $2 == ".bracken" { next }
    { n = tolower($2) } substr(n, 1, 1) == "\"" || substr(n, 1, 8) == ".bracken" { print $2; exit }' <<<"$listing")
  [ -z "$name" ] ||
    { why="git's merge $1 has the root entry $name, which Weave could leave out of the manifest (only the directory .bracken may start so)"; return 0; }
  return 1
}

# taken_over: sets why and returns 0 if the Weave Ground can't be trusted, or if it can't tell; returns 1 if
# it reads as honest: the committed pin's Ground and root, a counted marker by that root, --line main
# naming the default line, and no record on the lines main's judgement reads that this binary can't decode.
taken_over() {
  local pin root checked marker author default named said
  pin=$(bounded "weave-pin check" "$here/weave-pin" check 2>&1) || { why=$(tail -n 1 <<<"$pin"); why=${why#weave-pin: }; return 0; }
  root=${pin#* }
  # weave check exits 1 whenever it lists a problem, so its JSON is read whatever its exit code.
  checked=$(wv weave check --json 2>/dev/null) || true
  marker=$(jq -r '.marker // empty' <<<"$checked" 2>/dev/null) || marker=''
  [ -n "$marker" ] || { why="the Weave Ground has no counted marker by its root ${root:0:12}"; return 0; }
  author=$(wv show "$marker" --json 2>/dev/null | jq -r '.author // empty' 2>/dev/null) || author=''
  [ "$author" = "$root" ] ||
    { why="the counted marker ${marker:0:12} is by ${author:0:12}, not the pinned root ${root:0:12}"; return 0; }
  default=$(wv weave head --json 2>/dev/null | jq -r '.line // empty' 2>/dev/null) || default=''
  [ -n "$default" ] || { why="weave head names no default line"; return 0; }
  named=$(wv weave head --line main --json 2>/dev/null | jq -r '.line // empty' 2>/dev/null) || named=''
  [ "$named" = "$default" ] ||
    { why="--line main names ${named:-no single line}, not the default line ${default:0:12}"; return 0; }
  # A policy version or decision the pinned binary can't decode would have main judged without it, under an
  # older policy, so its results can't be counted (docs/design/weave-freeze.md G8). weave head warns of one
  # on the lines it judges, in words an older binary's Ground-wide warning shares, so this refuses with
  # either; weave green refuses outright from G8's release on.
  said=$(wv weave head --line main --json 2>&1 >/dev/null) || true
  if grep -q "don't decode with this build" <<<"$said"; then
    said=$(grep -m 1 "don't decode with this build" <<<"$said")
    why="line main's judgement holds a record this binary can't read (${said#bracken: warning: })"
    return 0
  fi
  # A read that ran out read nothing, the warning above included.
  if timed_out; then why=$(head -n 1 "$timeouts"); return 0; fi
  return 1
}

# merged <main> <sha>: prints '<commit> <key>' of git's merge, or returns 1 on a conflict.
merged() {
  local line
  line=$(cd "$main" && "$here/tree-scope" chain "$1" "$2" 2>/dev/null | tail -n 1) || return 1
  [[ $line =~ ^1\ ([0-9a-f]{40})\ ([0-9a-f]{40,64})$ ]] || return 1
  echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
}

# green_of <manifest>: weave green --manifest's JSON, checked for shape; if it fails or isn't, prints why
# instead and returns 1. Only its stdout is read as JSON: its stderr, kept apart, gives the message, and a
# warning there that a record doesn't decode refuses as taken_over's does (task 3b96803d923c).
green_of() {
  local green err said
  err=$(mktemp)
  if ! green=$(wv weave green --line main --manifest "$1" --json 2>"$err"); then
    said=$(grep -v '^[[:space:]]*$' "$err" | tail -n 1 || true)
    rm -f "$err"
    echo "weave green --manifest $1 failed: $said"
    return 1
  fi
  said=$(grep -m 1 "don't decode with this build" "$err" || true)
  rm -f "$err"
  [ -z "$said" ] ||
    { echo "line main's judgement holds a record this binary can't read (${said#bracken: warning: })"; return 1; }
  jq -e '(.checks | type) == "array" and (.version | type) == "string"
    and all(.checks[]; (.check | type) == "string" and (.green | type) == "boolean"
      and (.passes | type) == "array" and (.fails | type) == "array")' <<<"$green" >/dev/null 2>&1 ||
    { echo "weave green --manifest $1 isn't in the shape this reads"; return 1; }
  printf '%s\n' "$green"
}

# results <manifest>: 'version <id>', then line main's counted passes on it as '<check> <result>' lines,
# sorted. Unless every required check is in the policy and every check is green, it prints why instead
# and returns 1 (run in a command substitution, so it can't set why itself).
results() {
  local green c
  green=$(green_of "$1") || { echo "$green"; return 1; }
  for c in "${required[@]}"; do
    jq -e --arg c "$c" 'any(.checks[]; .check == $c)' <<<"$green" >/dev/null ||
      { echo "line main's policy has no check $c"; return 1; }
    jq -e --arg c "$c" 'any(.checks[]; .check == $c and ((.passes + .fails) | length) > 0)' <<<"$green" >/dev/null ||
      { echo "nothing was recorded for check $c on $1"; return 1; }
    jq -e --arg c "$c" 'any(.checks[]; .check == $c and .green == true and (.passes | length) > 0)' <<<"$green" >/dev/null ||
      { echo "check $c isn't green on $1"; return 1; }
  done
  jq -e '.green == true' <<<"$green" >/dev/null || { echo "not every check of line main's policy is green on $1"; return 1; }
  jq -r '"version \(.version)", ([.checks[] | .check as $c | .passes[] | "\($c) \(.result)"] | sort | .[])' <<<"$green"
}

# unrecorded_why <validate's exit code, or empty if it didn't run> <its error output file>: why validate
# may have recorded nothing, as far as this can tell: how validate ended, and the tools the checks need
# that aren't on PATH (a box check runs boat; the mac check cargo, cargo-nextest, jq and timeout).
unrecorded_why() {
  local said=() missing=() t last
  if [ -z "$1" ]; then
    said+=("weave validate didn't run")
  elif [ "$1" -eq 0 ]; then
    said+=("weave validate exited 0")
  else
    last=$(grep -v '^[[:space:]]*$' "$2" 2>/dev/null | tail -n 1 || true)
    said+=("weave validate exited $1${last:+: $last}")
  fi
  for t in cargo cargo-nextest boat jq; do command -v "$t" >/dev/null || missing+=("$t"); done
  command -v timeout >/dev/null || command -v gtimeout >/dev/null || missing+=("timeout or gtimeout")
  if [ ${#missing[@]} -gt 0 ]; then
    said+=("not on PATH: $(printf '%s, ' "${missing[@]}" | sed 's/, $//')")
  else
    said+=("every tool the checks need is on PATH")
  fi
  printf '%s; ' "${said[@]}" | sed 's/; $//'
}

# pending <manifest>: the required checks with no counted result on it at all, in order; or why not, and 1.
pending() {
  local green c
  green=$(green_of "$1") || { echo "$green"; return 1; }
  for c in "${required[@]}"; do
    jq -e --arg c "$c" 'any(.checks[]; .check == $c and ((.passes + .fails) | length) > 0)' <<<"$green" >/dev/null ||
      echo "$c"
  done
}

case "${1:-}" in
  state)
    [ $# -eq 1 ] || usage
    if switch; then echo "$why"; else echo "$why"; exit 1; fi
    ;;

  record)
    [ $# -eq 2 ] && [[ $2 =~ ^([0-9a-f]{12,64}):([0-9a-f]{40})$ ]] || usage
    claim=${BASH_REMATCH[1]} sha=${BASH_REMATCH[2]}
    bounds record
    switch || { echo "weave-gate: the Weave gate is $why; run git's counted run" >&2; exit 1; }
    if taken_over; then
      echo "weave-gate: refused: $why; nothing is counted from this Weave Ground until that's looked into: run git's counted run" >&2
      exit 1
    fi
    shown=$(bk show "$claim" --json) || fail "no contribution $claim in the Ground"
    full=$(jq -r .id <<<"$shown")
    pr_claim "$shown" && [ "$claim_sha" = "$sha" ] || fail "$claim isn't a pr claim for $sha"
    pr=$claim_pr
    git -C "$main" fetch -q origin main "refs/pull/$pr/head" 2>/dev/null || true
    tip=$(git -C "$main" rev-parse --verify -q "${ON:-origin/main}^{commit}") || fail "no commit ${ON:-origin/main}"
    git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null || fail "$sha isn't in the main checkout (fetch PR #$pr)"
    base=$(git -C "$main" merge-base "$tip" "$sha") || fail "$sha and main $tip share no history"
    if fallback "$base" "$sha" "$claim_proposal"; then
      echo "weave-gate: PR #$pr @ ${sha:0:12}: $why; run git's counted run" >&2
      exit 1
    fi
    m=$(merged "$tip" "$sha") ||
      { echo "weave-gate: PR #$pr @ ${sha:0:12} doesn't merge cleanly onto main $tip; run git's counted run" >&2; exit 1; }
    commit=${m% *} key=${m#* }
    if unimported "$commit"; then
      echo "weave-gate: PR #$pr @ ${sha:0:12}: $why; run git's counted run" >&2
      exit 1
    fi
    imported=$("$weave" weave import --repo "$main" --from-git "$commit" --as "$integrator" --json) ||
      fail "weave import of the merge $commit failed"
    manifest=$(jq -r '.manifest // empty' <<<"$imported")
    [[ $manifest =~ ^blake3:[0-9a-f]{64}$ ]] || fail "weave import gave no manifest"
    wv weave verify --repo "$main" --git "$commit" --manifest "$manifest" >/dev/null ||
      { echo "weave-gate: $manifest doesn't verify equal to git's merge $commit; run git's counted run" >&2; exit 1; }
    echo "weave-gate: PR #$pr @ ${sha:0:12} merged with main ${tip:0:12} is $commit (key $key), manifest $manifest"
    todo=$(pending "$manifest") || fail "$todo"
    validated='' errors=$(mktemp)
    if [ -n "$todo" ]; then
      args=()
      while IFS= read -r c; do args+=(--check "$c"); done <<<"$todo"
      echo "weave-gate: weave-runner validates $(tr '\n' ' ' <<<"$todo")on $manifest"
      # Its error output still shows as it comes, and a copy is kept for unrecorded_why; with pipefail,
      # the pipeline's status is validate's.
      validated=0
      { "$weave" --as weave-runner weave validate --line main --manifest "$manifest" "${args[@]}" 2>&1 >&3 3>&- |
        tee "$errors" >&2; } 3>&1 || validated=$?
      [ "$validated" -eq 0 ] ||
        echo "weave-gate: weave validate failed or was refused (exit $validated); reading what it recorded" >&2
    fi
    if ! counted=$(results "$manifest"); then
      if [[ $counted == "nothing was recorded for check "* ]]; then
        counted+=" ($(unrecorded_why "$validated" "$errors")), so this is no test result"
      fi
      echo "weave-gate: PR #$pr @ ${sha:0:12}: $counted; run git's counted run" >&2
      exit 1
    fi
    # Nothing is recorded if any Weave read ran out, whatever the others said.
    ! timed_out || exit 1
    details=$(mktemp)
    {
      echo "manifest $manifest"
      echo "merged $commit tree $key on main $tip"
      sed -n 's/^version /policy /p' <<<"$counted"
      sed -n '/^version /!s/^/result /p' <<<"$counted"
    } >"$details"
    method="scripts/test-table --weave @ $sha on $tip tree $key manifest $manifest"
    written=$(bk evidence "$full" pass --method "$method" --details-file "$details" --as manager) ||
      fail "couldn't record the pointer on $claim"
    echo "weave-gate: recorded ${written%%$'\n'*}: $method"
    echo "weave-gate: scripts/merge reads afresh the switch, git's merge of main ${tip:0:12} with ${sha:0:12} (key $key), weave verify of it against $manifest, and weave green --manifest $manifest:"
    sed 's/^/  /' "$details"
    ;;

  check)
    [ $# -eq 8 ] || usage
    claim=$2 sha=$3 on=$4 key=$5 manifest=$6 pointer=$7 tip=$8
    bounds check
    switch || { echo "the Weave gate is $why"; exit 1; }
    if taken_over; then echo "refused: $why"; exit 1; fi
    git -C "$main" merge-base --is-ancestor "$on" "$tip" 2>/dev/null ||
      { echo "the pointer's main ${on:0:12} isn't main's tip ${tip:0:12} or an ancestor of it"; exit 1; }
    if ! { tip_base=$(git -C "$main" merge-base "$tip" "$sha") && git -C "$main" merge-base --is-ancestor "$tip_base" "$on"; }; then
      echo "the pointer's main ${on:0:12} doesn't hold the head's merge base with main's tip"
      exit 1
    fi
    about=$(bk show "$pointer" --json 2>/dev/null) || { echo "no pointer $pointer in the Ground"; exit 1; }
    want="scripts/test-table --weave @ $sha on $on tree $key manifest $manifest"
    jq -e --arg c "$claim" --arg m "$want" '.kind == "evidence" and .retracted == false and .author_name == "manager"
      and .body.verdict == "pass" and .body.target == $c and .body.method == $m' <<<"$about" >/dev/null ||
      { echo "pointer ${pointer:0:12} isn't a current manager pass '$want' on this claim"; exit 1; }
    shown=$(bk show "$claim" --json) || { echo "can't read the pr claim"; exit 1; }
    pr_claim "$shown" || { echo "the pr claim doesn't read: $why"; exit 1; }
    base=$(git -C "$main" merge-base "$on" "$sha") || { echo "main $on and $sha share no history"; exit 1; }
    if fallback "$base" "$sha" "$claim_proposal"; then echo "$why"; exit 1; fi
    m=$(merged "$on" "$sha") || { echo "$sha doesn't merge cleanly onto main $on"; exit 1; }
    commit=${m% *}
    [ "${m#* }" = "$key" ] ||
      { echo "git's merge of main ${on:0:12} with ${sha:0:12} has key ${m#* }, not the pointer's $key"; exit 1; }
    if unimported "$commit"; then echo "$why"; exit 1; fi
    wv weave verify --repo "$main" --git "$commit" --manifest "$manifest" >/dev/null 2>&1 ||
      { echo "$manifest doesn't verify equal to git's merge of main ${on:0:12} with ${sha:0:12}"; exit 1; }
    counted=$(results "$manifest") || { echo "$counted"; exit 1; }
    named=$(jq -r '.body.details // ""' <<<"$about" | sed -n 's/^result //p' | sort)
    [ "$named" = "$(sed '/^version /d' <<<"$counted")" ] ||
      { echo "the pointer's results aren't the ones counted on $manifest now (stale, or not these): verify again"; exit 1; }
    ! timed_out || exit 1
    echo "line main's Weave results on $manifest, git's merge of main ${on:0:12} with this head, all green ($(sed '/^version /d; s/ .*//' <<<"$counted" | tr '\n' ' ' | sed 's/ $//'))"
    ;;

  *) usage ;;
esac
