#!/usr/bin/env bash
# merge: the manager's merge step (process section 5, step 8), checked and recorded.
#
#   merge <pr number> <pr claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]
#   merge --batch <batch claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]
#
# Only the manager merges, so it runs only as manager (a dry run defaults to it), and
# triage and deferrals count only when manager wrote them.
#
# Superseded, here and in scripts/weave-gate, means superseded by its own author, or by manager or owner
# (finding 20a7646f3579): any writer can relate a claim 'supersedes' any other, so anyone else's supersede
# of a claim these checks read (the pr claim, a batch claim, an owner-review, the owner's approvals) is
# ignored, and named on a 'note  ignored' line. A takeover's new pr claim stops the old one counting once
# the manager supersedes it (finding 29a53011dacb).
#
# Checks, in order, and reports each:
#   1. the pr claim is current (not retracted, and superseded by no one whose supersede counts: its
#      author, manager or owner) and is for PR #<n>: a claim typed pr (claim --type pr) by its typed pr,
#      branch and sha, which must conform (bracken's typed.problems empty); a claim typed anything else,
#      a namespaced type such as bracken.pr included, isn't a pr claim; an untyped one by its statement,
#      "PR #<n> <branch> @ <full sha>:", as before (task 8c9ad9bd4518, step 2);
#   2. under the given policy, `scripts/bk show <claim>` reports it accepted;
#   3. every finding that contradicts the claim has the manager's evidence, and
#      every confirmed one (a pass) is deferred by the manager: a current task tagged deferred,
#      written by the manager, which the manager related depends_on it (process 4.2);
#   4. the GitHub PR is open, targets main, and its head is that sha;
#   scope: a manager pass of scripts/test-table on the sha that bk-evidence labelled docs-only
#      counts only if the head is docs-only by scripts/tree-scope (everything it changed since main
#      is *.md or under docs/, outside crates/ and research/, and neither docs/protocol.md nor
#      docs/design/weave-freeze.md); one that reuses an earlier pass ('tree <key> reuses <id>') counts
#      only if <id> is a current manager pass of the whole table on a pr claim of the same PR with the
#      same key (owner decision 642a47c04a10). Any other such pass fails this check. Here and in 5,
#      'scripts/test-table --split' (the whole table in a box plus the macOS-only tests on the Mac,
#      owner decision 01a2d668b67e) counts as scripts/test-table; --remote alone doesn't. There is no light
#      pass (owner decision c8bbb2886be3, task bfc942cd7ced, superseding decisions 464d3ccca45e and
#      73f2ba4c08e5): a pass of part of the table, 'scripts/test-table --split -p ...' among them, counts
#      for nothing here;
#   5. main's tip is an ancestor of the sha, or every file main changed since the
#      branch point is under .bracken/, or is untouched by the branch and either
#      under docs/ (not docs/vision.md) or a .md file under .claude/skills/ outside
#      any templates/ directory: none of these can change what builds, tests or
#      runs. Renames count as a deletion and an addition. Otherwise, main may be
#      ahead in any path if a manager pass on the claim ran the whole test table on
#      the merge ('scripts/test-table @ <sha> on <main sha>', from bk-evidence --on, with
#      ' tree <key>' and then ' docs-only' or ' reuses <id>' after it as bk-evidence now
#      records them) with a main sha that main's tip has moved past only in those same
#      paths. A Weave pass counts here too
#      ('scripts/test-table --weave @ <sha> on <main sha> tree <key> manifest <H>', from verify-seq
#      --weave: line main's Weave results on that merge, plan cc496dcee0e3 step 1b), but the scope
#      check fails unless scripts/weave-gate check agrees, reading everything afresh: the Weave gate
#      on, git's merge with that key, weave verify of it against H, and weave green --manifest H with
#      exactly the results the pass names. A pass of
#      any other command with --on doesn't count: part of the table proves too little;
#   6. scripts/ground-guards passes on the sha against main's tip: no keys or stray
#      files under .bracken/, the Ground append-only, the Ground opens, and
#      docs/vision.md matches it;
#   frozen: what Weave's format freeze guards (docs/design/weave-freeze.md 2.4, G6; decision
#      bae92c497714), as main's scripts/tree-scope frozen names it for the head since main's tip. If it
#      names anything, then for each kind of line it prints: a 'frozen:' path needs a current claim
#      tagged owner-review, by manager, not retracted or superseded (as in 1), whose first line names the pr
#      claim's full id and the head's full sha; an 'owner:' path (a golden vector, a pinned fixture value,
#      tests/fixtures/) also needs the owner's own go (question 3): a current approval the owner ran with
#      scripts/owner-approve (not tagged delegated) of the pr claim's full id, that owner related supports the
#      claim (the claim names the sha); a 'security:' path (the directories of the freeze's refusals,
#      section 1.8) needs a pass by reviewer, not retracted, on the claim, 'independent review (<model>)
#      @ <sha>'. Each refusal names the paths and what's missing. Only frozen's exit 3 and its one line mean
#      nothing to check; any other exit, or an exit 0 with a line that isn't '<kind>: <path> (<why>)' of
#      those three kinds, fails the check (findings db2dc1c6120e, e3f9ae2b1820);
#   docker: the research workspace's Docker tests run on no CI runner that has Docker (finding d160c76dafca,
#      answer 5b3aa570643b; Linux portability is deferred task 1efdf2e34f46), so a head whose change since
#      its merge base with main's tip, or whose merge with it changes, anything under research/ or the old
#      crates/experiment/ and crates/demo/ (decision 07dd5c4f; the product crates the research tests build on
#      are left out, and the manager runs the research Docker tests on main weekly instead) (matched ASCII-lowercased, read NUL-separated; a rename counts as a deletion
#      and an addition, so one out of it counts too; a head that doesn't merge cleanly fails) needs a current
#      manager pass on the pr claim whose method starts 'research docker tests' and ends ' @ <sha>': the
#      by-hand run on the Mac with Docker running (docs/development.md). Any other head passes this check;
#   7. with --owner-approval, for a PR whose class needs the owner's go (AGENTS.md, Safety): a current
#      claim tagged approval (not superseded, as in 1), written by owner with scripts/owner-approve, so not
#      tagged delegated, that owner related supports this pr claim itself, by its full id. An approval of a
#      task, another PR or an earlier head doesn't count (findings 9e8e0c849724, fb07d1777cf6): each head
#      needs its own. A manager-signed quote doesn't count, nor does an approval the manager signed on the
#      owner's delegation (--delegated is gone, task 9b65c13e9d66). In v0 keys are shared, so this
#      checks recorded intent, not proof (task ec880b9c2c86).
# Before the checks, it prints one 'note  experiments' line naming every expired experiment (a current claim
# tagged experiment, AGENTS.md, Process changes and experiments) that no current manager decision supports:
# its rule has lapsed. It expires on its 'expires: <YYYY-MM-DD>' line, or 14 days after it was written if it
# has none, and never later than 28 days after; one typed experiment, on its expires key. A second note
# names any whose expires date isn't a real date. The notes alone never block the merge (task
# 9b65c13e9d66); check 'experiments' fails it when AGENTS.md, as the merge leaves it, cites an experiment
# (by any id prefix of 8 or more hex digits, in any case) that isn't current and unexpired: lapsed,
# malformed, retracted, superseded, missing, ambiguous or not an experiment; or when the experiments can't
# be read (decision ff456e4e2fcc).
# A batch pass (scripts/verify-seq --batch, decision db6f7705c0a4) is a manager pass whose method is
# 'scripts/test-table[ --split] @ <sha> batch <batch claim> on <main> tree <key> run <evidence>'. It
# counts only if the batch claim is a current manager claim tagged batch that lists this PR, claim and
# sha with that main and key, and <evidence> is the manager's pass on the batch claim of a commit whose
# key is <key>. In check 5, the plain form accepts it only when this head merged with main's tip is
# exactly the tested tree: the same key, and differing from the tested commit only in .bracken/ and docs
# no member touches (finding 9a3eaf48e2d7). Never a prefix of the batch.
#
# --batch merges a whole batch, all or nothing. It first runs every check for every member, in a dry
# run, with check 5 asking that main's tip differs from the batch's main only in .bracken/ and docs no
# member touches (the same untested() rule as below, and the same key), and that the members merge onto
# it, in order, into the tested tree. If any member fails, it merges none. Then it merges them in the
# tested order, each with every check again and check 5 asking that main's tip is the prefix before it,
# by the same rule, and that the squash merge's tree (git merge-tree) is the next prefix; after each
# merge, including one GitHub made though the call failed (the outcome handling below), it fetches
# main and compares again (finding 3199c8e0a8ad). If anything fails part way, it stops, and says which members
# merged, by their live merge-gate passes: main is then on a prefix nothing tested, and the rest need a
# new run on it. Which member it checks or merges, and how, is state inside this process: merge reads
# none from the environment (finding f692f52a1a43).
#
# If all pass, it records manager evidence "merge gate @ <sha>" on the claim, then
# squash-merges through GitHub's API (PUT pulls/<n>/merge) with sha set to the head, so
# GitHub refuses the merge (409) if the branch moved after the check. If the merge fails and
# GitHub shows the PR still open, it retracts that evidence: a live merge-gate pass
# means the PR merged. If the outcome is unclear, it keeps it and says so. After a merge, it
# deletes the head branch if it is in origin's repository and still at the sha; that is best
# effort, and the merge stands whatever it does. --dry-run runs every check, records nothing,
# and makes only GET requests.
#
# GitHub is reached only through `gh api --hostname <origin's host>`, which authenticates from gh's
# own credential store (gh auth login). merge never reads, holds or passes a token: gh runs with
# GH_TOKEN, GITHUB_TOKEN and the enterprise token variables unset, so a token in the caller's
# environment is never used, and GH_DEBUG unset, so gh logs no HTTP traffic.
# With the team server set up (scripts/team-server), every read pulls from it first, and the
# gate refuses if it can't. The checks' Ground reads are made up front, in one `bracken batch` (one pull,
# one full check), or, with a pinned bracken that has no batch, one bk per read.
# Needs gh and jq.
set -euo pipefail
# Never trace or auto-export (both can be inherited through SHELLOPTS).
set +ax

usage() {
  echo "usage: merge <pr number> <pr claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]" >&2
  echo "       merge --batch <batch claim> --validator <id>... --min-passes N --as manager [--owner-approval] [--dry-run]" >&2
  exit 2
}
fail() { echo "merge: $*" >&2; exit 1; }
# Batch state lives in these shell variables, set only by --batch below for the members it checks and
# merges, never from the environment (finding f692f52a1a43); a caller still setting the old variables is
# told so, rather than ignored.
for v in MERGE_BATCH MERGE_BATCH_PRECHECK MERGE_NO_CLEANUP; do
  [ -z "${!v+x}" ] || fail "$v is set in the environment; merge takes no batch state from it: unset it, and use merge --batch"
done
batch_member='' batch_precheck=false no_cleanup=false
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Who may supersede another's claim for these checks (finding 20a7646f3579): log --current already hides a
# claim its own author superseded; one superseded by someone else stops counting only if that someone is
# manager or owner. Anyone can relate a claim of theirs 'supersedes' any claim, and only they can retract
# it, so a supersede by any other writer is ignored here, and reported on one line (ignored_supersedes).
# The relation's author is superseded_by_others[].author_name, from the local agents/ names.
live='def live: .retracted == false and (.superseded_by_others | type) == "array"
  and ([.superseded_by_others[] | select(.author_name == "manager" or .author_name == "owner")] | length) == 0;'
# ignored_supersedes <log --current JSON> <full id> <what>: one line naming the supersedes of <full id> that
# don't count, if it has any; nothing otherwise.
ignored_supersedes() {
  local who
  who=$(jq -r --arg id "$2" '[.[] | select(.id == $id) | .superseded_by_others[]?
    | select(.author_name != "manager" and .author_name != "owner")
    | "\(.id[:12]) by \(.author_name // .author[:12])"] | join(", ")' <<<"$1") || who='(unreadable)'
  [ -z "$who" ] ||
    printf '%-4s  %-12s %s\n' note ignored "$3 ${2:0:12} is superseded by $who: ignored, since only its author, manager or owner can supersede it here (finding 20a7646f3579)"
}

# req <arg>...: one read request for bk_reads, the read's arguments as a JSON array (NUL-split, so any jq
# reads it the same and no argument is taken for one of jq's own options).
req() { printf '%s\0' "$@" | jq -Rsc 'split("\u0000")[:-1]'; }
# bk_reads <request>...: one JSON line per request, in order, {"ok": true, "result": <its --json output>} or
# {"ok": false, "error": ...}: through one `bk batch`, so one pull and one full check for them all (task
# 8c9ad9bd4518, step 2), or, with a pinned bracken that has no batch yet, one bk per request.
bk_reads() {
  local r out a args
  if bk batch --help >/dev/null 2>&1; then
    printf '%s\n' "$@" | bk batch
    return
  fi
  for r in "$@"; do
    args=()
    while IFS= read -r -d '' a; do args+=("$a"); done < <(jq -j '.[] | ., "\u0000"' <<<"$r")
    # Exactly one JSON document, as batch gives: anything else is a failed read.
    if out=$(bk "${args[@]}" 2>/dev/null) && jq -se 'length == 1' <<<"$out" >/dev/null 2>&1; then
      jq -c '{ok: true, result: .}' <<<"$out"
    else
      jq -cn --arg r "$r" '{ok: false, error: ("bk " + $r + " failed")}'
    fi
  done
}
# nth <n>: request <n>'s result from $reads, or a failed return.
nth() { sed -n "$1p" <<<"$reads" | jq -ce 'select(.ok == true) | .result'; }
# pr_typed <show json>: how to read a pr claim. 'untyped' (read its statement, as before); 'pr <n> <branch>
# <sha>' from a claim typed exactly pr (claim --type pr) whose typed fields conform; or 'bad <why>'. A
# namespaced type such as bracken.pr isn't pr (the shapes name exact types).
pr_typed() {
  jq -r 'if (.typed.type? // null) == null then "untyped"
    elif .typed.type != "pr" then "bad it is typed \(.typed.type), not pr"
    elif (.typed.problems // ["no problems field"]) != [] then "bad its typed fields don'"'"'t conform: \(.typed.problems | join("; "))"
    else "pr \(.typed.data.pr) \(.typed.data.branch) \(.typed.data.sha)" end' <<<"$1"
}

# read_batch <id>: the batch claim, if it is current, the manager's, tagged batch, and well formed. Sets
# b_full, b_main, b_key, b_n and the arrays b_pr, b_claim, b_sha (members in the tested order, from 0);
# otherwise returns 1 with batch_why saying why.
read_batch() {
  local about items item k=0 batches
  about=$(bk show "$1" --json 2>/dev/null) || { batch_why="no contribution $1 in the Ground"; return 1; }
  b_full=$(jq -r .id <<<"$about")
  jq -e '.kind == "claim" and .retracted == false and .author_name == "manager" and (.body.tags | index("batch"))' \
    <<<"$about" >/dev/null || { batch_why="$1 isn't a current manager claim tagged batch"; return 1; }
  batches=$(bk log --tag batch --current --json) || { batch_why="couldn't read the current batch claims"; return 1; }
  jq -e --arg id "$b_full" "$live"' any(.[]; .id == $id and live)' <<<"$batches" >/dev/null ||
    { batch_why="batch $1 is superseded"; return 1; }
  ignored_supersedes "$batches" "$b_full" "batch claim" >&2
  [[ $(jq -r .body.statement <<<"$about") =~ ^Batch\ of\ ([1-9][0-9]*)\ on\ main\ ([0-9a-f]{40})\ tree\ ([0-9a-f]{40,64}),\ tested\ in\ this\ order:\ (.*)$ ]] ||
    { batch_why="batch $1's statement isn't 'Batch of <n> on main <sha> tree <key>, tested in this order: ...'"; return 1; }
  b_n=${BASH_REMATCH[1]} b_main=${BASH_REMATCH[2]} b_key=${BASH_REMATCH[3]} items=${BASH_REMATCH[4]}
  b_pr=() b_claim=() b_sha=()
  while [ -n "$items" ]; do
    item=${items%%; *}
    [ "$item" = "$items" ] && items='' || items=${items#*; }
    k=$((k + 1))
    [[ $item =~ ^$k\ PR\ \#([1-9][0-9]*)\ ([0-9a-f]{64})\ @\ ([0-9a-f]{40})$ ]] ||
      { batch_why="batch $1's member $k isn't '$k PR #<n> <claim> @ <sha>'"; return 1; }
    b_pr+=("${BASH_REMATCH[1]}") b_claim+=("${BASH_REMATCH[2]}") b_sha+=("${BASH_REMATCH[3]}")
  done
  [ "$k" = "$b_n" ] || { batch_why="batch $1 says $b_n members and lists $k"; return 1; }
}


# merge_one <pr number> <pr claim> <options>: checks one PR and, unless it's a dry run, merges it. Its body
# is the whole plain form, left unindented; --batch runs it in a subshell per member, with batch_member
# (and batch_precheck) set.
merge_one() {
# --batch runs this in a subshell with errexit off around it, so it turns errexit back on: every read
# below that isn't checked otherwise must stop the gate (finding 54a83c918a26).
set -e
[ $# -ge 2 ] || usage
pr=$1
claim=$2
shift 2
[[ $pr =~ ^[1-9][0-9]*$ ]] || fail "'$pr' isn't a PR number"
[[ $claim =~ ^[0-9a-f]{12,64}$ ]] || fail "'$claim' isn't a claim id (12 to 64 hex characters)"
agent=${BRACKEN_AGENT:-}
min_passes=
dry_run=false
owner_approval=false
policy=()
while [ $# -gt 0 ]; do
  case "$1" in
    --validator) [ $# -ge 2 ] || usage; policy+=(--validator "$2"); shift 2 ;;
    --min-passes) [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; min_passes=$2; shift 2 ;;
    --as) [ $# -ge 2 ] || usage; agent=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --owner-approval) owner_approval=true; shift ;;
    *) usage ;;
  esac
done
[ ${#policy[@]} -gt 0 ] && [ -n "$min_passes" ] || fail "give the gate's policy: --validator <id>... --min-passes N (process section 4.2)"
$dry_run || [ -n "$agent" ] || fail "no identity: pass --as manager or set BRACKEN_AGENT"
[ "${agent:-manager}" = manager ] ||
  fail "only the manager merges (process 4.2): run with --as manager, not '$agent' (dry runs too)"
for tool in gh jq; do command -v "$tool" >/dev/null || fail "needs $tool"; done

main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
# With a team server set up, the gate decides only on a replica that has just pulled from it
# (network-sync.md section 5): every read below must pull, with no fallback to the local replica.
# Its own Ground reads are full checks, never through the verified snapshot (docs/cli.md, The verified
# snapshot); only these, never the tests it runs (finding 607273d1d193).
bk() { BK_PULL=required BRACKEN_FULL_CHECK=1 BRACKEN_AGENT=${agent:-manager} "$here/bk" "$@"; }
bk heads >/dev/null || fail "can't pull from the team server, so the gate won't decide on a replica that may be behind"
# Who triages findings and defers them (check 3).
triager=manager
# Every other read the checks need, up front in one bk: one more pull, one full check, one state of the Ground.
reads=$(bk_reads "$(req log --tag experiment --current --json)" \
  "$(req log --tag decision --current --json)" \
  "$(req show "$claim" ${policy[@]+"${policy[@]}"} --min-passes "$min_passes" --json)" \
  "$(req log --tag pr --current --json)" "$(req findings "$claim" --triager "$triager" --json)" \
  "$(req log --tag owner-review --current --json)" "$(req log --tag approval --current --json)" \
  "$(req log --tag experiment --json)") ||
  fail "can't pull from the team server, so the gate won't decide on a replica that may be behind"
if [ -f "$main/.bracken-team" ]; then
  echo "team server: every read pulls from $(cat "$(cat "$main/.bracken-team")/url")"
else
  echo "team server: none set up (no .bracken-team); reading the local replica"
fi

# Experiments (see the header). Each current, live claim tagged experiment is read on its own, one line
# '<full id> <state> <detail>': active or expired with the day it ends, or malformed with why. An experiment
# typed exactly experiment whose typed fields conform (claim --type experiment) ends on its expires key; any
# other on its statement's 'expires:' line, as before. A date that isn't a real one makes only that one
# malformed (findings bdee6db8dfcf, 10febee32fff). Anything that can't be read fails check 'experiments'
# below, never reads as no experiments.
exp_fail='' exp_states='' lapsed_ids=() malformed=()
today=$(date -u +%Y-%m-%d)
if ! exps=$(nth 1) || ! exp_all=$(nth 8); then
  exp_fail="couldn't read the experiment claims"
elif ! exp_states=$(jq -r --arg today "$today" "$live"'
  .[] | select(.kind == "claim" and live and ((.body.tags // []) | index("experiment")))
  | (.timestamp_ms / 1000 | floor) as $start
  | (if (.typed.type? // null) == "experiment" and (.typed.problems // [""]) == [] then .typed.data.expires
     else [(.body.statement // "") | match("(?m)^expires:[ \t]*([0-9]{4}-[0-9]{2}-[0-9]{2})[ \t]*$") | .captures[0].string]
      | first // null end) as $given
  | (if $given == null then $start + 14 * 86400
     else (try ($given + "T00:00:00Z" | fromdateiso8601) catch null)
       | if . != null and (todate[0:10]) == $given then . else null end end) as $t
  | if $t == null then "\(.id) malformed its expires date \($given) isn'"'"'t a real date"
    else ([$t, $start + 28 * 86400] | min | todate[0:10]) as $ends
      | "\(.id) \(if $ends < $today then "expired" else "active" end) \($ends)" end' <<<"$exps"); then
  exp_fail="couldn't read the experiments' dates"
fi
# Kept: an expired one a current manager decision supports (its statement cites the metrics that met the
# target). The rest have lapsed.
expired=() asks=()
while read -r e state detail; do
  case "$state" in
    expired) expired+=("$e:$detail") asks+=("$(req show "$e" --json)") ;;
    malformed) malformed+=("${e:0:12} ($detail)") ;;
  esac
done <<<"$exp_states"
if [ -z "$exp_fail" ] && [ ${#expired[@]} -gt 0 ]; then
  decisions=$(nth 2) && shows=$(bk_reads "${asks[@]}") || exp_fail="couldn't read the decisions about the expired experiments"
  n=0
  for e in "${expired[@]}"; do
    [ -z "$exp_fail" ] || break
    n=$((n + 1))
    about=$(sed -n "${n}p" <<<"$shows" | jq -ce 'select(.ok == true) | .result') || {
      exp_fail="couldn't read what refers to experiment ${e:0:12}"
      break
    }
    jq -e --argjson decisions "$decisions" "$live"'
      ([$decisions[] | select(.kind == "claim" and .author_name == "manager" and live) | .id]) as $d
      | any(.referrers[]; .kind == "relation" and .retracted == false and .author_name == "manager"
        and .body.kind == "supports" and (.body.from as $f | any($d[]; . == $f)))' <<<"$about" >/dev/null ||
      lapsed_ids+=("$e")
  done
fi
lapsed=()
for e in ${lapsed_ids[@]+"${lapsed_ids[@]}"}; do lapsed+=("${e:0:12} (ended ${e##*:})"); done
[ ${#lapsed[@]} -eq 0 ] || printf '%-4s  %-12s %s\n' note experiments \
  "expired, so their rules have lapsed unless a manager decision citing the metrics supports them: ${lapsed[*]}"
[ ${#malformed[@]} -eq 0 ] || printf '%-4s  %-12s %s\n' note experiments \
  "malformed, so when they end can't be read: ${malformed[*]}"

origin=$(git -C "$main" config --get remote.origin.url)
# Not printed: an origin URL can carry a password.
[[ $origin =~ ^https://([^/@]+)/([^/]+)/([^/]+)$ ]] ||
  fail "origin's URL isn't https://<host>/<owner>/<repo>, with no user or password in it"
host=${BASH_REMATCH[1]}
repo="${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}"
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "origin's owner and repository aren't plain names"

# gh_ <args>: gh with only its own credential store (see the header), never prompting.
gh_() {
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u GH_DEBUG -u DEBUG \
    -u GH_HOST -u GH_REPO GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh "$@"
}
gh_ auth status --hostname "$host" >/dev/null 2>&1 ||
  fail "gh has no login for $host in its own credential store: run gh auth login --hostname $host"

# api <method> <path> [json body file] [status]: prints the response body, or with "status" only the HTTP
# status (000 if there was no reply), from gh's --include status line; it fails unless the status is 2xx.
# <path> is under repos/<owner>/<repo>. In a dry run, anything but GET is refused here, before any request.
api() {
  local method=$1 path=$2 body=${3:-} status=${4:-} out code rc=0
  [ "$method" = GET ] || ! $dry_run || fail "dry run: refusing $method $path"
  local args=(api --hostname "$host" -X "$method" -H "Accept: application/vnd.github+json"
    -H "X-GitHub-Api-Version: 2022-11-28")
  [ -z "$body" ] || args+=(--input "$body")
  if [ -z "$status" ]; then
    gh_ "${args[@]}" "repos/$repo$path"
    return
  fi
  out=$(gh_ "${args[@]}" --include "repos/$repo$path" 2>/dev/null) || rc=$?
  code=$(sed -n '1s|^HTTP/[0-9.]* \([0-9][0-9][0-9]\).*|\1|p' <<<"$out")
  printf '%s' "${code:-000}"
  [ "$rc" = 0 ] && [[ ${code:-000} == 2?? ]]
}

failed=0
check() { # check <ok|FAIL> <name> <detail>
  printf '%-4s  %-12s %s\n' "$1" "$2" "$3"
  [ "$1" = ok ] || failed=1
}

# 1. The claim.
shown=$(nth 3) || fail "no contribution $claim in the Ground"
full=$(jq -r '.id' <<<"$shown")
# A typed pr claim is read from its typed fields; an untyped one from its statement, as before.
typed=$(pr_typed "$shown")
case "$typed" in
  untyped)
    statement=$(jq -r '.body.statement // empty' <<<"$shown")
    [[ $statement =~ ^PR\ \#([0-9]+)\ ([^ ]+)\ @\ ([0-9a-f]{40}): ]] || fail "$claim isn't a pr claim ('PR #<n> <branch> @ <sha>: ...')"
    claimed_pr=${BASH_REMATCH[1]} branch=${BASH_REMATCH[2]} sha=${BASH_REMATCH[3]}
    ;;
  pr\ *)
    read -r _ claimed_pr branch sha <<<"$typed"
    [[ $claimed_pr =~ ^[0-9]+$ && $sha =~ ^[0-9a-f]{40}$ && -n $branch ]] || fail "$claim's typed pr fields aren't a PR number, branch and sha"
    ;;
  *) fail "$claim isn't a pr claim: ${typed#bad }" ;;
esac
[ "$claimed_pr" = "$pr" ] || fail "$claim is for PR #$claimed_pr, not #$pr"
current=$(nth 4) || fail "couldn't read the current pr claims"
# log --current keeps a claim someone else superseded, marked; that one isn't current either if the
# manager or the owner superseded it (a takeover, finding 29a53011dacb). Anyone else's is ignored, and
# reported (finding 20a7646f3579).
if jq -e --arg id "$full" "$live"' any(.[]; .id == $id and live)' <<<"$current" >/dev/null; then
  check ok claim "$claim is the current pr claim for #$pr: $branch @ $sha"
else
  check FAIL claim "$claim isn't the current pr claim (retracted, or superseded by its author, manager or owner)"
fi
ignored_supersedes "$current" "$full" "pr claim"

# 2. The gate.
status=$(jq -r '.assessment.status' <<<"$shown")
passes=$(jq -r '[.assessment.passes[][:12]] | join(" ")' <<<"$shown")
policy_text="${policy[*]} --min-passes $min_passes"
if [ "$status" = accepted ]; then
  check ok gate "accepted under $policy_text (passes: $passes)"
else
  check FAIL gate "$status under $policy_text, not accepted"
fi

# 3. Findings: `bracken findings` is the check, one definition shared with `bracken log --open`
# (task dea48fd16754, docs/cli.md): every contribution with a contradicts relation to the claim that
# isn't retracted and whose link still counts (live, or retracted by someone other than the finding's
# author and the triager), each triaged from the triager's live evidence. Untriaged and confirmed
# findings block; a confirmed one deferred to a current task of the triager's doesn't.
found=$(nth 5) ||
  fail "couldn't read the findings against $full, so the findings check can't decide"
# The read's shape first, in one jq: a jq error inside the for lists below would go unnoticed, since
# errexit doesn't cover a command substitution there (finding d9682243cef7). Slurped (-s), so it judges
# the whole output as exactly one document, not just the last of several; and every id and task is 64
# lowercase hex, so none can split away in a for list (finding 6fd12dd898ee): \A and \z, since $ also
# matches before a final newline (b0cec6d917b6).
jq -es 'length == 1 and (.[0] | (.findings | type) == "array" and (.blocking | type) == "number"
  and all(.findings[]; (.id | type) == "string" and (.id | test("\\A[0-9a-f]{64}\\z"))
    and (.triage | IN("untriaged", "confirmed", "deferred", "rejected"))
    and (.triage != "deferred" or ((.task | type) == "string" and (.task | test("\\A[0-9a-f]{64}\\z")))))
  and .blocking == ([.findings[] | select(.triage == "untriaged" or .triage == "confirmed")] | length))' \
  <<<"$found" >/dev/null ||
  fail "bracken findings --json for $full isn't in the shape this check reads, so the findings check can't decide"
findings_count=$(jq '.findings | length' <<<"$found")
untriaged=() undeferred=() deferred=()
for f in $(jq -r '.findings[] | select(.triage == "untriaged") | .id[:12]' <<<"$found"); do untriaged+=("$f"); done
for f in $(jq -r '.findings[] | select(.triage == "confirmed") | .id[:12]' <<<"$found"); do undeferred+=("$f"); done
for f in $(jq -r '.findings[] | select(.triage == "deferred") | "\(.id[:12])->\(.task[:12])"' <<<"$found"); do
  deferred+=("$f")
done
# And what the for lists read agrees with the count, in case anything slipped past the shape check.
[ "$(jq '.blocking' <<<"$found")" -eq $((${#untriaged[@]} + ${#undeferred[@]})) ] ||
  fail "bracken findings' blocking count disagrees with its findings, so the findings check can't decide"
if [ ${#untriaged[@]} -eq 0 ] && [ ${#undeferred[@]} -eq 0 ]; then
  findings_text="$findings_count against the claim, all triaged by $triager; confirmed and deferred: ${deferred[*]:-none}"
  check ok findings "$findings_text"
else
  check FAIL findings "untriaged (no $triager evidence): ${untriaged[*]:-none}; confirmed but not deferred (no current task tagged deferred that $triager wrote and related depends_on it): ${undeferred[*]:-none}"
fi

# 4. The GitHub PR.
info=$(api GET "/pulls/$pr") || fail "couldn't read PR #$pr from $host"
f_head=$(jq -r '.head.sha' <<<"$info")
f_state=$(jq -r 'if .merged then "merged" else .state end' <<<"$info")
f_base=$(jq -r '.base.ref' <<<"$info")
title=$(jq -r '.title' <<<"$info")
# Where the head branch lives, for deleting it after the merge: only a branch of origin's repository.
f_head_repo=$(jq -r '.head.repo.full_name // empty' <<<"$info")
f_head_ref=$(jq -r '.head.ref // empty' <<<"$info")
if [ "$f_state" = open ] && [ "$f_base" = main ] && [ "$f_head" = "$sha" ]; then
  check ok github "PR #$pr is open against main, head $f_head"
else
  check FAIL github "PR #$pr is $f_state against $f_base, head $f_head (the claim says $sha)"
fi

# 5. main.
git -C "$main" fetch -q origin main "refs/pull/$pr/head" || fail "couldn't fetch main and PR #$pr from origin"
tip=$(git -C "$main" rev-parse --verify -q "origin/main^{commit}") || fail "no origin/main"

# Experiments AGENTS.md cites (decision ff456e4e2fcc, task 8c9ad9bd4518 step 3): in AGENTS.md as the merge
# leaves it (git merge-tree of main and the head, as check 6b reads; finding 7a98b2f925a6), every word of 8
# to 64 hex digits, in any case, that is a prefix of an experiment's id (any claim ever tagged experiment,
# retracted and superseded ones included), and every one on a 'Running:' line, must resolve to one current,
# unexpired experiment, or one an expired one a manager decision keeps. One that is lapsed, malformed,
# retracted, superseded (named with what supersedes it), missing, an ambiguous prefix or not an experiment
# fails (findings c010f3be17c0, 68470890d973, affa2403b450, 0d4748825f9c). A rule that lapsed must leave the
# rules, or a decision keep it; a lapsed experiment cited nowhere stays the note above.
cite_check() {
  local merged agents_md words running w cands asks=() toks=() shows n=0 r id why problems=() current=()
  [ -z "$exp_fail" ] || { check FAIL experiments "$exp_fail, so what AGENTS.md cites can't be judged"; return; }
  git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null ||
    { check FAIL experiments "$sha isn't on origin, so the AGENTS.md the merge leaves can't be read"; return; }
  merged=$(git -C "$main" merge-tree --write-tree --no-messages "$tip" "$sha" 2>/dev/null | head -n 1) &&
    [ -n "$merged" ] ||
    { check FAIL experiments "$sha doesn't merge cleanly onto main ($tip), so the AGENTS.md it leaves can't be read"; return; }
  agents_md=''
  if git -C "$main" cat-file -e "$merged:AGENTS.md" 2>/dev/null; then
    agents_md=$(git -C "$main" show "$merged:AGENTS.md") ||
      { check FAIL experiments "couldn't read AGENTS.md in the merged tree $merged"; return; }
  fi
  words=$(grep -oiwE '[0-9a-f]{8,64}' <<<"$agents_md" | tr 'A-F' 'a-f' | sort -u) || true
  running=$(grep -iE '^[-*[:space:]]*running:' <<<"$agents_md" | grep -oiwE '[0-9a-f]{8,64}' | tr 'A-F' 'a-f' | sort -u) || true
  for w in $words; do
    cands=$(jq -r --arg w "$w" '[.[] | select(.kind == "claim" and ((.body.tags // []) | index("experiment"))
      and (.id | startswith($w)))] | length' <<<"$exp_all") ||
      { check FAIL experiments "couldn't match AGENTS.md's ids to the experiments"; return; }
    if [ "$cands" -gt 0 ] || grep -qxF -- "$w" <<<"$running"; then
      toks+=("$w")
      asks+=("$(req show "$w" --json)")
    fi
  done
  [ ${#toks[@]} -gt 0 ] || return 0
  shows=$(bk_reads "${asks[@]}") || { check FAIL experiments "couldn't read the experiments AGENTS.md cites"; return; }
  for w in "${toks[@]}"; do
    n=$((n + 1))
    r=$(sed -n "${n}p" <<<"$shows")
    if ! jq -e '.ok == true' <<<"$r" >/dev/null 2>&1; then
      why=$(jq -r '.error // "no answer"' <<<"$r" 2>/dev/null | head -n 1 | LC_ALL=C tr -d '\000-\037\177' | cut -c 1-160)
      problems+=("$w doesn't name one contribution, missing or an ambiguous prefix (${why:-no answer})")
      continue
    fi
    id=$(jq -r '.result.id' <<<"$r")
    why=$(jq -r --arg id "$id" --arg states "$exp_states" --arg lapsed "${lapsed_ids[*]-}" '.result
      | ($states | split("\n") | map(select(startswith($id + " ")) | split(" ")) | first) as $s
      | if .kind != "claim" or (((.body.tags // []) | index("experiment")) | not) then "isn'"'"'t an experiment"
        elif .retracted then "is retracted"
        elif $s == null then
          ([.referrers[] | select(.kind == "relation" and .retracted == false and .body.kind == "supersedes"
             and .body.to == $id) | .body.from[:12]] | unique) as $by
          | "is superseded" + (if ($by | length) > 0 then " by \($by | join(", "))" else ", or not current" end)
        elif $s[1] == "malformed" then "is malformed (\($s[2:] | join(" ")))"
        elif $s[1] == "expired" and ($lapsed | split(" ") | index($id + ":" + $s[2])) then "lapsed (ended \($s[2]))"
        else "" end' <<<"$r") || { check FAIL experiments "couldn't read experiment $w"; return; }
    if [ -n "$why" ]; then problems+=("$w ${why}"); else current+=("${id:0:12}"); fi
  done
  if [ ${#problems[@]} -gt 0 ]; then
    check FAIL experiments "AGENTS.md, as the merge leaves it ($merged), cites experiments that aren't current and unexpired: $(printf '%s; ' "${problems[@]}" | sed 's/; $//'): take each out of AGENTS.md or cite its current successor; a lapsed one stays only with a manager decision citing the metrics that supports it"
  else
    check ok experiments "AGENTS.md, as the merge leaves it, cites only current experiments: ${current[*]}"
  fi
}
cite_check

# The manager's passes of scripts/test-table naming the sha, one '<main sha>\x1f<key>\x1f<suffix>' line
# each, split on the unit separator: a tab is whitespace to read, so an empty main and key would collapse
# and a suffix land in the wrong field, never checked (task 962bd6b61626); the main and key are empty for a pass without --on, the suffix ' docs-only', ' reuses <id>',
# ' weave <manifest> <evidence>' (line main's
# Weave results on the merge, recorded by verify-seq --weave and re-checked below by scripts/weave-gate
# check) or empty.
tables=$(jq -r --arg full "$full" --arg sha "$sha" '[.referrers[] | select(.kind == "evidence"
  and .retracted == false and .author_name == "manager" and .body.target == $full and .body.verdict == "pass")
  | . as $e | .body.method
  | ((capture("^scripts/test-table( --split)? @ (?<h>[0-9a-f]{40})( on (?<m>[0-9a-f]{40})( tree (?<k>[0-9a-f]{40,64}))?)?(?<x> docs-only| reuses [0-9a-f]{64})?$")?)
     // (capture("^scripts/test-table --weave @ (?<h>[0-9a-f]{40}) on (?<m>[0-9a-f]{40}) tree (?<k>[0-9a-f]{40,64}) manifest (?<w>blake3:[0-9a-f]{64})$")?
         | .x = " weave " + .w + " " + $e.id))
  | select(.h == $sha) | [.m // "", .k // "", .x // ""] | join("\u001f")] | unique | .[]' <<<"$shown")
# The manager's batch passes naming the sha, one '<batch>\t<main>\t<key>\t<run>' line each.
batch_passes=$(jq -r --arg full "$full" --arg sha "$sha" '[.referrers[] | select(.kind == "evidence"
  and .retracted == false and .author_name == "manager" and .body.target == $full and .body.verdict == "pass")
  | .body.method | capture("^scripts/test-table( --split)? @ (?<h>[0-9a-f]{40}) batch (?<b>[0-9a-f]{64}) on (?<m>[0-9a-f]{40}) tree (?<k>[0-9a-f]{40,64}) run (?<e>[0-9a-f]{64})$")?
  | select(.h == $sha) | [.b, .m, .k, .e] | @tsv] | unique | .[]' <<<"$shown")
# batch_pass_ok <batch> <main> <key> <run>: whether a batch pass counts (see the header). Sets member to
# this PR's place in the batch, from 1, and leaves read_batch's b_* set.
batch_pass_ok() {
  local about c j
  read_batch "$1" || return 1
  [ "$b_main" = "$2" ] && [ "$b_key" = "$3" ] || return 1
  member=''
  for ((j = 0; j < b_n; j++)); do
    [ "${b_pr[j]}" = "$pr" ] && [ "${b_claim[j]}" = "$full" ] && [ "${b_sha[j]}" = "$sha" ] && member=$((j + 1))
  done
  [ -n "$member" ] || return 1
  about=$(bk show "$4" --json 2>/dev/null) || return 1
  c=$(jq -r --arg b "$b_full" 'select(.kind == "evidence" and .retracted == false and .author_name == "manager"
    and .body.verdict == "pass" and .body.target == $b) | .body.method
    | (capture("^scripts/test-table( --split)? @ (?<c>[0-9a-f]{40})$") | .c)? // empty' <<<"$about")
  run_commit=$c
  [ -n "$c" ] && [ "$(key_of "$c")" = "$3" ]
}
key_of() { (cd "$main" && "$here/tree-scope" key "$1" 2>/dev/null); }
# untested <from> [<to>]: what changed from <from> to <to> (main's tip by default) that can change what
# builds, tests or runs. Docs and skill .md files count only where $ours, the paths the head (or the
# batch's members) changed, lists them; docs/vision.md and skill templates always count.
untested() {
  local changed
  # A diff that fails says so as a line of its own, so it counts as untested, never as nothing.
  changed=$(git -C "$main" diff --no-renames --name-only "$1" "${2:-$tip}") ||
    { echo "(git diff $1 ${2:-$tip} failed)"; return; }
  printf '%s\n' "$changed" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      .bracken/*) ;;
      docs/vision.md) echo "$f" ;;
      .claude/skills/templates/* | .claude/skills/*/templates/*) echo "$f" ;;
      docs/* | .claude/skills/*.md) ! grep -qxF -- "$f" <<<"$ours" || echo "$f" ;;
      *) echo "$f" ;;
    esac
  done
}
# batch_ours: sets ours to every path a member of the batch read_batch last read changed since its main.
batch_ours() {
  local h base paths all=''
  for h in "${b_sha[@]}"; do
    base=$(git -C "$main" merge-base "$b_main" "$h") || return 1
    paths=$(git -C "$main" diff --no-renames --name-only "$base" "$h") || return 1
    all=$(printf '%s\n%s' "$all" "$paths")
  done
  ours=$(sort -u <<<"$all")
}
# merged_commit <onto> <head>...: <onto> merged with the heads in order (tree-scope chain); empty on a conflict.
merged_commit() { (cd "$main" && "$here/tree-scope" chain "$@" 2>/dev/null | tail -n 1 | cut -d' ' -f2); }
# merged_key <onto> <head>...: the key of <onto> merged with the heads in order; empty if they don't merge.
merged_key() { (cd "$main" && "$here/tree-scope" chain "$@" 2>/dev/null | tail -n 1 | cut -d' ' -f3); }
expect_after=''
# A batch pass counts in the plain form only for exactly the tested tree: never a prefix (decision
# db6f7705c0a4).
exact=''
if [ -z "$batch_member" ] && [ -n "$batch_passes" ] && git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  here_commit=$(merged_commit "$tip" "$sha")
  here_key=$([ -z "$here_commit" ] || key_of "$here_commit")
  while IFS=$'\t' read -r b m k e; do
    if [ -n "$here_key" ] && [ "$k" = "$here_key" ] && batch_pass_ok "$b" "$m" "$k" "$e"; then
      batch_ours || continue
      # The same key, and nothing else that can matter: the tested tree and this merge's differ only in
      # .bracken/ and docs no member touched (finding 9a3eaf48e2d7).
      [ -z "$(untested "$run_commit" "$here_commit")" ] || continue
      exact="batch ${b_full:0:12} (member $member of $b_n) tested exactly this head merged with main ($tip): key $k"
      break
    fi
  done <<<"$batch_passes"
fi
# Check 5 for a member of a batch merge (batch_member): see the header.
batch_member_main() {
  local b m k e c found=false t next chain j
  local -a keys=() commits=()
  while IFS=$'\t' read -r b m k e; do
    [ "$b" = "$batch_member" ] || continue
    if batch_pass_ok "$b" "$m" "$k" "$e"; then found=true; break; fi
  done <<<"$batch_passes"
  if ! $found; then
    check FAIL main "no manager batch pass of batch ${batch_member:0:12} on this claim that counts (a current batch claim listing #$pr $full @ $sha, and its run's pass)"
    return
  fi
  if ! chain=$(cd "$main" && "$here/tree-scope" chain "$b_main" "${b_sha[@]}" 2>&1); then
    check FAIL main "batch ${b_full:0:12} no longer merges onto its own main: $chain"
    return
  fi
  while read -r j c k; do commits[j]=$c keys[j]=$k; done <<<"$chain"
  if ! batch_ours; then
    check FAIL main "couldn't list the paths batch ${b_full:0:12}'s members change (git merge-base or diff failed)"
    return
  fi
  t=$(key_of "$tip")
  if $batch_precheck; then
    bad=$(untested "${commits[0]}")
    if [ -z "$bad" ] && [ "$t" = "${keys[0]}" ] && [ "$(merged_key "$tip" "${b_sha[@]}")" = "$b_key" ]; then
      main_case="batch ${b_full:0:12}, member $member of $b_n: main ($tip) is the batch's main ${b_main:0:12} but for .bracken/ and docs no member touches, and the members merge onto it, in order, into the tested tree $b_key"
      check ok main "$main_case"
    else
      check FAIL main "main ($tip) has moved since the batch's main ${b_main:0:12} in what can change the tests (${bad:+$(tr "\n" " " <<<"$bad")}key $t, the batch's ${keys[0]}), or the members no longer merge onto it into the tested tree: verify the batch again on main's tip"
    fi
    return
  fi
  # GitHub's squash merge of this head onto main, as git merge-tree computes it, must be the next
  # prefix, before the merge call; after it, the merged main is compared again.
  bad=$(untested "${commits[member - 1]}")
  next=$(merged_commit "$tip" "$sha")
  if [ -z "$bad" ] && [ "$t" = "${keys[member - 1]}" ] && [ -n "$next" ] && [ "$(key_of "$next")" = "${keys[member]}" ] &&
    [ -z "$(untested "${commits[member]}" "$next")" ]; then
    expect_after=${commits[member]}
    main_case="batch ${b_full:0:12}, member $member of $b_n: main ($tip) is the batch's prefix $((member - 1)), and this merge gives prefix $member (key ${keys[member]})"
    [ "$member" != "$b_n" ] || main_case="$main_case, the tested tree"
    check ok main "$main_case"
  else
    check FAIL main "main ($tip, key $t) isn't the batch's prefix $((member - 1)) (key ${keys[member - 1]})${bad:+, differing in $(tr "\n" " " <<<"$bad")}, or merging $sha onto it ($( [ -n "$next" ] && echo "key $(key_of "$next")" || echo "a conflict")) isn't prefix $member (key ${keys[member]}): stop the batch"
  fi
}
# weave_main_ok <main sha>: whether a Weave pass's main may stand for main's tip, by check 5's rule: it
# is the tip, or it holds the branch point and main has moved since only in .bracken/ and docs the head
# doesn't touch (finding 76c500f0c75d).
weave_main_ok() {
  local base ours
  [ "$1" != "$tip" ] || return 0
  base=$(git -C "$main" merge-base "$tip" "$sha") || return 1
  ours=$(git -C "$main" diff --no-renames --name-only "$base" "$sha") || return 1
  git -C "$main" merge-base --is-ancestor "$base" "$1" 2>/dev/null &&
    git -C "$main" merge-base --is-ancestor "$1" "$tip" 2>/dev/null && [ -z "$(untested "$1")" ]
}
# Whether <id> is a current manager pass of the whole table, with key <key>, on a pr claim of this PR.
reuses_a_pass() {
  local about target
  about=$(bk show "$1" --json 2>/dev/null) || return 1
  jq -e --arg k "$2" '.kind == "evidence" and .retracted == false and .author_name == "manager"
    and .body.verdict == "pass" and (.body.method | test("^scripts/test-table( --split)? @ [0-9a-f]{40} on [0-9a-f]{40} tree " + $k + "$"))' \
    <<<"$about" >/dev/null || return 1
  target=$(bk show "$(jq -r .body.target <<<"$about")" --json 2>/dev/null) || return 1
  case "$(pr_typed "$target")" in
    untyped) jq -e --arg pr "PR #$pr " '(.body.statement // "") | startswith($pr)' <<<"$target" >/dev/null ;;
    "pr $pr "*) ;;
    *) return 1 ;;
  esac
}
docs_only=false
if ! git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  check FAIL scope "$sha isn't on origin"
else
  if scope=$(cd "$main" && "$here/tree-scope" docs-only "$tip" "$sha" 2>&1); then docs_only=true; fi
  scope=${scope#tree-scope: }
  wrong=()
  weave_case=''
  weave_dropped=() weave_dropped_ids=() weave_ignored=()
  while IFS=$'\x1f' read -r m k x; do
    case "$x" in
      " docs-only") $docs_only || wrong+=("a docs-only pass${m:+ on main $m} on a head that isn't docs-only ($scope)") ;;
      " reuses "*) reuses_a_pass "${x# reuses }" "$k" ||
        wrong+=("a pass reusing ${x# reuses }, which isn't a current manager pass of the whole table on PR #$pr with key ${k:-none}") ;;
      " weave "*)
        # Line main's Weave results, counted only if scripts/weave-gate's own reads agree (plan
        # cc496dcee0e3 step 1b): the switch, main, the fallbacks, git's merge, weave verify and weave
        # green; and only if main has moved since the pass's main only as check 5 allows (finding
        # 76c500f0c75d). One that doesn't count is ignored, not a failure, so git's counted run beside
        # it still counts (finding cfd70a4b5283); but nothing below may rest on it.
        read -r _ w e <<<"$x"
        if ! why=$("$here/weave-gate" check "$full" "$sha" "$m" "$k" "$w" "$e" "$tip" 2>&1); then
          why=$(tail -n 1 <<<"$why")
        elif ! weave_main_ok "$m"; then
          why="main ($tip) has moved since its main ${m:0:12} in what can change the tests"
        else
          weave_case=$(tail -n 1 <<<"$why")
          continue
        fi
        weave_dropped+=("$m"$'\x1f'"$k"$'\x1f'"$x") weave_dropped_ids+=("$e")
        weave_ignored+=("Weave pass ${e:0:12} on main ${m:0:12} ignored: $why")
        ;;
    esac
  done <<<"$tables"
  if [ ${#weave_dropped_ids[@]} -gt 0 ]; then
    # Check 5 never reads an ignored pointer's main.
    kept=''
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s\n' "${weave_dropped[@]}" | grep -qxF -- "$line" || kept+="$line"$'\n'
    done <<<"$tables"
    tables=${kept%$'\n'}
    # An ignored pointer carries nothing (finding f6bf883e41d7): a manager pass of the table must remain,
    # git's counted run or a pointer that counts, and without the ignored ones the gate's passes must
    # still come from enough distinct authors, counted as the gate counts them.
    dropped_json=$(printf '%s\n' "${weave_dropped_ids[@]}" | jq -R . | jq -s .)
    left=$(jq --argjson d "$dropped_json" '.assessment.passes as $p | [.referrers[]
      | select(.kind == "evidence" and (.id as $i | $p | index($i)) and (.id as $i | $d | index($i) | not))
      | .author] | unique | length' <<<"$shown")
    if [ -z "$tables" ] && [ -z "$batch_passes" ]; then
      wrong+=("$(printf '%s; ' "${weave_ignored[@]}")and no other manager pass of the table is on the claim")
    elif [ "$left" -lt "$min_passes" ]; then
      wrong+=("$(printf '%s; ' "${weave_ignored[@]}")without it the gate's passes come from $left of the $min_passes authors it needs")
    fi
  fi
  if [ ${#wrong[@]} -eq 0 ]; then
    check ok scope "$($docs_only && echo "the head is docs-only" || echo "the head changes code"): $scope${weave_case:+; $weave_case}$( [ ${#weave_ignored[@]} -eq 0 ] || printf '; %s' "${weave_ignored[@]}")"
  else
    check FAIL scope "$(printf '%s; ' "${wrong[@]}")run the whole table: bk-evidence --on origin/main -- scripts/test-table"
  fi
fi
if ! git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  check FAIL main "$sha isn't on origin (fetched refs/pull/$pr/head)"
elif [ -n "$batch_member" ]; then
  batch_member_main
elif [ -n "$exact" ]; then
  main_case="$exact"
  check ok main "$main_case"
elif [ -z "$tables" ] && [ -n "$batch_passes" ]; then
  check FAIL main "the manager's only table passes of $sha are batch passes, and a batch pass counts only for exactly the tested tree: this head merged with main ($tip) isn't it. Merge the batch with merge --batch, or verify this head on main's tip"
elif git -C "$main" merge-base --is-ancestor "$tip" "$sha"; then
  main_case="main ($tip) is an ancestor of $sha"
  check ok main "$main_case"
else
  base=$(git -C "$main" merge-base "$tip" "$sha")
  # --no-renames: a file moved from code into docs/ must count under both paths.
  ours=$(git -C "$main" diff --no-renames --name-only "$base" "$sha")
  bad=$(untested "$base")
  # The main shas the manager's test-table passes tested this head merged with ('scripts/test-table @
  # <sha> on <main sha>'); a docs-only one only for a docs-only head, and the scope check vets a reused
  # one. Any other command's --on pass is part of the table at most.
  verified=$(while IFS=$'\x1f' read -r m _ x; do
    [ -n "$m" ] || continue
    [ "$x" != " docs-only" ] || $docs_only || continue
    echo "$m"
  done <<<"$tables" | sort -u)
  on=""
  # m must hold the branch point, or the tested merge added nothing and m..tip can hide a change
  # main made and reverted after m (finding e82a2f2c7ff5); then m..tip is exactly what the test lacked.
  for m in $verified; do
    if git -C "$main" merge-base --is-ancestor "$base" "$m" 2>/dev/null &&
      git -C "$main" merge-base --is-ancestor "$m" "$tip" 2>/dev/null && [ -z "$(untested "$m")" ]; then
      on=$m
      break
    fi
  done
  if [ -z "$bad" ]; then
    main_case="main ($tip) is ahead of $sha only in .bracken/, and docs/ or skill .md files the branch doesn't touch"
    check ok main "$main_case"
  elif [ -n "$on" ]; then
    main_case="main ($tip) is ahead of $sha in code, and the manager's test-table pass tested $sha merged with main $on"
    [ "$on" = "$tip" ] || main_case="$main_case, which main has moved past only in .bracken/ and docs"
    check ok main "$main_case"
  elif [ -n "$verified" ]; then
    check FAIL main "main ($tip) has moved in code since the main the manager's passes tested $sha on ($(tr "\n" " " <<<"$verified" | sed 's/ $//')); verify again with bk-evidence --on origin/main -- scripts/test-table: $(printf "%s" "$bad" | tr "\n" " ")"
  else
    check FAIL main "main ($tip) is ahead of $sha with changes the verified head didn't test; verify the merge with bk-evidence --on origin/main -- scripts/test-table, or merge main into the branch and verify again: $(printf "%s" "$bad" | tr "\n" " ")"
  fi
fi

# 6. The Ground guards, on what the head committed.
if ! git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  check FAIL guards "$sha isn't on origin"
# Cleared: a value exported in the caller's shell would let a root .gitattributes change through (note 0e50e7fc03af).
elif guards=$(cd "$main" && GROUND_GUARDS_ATTRIBUTES_CHECKED='' "$here/ground-guards" "$tip" "$sha" 2>&1); then
  guards_case=$(tail -1 <<<"$guards")
  check ok guards "$guards_case"
else
  # The failure is the last ground-guards: line; earlier ones are guards that passed.
  check FAIL guards "$( (grep '^ground-guards:' <<<"$guards" || tail -1 <<<"$guards") | tail -1)"
fi

# 6a. The format freeze (docs/design/weave-freeze.md 2.4, G6; decision bae92c497714), through main's
# scripts/tree-scope: see the header.
frozen_case="nothing frozen"
if ! git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  check FAIL frozen "$sha isn't on origin"
else
  rc=0
  frozen_err=$(mktemp)
  frozen=$(cd "$main" && "$here/tree-scope" frozen "$tip" "$sha" 2>"$frozen_err") || rc=$?
  frozen_why=$(tr '\n' ' ' <"$frozen_err" | sed 's/ $//')
  rm -f "$frozen_err"
  # Fail closed (findings db2dc1c6120e, e3f9ae2b1820): only exit 3 with exactly its one line means nothing
  # to check, and exit 0 counts only if every line is '<kind>: <path> (<why>)' of a kind this check knows.
  # Anything else, a failure or output it can't read, decides nothing.
  unread=''
  if [ "$rc" = 0 ]; then
    [ -n "$frozen" ] || unread="no line at all"
    while IFS= read -r l; do
      [ -n "$unread" ] && break
      [[ $l =~ ^tree-scope:\ (frozen|owner|security):\ [^[:cntrl:]]+\ \([^[:cntrl:]]+\)$ ]] ||
        unread="a line it can't read: $(printf '%q' "$l")"
    done <<<"$frozen"
  elif [ "$rc" = 3 ]; then
    [[ $frozen =~ ^tree-scope:\ nothing\ since\ [0-9a-f]{40,64}\ is\ frozen\ or\ holds\ the\ freeze\'s\ refusals$ ]] ||
      unread="an answer for nothing to check that isn't its one line: $(printf '%q' "$frozen")"
  fi
  if [ "$rc" = 3 ] && [ -z "$unread" ]; then
    check ok frozen "$frozen_case: ${frozen#tree-scope: }"
  elif [ "$rc" != 0 ] && [ "$rc" != 3 ]; then
    check FAIL frozen "tree-scope frozen failed (exit $rc), so the freeze check can't decide: ${frozen_why:-no message}"
  elif [ -n "$unread" ]; then
    check FAIL frozen "tree-scope frozen exited $rc with $unread, so the freeze check can't decide"
  else
    missing=() have=()
    # paths_of <kind>: the paths tree-scope named with 'tree-scope: <kind>: <path> (<why>)', space-separated.
    paths_of() { sed -n "s/^tree-scope: $1: \\(.*\\) (.*)\$/\\1/p" <<<"$frozen" | sort -u | tr '\n' ' ' | sed 's/ $//'; }
    frozen_paths=$(paths_of frozen) owner_paths=$(paths_of owner) security_paths=$(paths_of security)
    # A full id or sha, named as a word of its own: not part of a longer hex string.
    named() { printf '(^|[^0-9a-f])%s([^0-9a-f]|$)' "$1"; }
    if [ -n "$frozen_paths" ]; then
      reviews=$(nth 6) || fail "couldn't read the current owner-review claims"
      review=$(jq -r --arg id "$(named "$full")" --arg sha "$(named "$sha")" "$live"' [.[] | select(.kind == "claim"
        and .author_name == "manager" and live
        and (.body.tags | index("owner-review"))
        and ((.body.statement // "") | split("\n")[0] | test($id) and test($sha)))] | .[0].id // empty' <<<"$reviews")
      if [ -n "$review" ]; then
        have+=("owner-review ${review:0:12}")
        ignored_supersedes "$reviews" "$review" "owner-review"
      else
        missing+=("$frozen_paths: no current owner-review claim by manager whose first line names pr claim $full and $sha")
      fi
    fi
    if [ -n "$owner_paths" ]; then
      approvals=$(nth 7) || fail "couldn't read the current approvals"
      # The owner's own go (question 3): one the owner ran, never one tagged delegated,
      # naming this pr claim and supporting it by the owner's own relation. The claim names the sha.
      approval=''
      for a in $(jq -r --arg t "$full" '.referrers[] | select(.kind == "relation" and .retracted == false
        and .author_name == "owner" and .body.kind == "supports" and .body.to == $t) | .body.from' <<<"$shown"); do
        if jq -e --arg a "$a" --arg of "of $full:" "$live"' any(.[]; .id == $a and .author_name == "owner"
          and live and (.body.tags | index("approval"))
          and ((.body.tags | index("delegated")) | not) and ((.body.statement // "") | contains($of)))' \
          <<<"$approvals" >/dev/null; then
          approval=$a
          ignored_supersedes "$approvals" "$a" "the owner's approval"
          break
        fi
      done
      if [ -n "$approval" ]; then
        have+=("the owner's approval ${approval:0:12}")
      else
        missing+=("$owner_paths: no current approval the owner ran (scripts/owner-approve $full) that names and supports pr claim $full at $sha")
      fi
    fi
    if [ -n "$security_paths" ]; then
      if jq -e --arg full "$full" --arg m "^independent review \\(.+\\) @ $sha\$" 'any(.referrers[]; .kind == "evidence"
        and .retracted == false and .author_name == "reviewer" and .body.target == $full
        and .body.verdict == "pass" and (.body.method | test($m)))' <<<"$shown" >/dev/null; then
        have+=("an independent review's pass at $sha")
      else
        missing+=("$security_paths: no independent review's pass (reviewer evidence 'independent review (<model>) @ $sha') on pr claim $full")
      fi
    fi
    if [ ${#missing[@]} -eq 0 ]; then
      frozen_case="frozen or refusal paths changed, and the freeze's review is there: $(printf '%s; ' "${have[@]}" | sed 's/; $//')"
      check ok frozen "$frozen_case"
    else
      check FAIL frozen "the head changes what Weave's format freeze guards: $(printf '%s; ' "${missing[@]}" | sed 's/; $//')"
    fi
  fi
fi

# 6b. The research Docker tests (see the header): run by hand on the Mac, recorded by the manager.
docker_case="no research Docker code changed"
if ! git -C "$main" cat-file -e "$sha^{commit}" 2>/dev/null; then
  check FAIL docker "$sha isn't on origin"
elif ! docker_base=$(git -C "$main" merge-base "$tip" "$sha") ||
  ! docker_merged=$(git -C "$main" merge-tree --write-tree --no-messages "$tip" "$sha" 2>/dev/null | head -n 1) ||
  [ -z "$docker_merged" ] ||
  ! docker_list=$(mktemp) ||
  ! { git -C "$main" diff --no-renames --name-only -z "$docker_base" "$sha" &&
    git -C "$main" diff --no-renames --name-only -z "$tip" "$docker_merged"; } >"$docker_list"; then
  # Fails closed: a head that doesn't merge cleanly, or a diff that fails, can't be judged.
  check FAIL docker "couldn't list what $sha changes since its merge base with main ($tip), or what merging it changes"
else
  # As tree-scope's changed_paths reads them (finding b791a20398d9): NUL-separated, so a name holding a
  # quote, a backslash or a newline is read as it is; what the head changed since the merge base, and every
  # path that differs between main's tip and the merged tree, since the merge carries a head's edit onto a
  # path main renamed. Renames count as a deletion and an addition.
  docker_found=()
  while IFS= read -r -d '' f; do
    case "$(printf '%s' "$f" | LC_ALL=C tr 'A-Z' 'a-z')" in
      # The whole research workspace (findings d20fc8dd320c, 0d91699b857e): the Docker tests exercise most of
      # the experiment, the demo it depends on, and the workspace's own Cargo.toml and Cargo.lock.
      # crates/experiment/ and crates/demo/ are where they lived before task bfc942cd7ced moved them.
      research/* | crates/experiment/* | crates/demo/*) docker_found+=("$f") ;;
    esac
  done < <(LC_ALL=C sort -uz "$docker_list")
  rm -f "$docker_list"
  docker_paths=''
  [ ${#docker_found[@]} -eq 0 ] || docker_paths=$(printf '%q ' "${docker_found[@]}" | sed 's/ $//')
  if [ -z "$docker_paths" ]; then
    check ok docker "$docker_case"
  elif docker_pass=$(jq -r --arg t "$full" --arg sha "$sha" '[.referrers[] | select(.kind == "evidence"
    and .retracted == false and .author_name == "manager" and .body.target == $t and .body.verdict == "pass"
    and (.body.method | startswith("research docker tests") and endswith(" @ " + $sha)))] | .[0].id // empty' \
    <<<"$shown") && [ -n "$docker_pass" ]; then
    docker_case="research Docker code changed ($docker_paths), and the manager's run of its Docker tests at $sha passed (${docker_pass:0:12})"
    check ok docker "$docker_case"
  else
    check FAIL docker "the head changes research's Docker-tested code ($docker_paths), which no CI runner tests with Docker: run them on the Mac with Docker running (cd research && cargo nextest run -E 'test(~docker::) | binary(grade_run) | binary(weave)') and record a manager pass on pr claim $full, method 'research docker tests @ $sha' (docs/development.md)"
  fi
fi

# 7. The owner's own approval, when the class needs it.
owner_case="not required for this class"
if $owner_approval; then
  approvals=$(nth 7) || fail "couldn't read the current approvals"
  approved=""
  for a in $(jq -r --arg t "$full" '.referrers[] | select(.kind == "relation" and .retracted == false
    and .author_name == "owner" and .body.kind == "supports" and .body.to == $t) | .body.from' <<<"$shown"); do
    if jq -e --arg a "$a" "$live"' any(.[]; .id == $a and .author_name == "owner" and live
      and ((.body.tags | index("delegated")) | not))' <<<"$approvals" >/dev/null; then
      approved="${a:0:12} supports the pr claim"
      ignored_supersedes "$approvals" "$a" "the owner's approval"
      break
    fi
  done
  if [ -n "$approved" ]; then
    owner_case="owner-signed approval $approved"
    check ok owner "$owner_case"
  else
    check FAIL owner "no current approval the owner ran supports pr claim $claim itself (one of a task or an earlier head doesn't count); the owner signs one with scripts/owner-approve $claim \"<what>\" (a manager-signed quote or a delegated approval doesn't count)"
  fi
fi

[ "$failed" = 0 ] || fail "not merging PR #$pr: a check failed"

body=$(mktemp)
details=$(mktemp)
trap 'rm -f "$body" "$details"' EXIT
jq -n --arg sha "$sha" --arg title "$title (#$pr)" '{merge_method: "squash", sha: $sha, commit_title: $title}' >"$body"
if $dry_run; then
  echo "dry run: all checks pass; would record 'merge gate @ $sha' on $claim, then PUT /pulls/$pr/merge with:"
  cat "$body"
  exit 0
fi

printf 'claim: %s is the current pr claim for #%s (%s @ %s)\ngate: accepted under %s (passes: %s)\nfindings: %s\ngithub head: %s (PR #%s open against main)\nmain: %s\nguards: %s\nfrozen: %s\ndocker: %s\nowner: %s\n' \
  "$full" "$pr" "$branch" "$sha" "$policy_text" "$passes" "$findings_text" "$f_head" "$pr" "$main_case" "$guards_case" "$frozen_case" "$docker_case" "$owner_case" >"$details"
written=$(bk evidence "$claim" pass --method "merge gate @ $sha" --details-file "$details" --as "$agent") ||
  fail "couldn't record the merge-gate evidence; not merging"
# The first line's last word: 'evidence <id>' (task d4e958fd6719), or a bare id from an older pinned binary.
id=${written%%$'\n'*}
id=${id##* }
echo "recorded merge gate evidence $id"
# A live merge-gate pass is what says a PR merged (bracken log --open closes findings against it), so a
# merge GitHub refused takes it back (finding d494f36dee9d). But the call also fails when GitHub
# merges anyway: a proxy's 502 or 504, or a dropped connection, while it's still merging. So GitHub is
# asked (findings f1fc25380904, 3623855aa0e8). Merged at this head keeps the pass. Open, at any head,
# retracts it: at once after a 4xx (a 409 if the head moved), and otherwise only if it's still open after
# asking again for a few seconds. Anything else stops, naming the evidence.
pr_now() { # merged, merged-elsewhere, open or unknown
  local now
  now=$(api GET "/pulls/$pr" 2>/dev/null) || { echo unknown; return; }
  jq -r --arg sha "$sha" 'if .merged == true then (if .head.sha == $sha then "merged" else "merged-elsewhere" end)
    elif .state == "open" then "open" else "unknown" end' <<<"$now" 2>/dev/null || echo unknown
}
if ! status=$(api PUT "/pulls/$pr/merge" "$body" status); then
  outcome=$(pr_now)
  case "$status" in 4??) asks=0 ;; *) asks=3 ;; esac
  while [ "$outcome" = open ] && [ "$asks" -gt 0 ]; do
    sleep 2
    asks=$((asks - 1))
    outcome=$(pr_now)
  done
  case "$outcome" in
    open)
      bk retract "$id" --reason "GitHub didn't merge PR #$pr at $sha (HTTP $status)" --as "$agent" >/dev/null ||
        fail "the merge failed (HTTP $status; a 409 if the head moved) and PR #$pr is open, and retracting the merge gate evidence $id failed or wasn't confirmed: check with scripts/bk show $id, and if it isn't retracted, run scripts/bk retract $id --as $agent, or log --open counts PR #$pr as merged"
      fail "the merge failed (HTTP $status; a 409 if the head moved) and PR #$pr is open; the merge gate evidence $id is retracted, so it still counts as open" ;;
    merged) echo "the merge call failed (HTTP $status), but GitHub shows PR #$pr merged at $sha; the evidence $id stands" ;;
    *) fail "the merge's outcome is unclear: the call failed (HTTP $status), and GitHub shows PR #$pr neither merged at $sha nor open (${outcome}). The merge gate evidence $id stands; if the PR didn't merge at $sha, run scripts/bk retract $id --as $agent" ;;
  esac
fi
echo "merged PR #$pr at $sha"
# GitHub's merge call has no delete_branch_after_merge, so the head branch goes here: only a branch of
# origin's repository (never a fork's, never main), only while it is still at the sha, and best effort.
if [ "$f_head_repo" = "$repo" ] && [ "$f_head_ref" != main ] && [[ $f_head_ref =~ ^[A-Za-z0-9._/-]+$ ]] &&
  [ "$(api GET "/git/ref/heads/$f_head_ref" 2>/dev/null | jq -r '.object.sha // empty' 2>/dev/null)" = "$sha" ]; then
  if deleted=$(api DELETE "/git/refs/heads/$f_head_ref" '' status); then
    echo "deleted branch $f_head_ref"
  else
    echo "merge: couldn't delete branch $f_head_ref (HTTP $deleted); the merge stands"
  fi
fi
if [ -n "$expect_after" ]; then
  git -C "$main" fetch -q origin main || fail "merged PR #$pr, but couldn't fetch main to compare it with the batch: stop the batch"
  now=$(key_of origin/main)
  bad=$(untested "$expect_after" "$(git -C "$main" rev-parse origin/main)")
  [ "$now" = "$(key_of "$expect_after")" ] && [ -z "$bad" ] ||
    fail "merged PR #$pr, but main (key ${now:-unknown}) isn't the batch's prefix $member (commit $expect_after, key $(key_of "$expect_after"))${bad:+, differing in $(tr "\n" " " <<<"$bad")}: stop the batch"
  echo "main is the batch's prefix $member (key $now)"
fi
# Free what finished work left behind (process 11f1ac552f26). The merge stands whatever cleanup does.
if $no_cleanup; then
  :
elif [ -x "$here/cleanup" ]; then
  "$here/cleanup" --apply </dev/null 2>&1 | sed 's/^/  /' || echo "merge: cleanup failed (the merge stands); run scripts/cleanup to see why"
fi
echo "update the main checkout only through scripts/ground-checkpoint and the sha it names, not git pull (process 9.3)"
}

# The whole batch: check every member, then merge them in order (see the header).
if [ "${1:-}" = --batch ]; then
  [ $# -ge 2 ] && [[ $2 =~ ^[0-9a-f]{12,64}$ ]] || usage
  batch=$2
  shift 2
  rest=() dry=false agent=${BRACKEN_AGENT:-}
  for a in "$@"; do
    case "$a" in --dry-run) dry=true ;; *) rest+=("$a") ;; esac
  done
  for ((k = 0; k < ${#rest[@]}; k++)); do [ "${rest[k]}" != --as ] || agent=${rest[k + 1]:-}; done
  command -v jq >/dev/null || fail "needs jq"
  bk() { BK_PULL=required BRACKEN_FULL_CHECK=1 BRACKEN_AGENT=${agent:-manager} "$here/bk" "$@"; }
  read_batch "$batch" || fail "$batch_why"
  # Which members the Ground says merged: a live manager 'merge gate @ <sha>' pass on the claim.
  gated() {
    local j out=()
    for ((j = 0; j < b_n; j++)); do
      bk show "${b_claim[j]}" --json 2>/dev/null | jq -e --arg sha "${b_sha[j]}" 'any(.referrers[]; .kind == "evidence"
        and .retracted == false and .author_name == "manager" and .body.method == "merge gate @ " + $sha)' >/dev/null &&
        out+=("#${b_pr[j]}")
    done
    echo "${out[*]:-none}"
  }
  echo "batch ${b_full:0:12}: $b_n members on main ${b_main:0:12}, tree $b_key"
  for ((k = 0; k < b_n; k++)); do
    echo "== check member $((k + 1)): PR #${b_pr[k]} (${b_claim[k]:0:12})"
    set +e
    (batch_member=$b_full batch_precheck=true; merge_one "${b_pr[k]}" "${b_claim[k]}" "${rest[@]}" --dry-run) 2>&1 | sed 's/^/  /'
    code=${PIPESTATUS[0]}
    set -e
    [ "$code" = 0 ] || fail "member $((k + 1)) (PR #${b_pr[k]}) fails a check: merging none of the batch"
  done
  if $dry; then
    echo "dry run: every member passes; would merge, in order: $(printf '#%s ' "${b_pr[@]}")"
    exit 0
  fi
  for ((k = 0; k < b_n; k++)); do
    echo "== merge member $((k + 1)): PR #${b_pr[k]} (${b_claim[k]:0:12})"
    set +e
    (batch_member=$b_full no_cleanup=true; merge_one "${b_pr[k]}" "${b_claim[k]}" "${rest[@]}") 2>&1 | sed 's/^/  /'
    code=${PIPESTATUS[0]}
    set -e
    if [ "$code" != 0 ]; then
      fail "stopped at member $((k + 1)) (PR #${b_pr[k]}); merged, by the live merge-gate passes: $(gated). main is on a prefix of the batch that nothing tested: verify the rest again on main's new tip"
    fi
  done
  echo "merged the batch, in order: $(gated); main is on the tested tree $b_key"
  if [ -x "$here/cleanup" ]; then
    "$here/cleanup" --apply </dev/null 2>&1 | sed 's/^/  /' || echo "merge: cleanup failed (the merges stand); run scripts/cleanup to see why"
  fi
  exit 0
fi
merge_one "$@"
