#!/usr/bin/env bash
# weave: run the team's pinned bracken against the Weave Ground, ~/bracken-weave/manyroot, from any
# worktree (docs/design/weave.md, Where the Weave Ground lives, and Keeping the two scripts apart).
#
#   scripts/weave [--as <identity>] <bracken command> ...   e.g. scripts/weave weave import --as alice
#
# It runs the same pinned binary as scripts/bk, <main>/.bracken-bin (or BRACKEN_BIN). Before running
# anything it resolves the Weave Ground's real path, exports that as BRACKEN_DIR (ignoring an inherited
# one), so the path it checked is the path bracken opens, and refuses if that path is inside a git
# checkout, is the main checkout's .bracken/, or holds a Ground with the same id as the main checkout's.
# So a symlinked ~/bracken-weave can't lead it to the coordination Ground.
#
# It refuses:
#   - --dir in any form: it always uses the Weave Ground;
#   - evidence: check results come only from the check runner (weave.md section 3);
#   - sync and serve: the Weave Ground never syncs in v0, and this never reads .bracken-team;
#   - --as weave-runner, for anything but weave validate;
#   - weave integrate and weave line merge, which move a line, for anyone but --as weave-integrator: builders
#     propose (scripts/weave-propose), and only the integrator merges (stage 2a, task 87a1bcba025d);
#   - weave validate for an identity that isn't one of the line's validators, read from the pinned binary's
#     own plan (weave validate --dry-run --json) before anything runs, and weave validate with a '--';
#   - a line write (weave line create or weave line policy) whose --owner-decision isn't a claim tagged
#     decision, or tagged approval and signed by owner (scripts/owner-approve, as scripts/weave-shadow
#     --init requires), not retracted, in the coordination Ground (read with the main checkout's scripts/bk): a
#     policy is code this machine runs, so each version cites the owner's decision (weave.md section 1,
#     finding 3cd6cd19f9a0);
#   - artifact with a Weave media type, in any case, and relate with supersedes anywhere in its arguments,
#     after '--' too: Weave records are written only by bracken weave, which checks them, and a hand-made
#     line version or supersedes relation would go round that check (answer 12000ab70ae5, finding
#     56dadb600ba2);
#   - --runner, and a '--', on weave validate and a line write: it gives them --runner <the main checkout>
#     itself, the directory a box or mac check's pinned runner script is in (plan cc496dcee0e3).
#
# The committed pin (docs/design/weave-marker.md, option A; decision d01c83b654d1): for anything but weave
# init, the Ground's id in ground.json and its replica's root, the weave-root file beside it, must be the
# ones .config/weave-root holds on the main checkout's refs/heads/main (scripts/weave-pin). A mismatch, or
# no pin on either side, refuses everything, with one exception, when the Ground's id matches and only the
# replica's root is missing or differs: exactly 'weave root set <the pinned root>', with '--replace <the
# replica's root>' when one is set. It runs that, reads the replica's weave-root back, and fails unless it
# now holds the pinned root. So the one way to set or move a replica's root through the scripts is to the
# committed value; weave root set is refused once the replica matches. Changing which root is right is a
# change to .config/weave-root, which scripts/code-scope frozen lists.
# Creating the Weave Ground (weave init) waits for the owner's go.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
  echo "weave: $here is not inside a git repository" >&2
  exit 1
}
main=$(dirname "$common")
fail() { echo "weave: $*" >&2; exit 1; }

bin="${BRACKEN_BIN:-$main/.bracken-bin/bin/bracken}"
[ -x "$bin" ] || fail "no pinned bracken at $bin; the manager installs it (agent-team-kickoff skill, SKILL.md section 2.1)"

# The command and its subcommands, found past global options; --as before any '--', else BRACKEN_AGENT.
words=() who=${BRACKEN_AGENT:-} owner_decision=
media=()
for ((i = 1; i <= $#; i++)); do
  case "${!i}" in
    --) break ;;
    --as) j=$((i + 1)); who=${!j:-}; i=$j ;;
    --as=*) who=${!i#--as=} ;;
    --dir | --dir=*) fail "--dir is refused: scripts/weave always uses the Weave Ground, ~/bracken-weave/manyroot" ;;
    --owner-decision) j=$((i + 1)); owner_decision=${!j:-}; i=$j ;;
    --owner-decision=*) owner_decision=${!i#--owner-decision=} ;;
    --media-type) j=$((i + 1)); media+=("${!j:-}"); i=$j ;;
    --media-type=*) media+=("${!i#--media-type=}") ;;
    # -h and --help get no early exit: they reach bracken only after every refusal and check below, as an
    # option that takes the rest of the line can make them another program's argument (3e1a0454a03b).
    -*) ;;
    *) [ ${#words[@]} -ge 3 ] || words+=("${!i}") ;;
  esac
done
cmd=${words[0]:-} sub=${words[1]:-} subsub=${words[2]:-}
[ "$cmd" = weave ] || sub='' subsub=''
case "$cmd" in
  evidence) fail "evidence is refused: a check result on a Weave record comes only from the check runner (weave validate)" ;;
  sync | serve) fail "$cmd is refused: the Weave Ground never syncs in v0" ;;
esac
if [ "$cmd" = artifact ]; then
  for m in ${media[@]+"${media[@]}"}; do
    [[ $(printf '%s' "$m" | tr '[:upper:]' '[:lower:]') != application/vnd.bracken.weave* ]] ||
      fail "artifact with a Weave media type is refused: bracken weave writes Weave records, and checks them"
  done
fi
# Every argument, past '--' too, where bracken still reads the kind: an option's value or a '--' can't hide it.
if [ "$cmd" = relate ]; then
  for arg in "$@"; do
    [ "$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')" != supersedes ] ||
      fail "relate ... supersedes is refused: weave line policy writes a line's new version and its supersedes relations"
  done
fi
# weave validate and a line write get --runner from this script alone (below).
gets_runner=false
if [ "$sub" = validate ] || { [ "$sub" = line ] && [[ $subsub == create || $subsub == policy ]]; }; then
  gets_runner=true
  for arg in "$@"; do
    case "$arg" in
      --) fail "weave $sub takes no '--' here" ;;
      --runner | --runner=*) fail "--runner is refused: scripts/weave gives the main checkout, $main" ;;
    esac
  done
fi
[ "$who" != weave-runner ] || [ "$sub" = validate ] || fail "--as weave-runner is only for weave validate"
if [ "$sub" = integrate ] || { [ "$sub" = line ] && [ "$subsub" = merge ]; }; then
  [ "$who" = weave-integrator ] ||
    fail "weave integrate and weave line merge move a line, so they're only --as weave-integrator: builders propose (scripts/weave-propose)"
fi
if [ "$sub" = line ] && [[ $subsub == create || $subsub == policy ]]; then
  [ -n "$owner_decision" ] ||
    fail "weave line $subsub needs --owner-decision <id>: the id of the owner's decision, in the coordination Ground, that allows this policy"
  [[ $owner_decision =~ ^[0-9a-f]{12,64}$ ]] ||
    fail "--owner-decision $owner_decision: give the decision claim's id, 12 to 64 lowercase hex digits"
  shown=$(env -u BRACKEN_AGENT "$main/scripts/bk" show "$owner_decision" --json 2>/dev/null) ||
    fail "--owner-decision $owner_decision: the coordination Ground has no such contribution"
  jq -e '.kind == "claim" and (.retracted | not) and (((.body.tags // []) | index("decision") != null)
         or (.author_name == "owner" and ((.body.tags // []) | index("approval") != null)))' \
    <<<"$shown" >/dev/null 2>&1 ||
    fail "--owner-decision $owner_decision: it isn't a claim tagged decision, or an approval signed by owner, not retracted, in the coordination Ground"
fi

# The Weave Ground's real path. weave init creates it, so for init its parent must exist instead.
home=${HOME:?HOME is not set}
path="$home/bracken-weave/manyroot"
if [ "$sub" = init ]; then
  [ ! -e "$path" ] && [ ! -L "$path" ] || fail "$path already exists"
  parent=$(cd -P "$home/bracken-weave" 2>/dev/null && pwd -P) ||
    fail "$home/bracken-weave doesn't exist; creating the Weave Ground waits for the owner's go"
  ground="$parent/manyroot"
  checked=$parent
else
  ground=$(cd -P "$path" 2>/dev/null && pwd -P) ||
    fail "no Weave Ground at $path; creating it waits for the owner's go"
  checked=$ground
fi
d=$checked
while :; do
  [ ! -e "$d/.git" ] || fail "the Weave Ground $ground is inside the git checkout $d; it lives outside every repository"
  [ "$d" != / ] || break
  d=$(dirname "$d")
done
coordination=$(cd -P "$main/.bracken" 2>/dev/null && pwd -P) || coordination=''
[ "$ground" != "$coordination" ] || fail "the Weave Ground $ground is the coordination Ground"
ground_id() { sed -n 's/^[[:space:]]*"ground":[[:space:]]*"\([0-9a-f]*\)".*/\1/p' "$1"; }
if [ -f "$ground/ground.json" ] && [ -f "$main/.bracken/ground.json" ]; then
  ours=$(ground_id "$ground/ground.json") theirs=$(ground_id "$main/.bracken/ground.json")
  [ -n "$ours" ] && [ -n "$theirs" ] || fail "can't read the Ground ids in $ground/ground.json and $main/.bracken/ground.json"
  [ "$ours" != "$theirs" ] ||
    fail "the Ground at $ground has the coordination Ground's id ($ours); it isn't the Weave Ground"
fi

# The committed pin. weave init makes a new Ground, so it has none yet.
root_set=false
if [ "$sub" != init ]; then
  pin=$("$here/weave-pin") || fail "refused: no committed pin to check the Weave Ground against"
  pin_ground=${pin% *} pin_root=${pin#* }
  [ -f "$ground/ground.json" ] && ours=$(ground_id "$ground/ground.json") && [ -n "$ours" ] ||
    fail "can't read the Ground id in $ground/ground.json"
  [ "$ours" = "$pin_ground" ] ||
    fail "refused: the Ground at $ground is $ours, not the committed pin's $pin_ground (.config/weave-root on main)"
  replica=''
  [ ! -f "$ground/weave-root" ] || replica=$(tr -d '[:space:]' <"$ground/weave-root")
  if [ "$replica" = "$pin_root" ]; then
    [ "$sub" != root ] ||
      fail "weave root is refused: this replica's root is already the committed pin's, $pin_root; changing it is a change to .config/weave-root"
  else
    exact=(weave root set "$pin_root")
    [ -z "$replica" ] || exact+=(--replace "$replica")
    given=("$@") same=false
    if [ ${#given[@]} -eq ${#exact[@]} ]; then
      same=true
      for i in "${!exact[@]}"; do [ "${given[$i]}" = "${exact[$i]}" ] || same=false; done
    fi
    $same ||
      fail "refused: this replica's root is ${replica:-not set}, not the committed pin's $pin_root (.config/weave-root on main); the only command run until it is: scripts/weave ${exact[*]}"
    root_set=true
  fi
fi

export BRACKEN_DIR="$ground"
if $root_set; then
  "$bin" "$@" || exit
  now=''
  [ ! -f "$ground/weave-root" ] || now=$(tr -d '[:space:]' <"$ground/weave-root")
  [ "$now" = "$pin_root" ] || fail "weave root set ran, but the replica's root is ${now:-not set}, not $pin_root"
  exit 0
fi
# A box or mac check's runner script is the main checkout's, the copy line main's policy pins (plan
# cc496dcee0e3; weave.md section 3, Checks outside the sandbox): weave validate and a line write get
# --runner "$main" from here, never one of the caller's.
runner=()
! $gets_runner || runner=(--runner "$main")
if [ "$sub" = validate ]; then
  # The binary refuses a signer that isn't a validator too; this reads the line's validators first, so
  # that nothing runs for anyone else even under a binary that didn't (weave.md section 3).
  plan=()
  for arg in "$@"; do
    case "$arg" in
      --) fail "weave validate takes no '--'" ;;
      --json | --dry-run) ;;
      *) plan+=("$arg") ;;
    esac
  done
  shown=$("$bin" "${plan[@]}" "${runner[@]}" --dry-run --json) || fail "weave validate refused, so no check ran"
  jq -e '.signer as $s | (.validators | index($s)) != null' <<<"$shown" >/dev/null 2>&1 ||
    fail "the signer isn't one of the line's validators, so weave validate runs nothing for it"
fi
exec "$bin" "$@" ${runner[@]+"${runner[@]}"}
